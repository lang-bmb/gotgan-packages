// bmb-runningavg: Running/moving average over a sliding window
// Computes scaled averages (multiplied by 1000) to preserve 3 decimal places
// using only integer arithmetic.
//
// Functions:
//   running_avg_scaled  - Compute all window averages for a data series
//   cumulative_avg_scaled - Cumulative average up to each position
//   ewma_scaled         - Exponential weighted moving average (integer approx)

// ============================================================
// Helpers
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

@inline
fn ra_abs(x: i64) -> i64 = if x < 0 { 0 - x } else { x };

// ============================================================
// Core Functions
// ============================================================

// Compute the running (simple moving) average over a sliding window.
// data: vec of i64 values, n: length of data, w: window size
// Returns a new vec of length (n - w + 1) containing scaled averages
// (each value is mean * 1000).
// Caller must vec_free the result.
fn running_avg_scaled(data: i64, n: i64, w: i64) -> i64
  pre n > 0 and w > 0 and w <= n
= {
    let result = vec_new();

    // Compute initial window sum
    let mut window_sum = 0;
    let mut i = 0;
    while i < w {
        window_sum = window_sum + vec_get(data, i);
        i = i + 1;
        0
    };

    // First average
    let first_avg = (window_sum * 1000) / w;
    let _p = vec_push(result, first_avg);

    // Slide the window
    let mut j = 1;
    let count = n - w + 1;
    while j < count {
        // Remove the element leaving the window, add the new one
        window_sum = window_sum - vec_get(data, j - 1) + vec_get(data, j + w - 1);
        let avg = (window_sum * 1000) / w;
        let _p2 = vec_push(result, avg);
        j = j + 1;
        0
    };

    result
};

// Compute cumulative average up to each position.
// Returns a vec of length n where result[i] = (sum(data[0..=i]) * 1000) / (i + 1).
// Caller must vec_free the result.
fn cumulative_avg_scaled(data: i64, n: i64) -> i64
  pre n > 0
= {
    let result = vec_new();
    let mut total = 0;
    let mut i = 0;
    while i < n {
        total = total + vec_get(data, i);
        let avg = (total * 1000) / (i + 1);
        let _p = vec_push(result, avg);
        i = i + 1;
        0
    };
    result
};

// Exponential weighted moving average (integer approximation).
// alpha is given as alpha_num / alpha_den (e.g., alpha_num=2, alpha_den=10 for alpha=0.2).
// EWMA_0 = data[0] * 1000
// EWMA_i = (alpha_num * data[i] * 1000 + (alpha_den - alpha_num) * EWMA_{i-1}) / alpha_den
// Returns a vec of length n with scaled EWMA values.
// Caller must vec_free the result.
fn ewma_scaled(data: i64, n: i64, alpha_num: i64, alpha_den: i64) -> i64
  pre n > 0 and alpha_num > 0 and alpha_den > 0 and alpha_num <= alpha_den
= {
    let result = vec_new();
    let mut prev = vec_get(data, 0) * 1000;
    let _p = vec_push(result, prev);

    let mut i = 1;
    while i < n {
        let val = vec_get(data, i) * 1000;
        prev = (alpha_num * val + (alpha_den - alpha_num) * prev) / alpha_den;
        let _p2 = vec_push(result, prev);
        i = i + 1;
        0
    };
    result
};

// Compute the running sum over a sliding window.
// Returns a vec of length (n - w + 1).
// Caller must vec_free the result.
fn running_sum(data: i64, n: i64, w: i64) -> i64
  pre n > 0 and w > 0 and w <= n
= {
    let result = vec_new();

    let mut window_sum = 0;
    let mut i = 0;
    while i < w {
        window_sum = window_sum + vec_get(data, i);
        i = i + 1;
        0
    };
    let _p = vec_push(result, window_sum);

    let mut j = 1;
    let count = n - w + 1;
    while j < count {
        window_sum = window_sum - vec_get(data, j - 1) + vec_get(data, j + w - 1);
        let _p2 = vec_push(result, window_sum);
        j = j + 1;
        0
    };
    result
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_running_avg_basic() -> i64 = {
    // data = [10, 20, 30, 40, 50], window = 3
    // windows: [10,20,30]=60/3=20.0, [20,30,40]=90/3=30.0, [30,40,50]=120/3=40.0
    // scaled: [20000, 30000, 40000]
    let data = vec_new();
    let _p0 = vec_push(data, 10);
    let _p1 = vec_push(data, 20);
    let _p2 = vec_push(data, 30);
    let _p3 = vec_push(data, 40);
    let _p4 = vec_push(data, 50);
    let result = running_avg_scaled(data, 5, 3);
    let ok = if vec_len(result) != 3 { 0 }
        else if vec_get(result, 0) != 20000 { 0 }
        else if vec_get(result, 1) != 30000 { 0 }
        else if vec_get(result, 2) != 40000 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_running_avg_window1() -> i64 = {
    // window = 1: each element is its own average
    let data = vec_new();
    let _p0 = vec_push(data, 5);
    let _p1 = vec_push(data, 15);
    let _p2 = vec_push(data, 25);
    let result = running_avg_scaled(data, 3, 1);
    let ok = if vec_len(result) != 3 { 0 }
        else if vec_get(result, 0) != 5000 { 0 }
        else if vec_get(result, 1) != 15000 { 0 }
        else if vec_get(result, 2) != 25000 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_running_avg_full_window() -> i64 = {
    // window = n: single average of all elements
    let data = vec_new();
    let _p0 = vec_push(data, 2);
    let _p1 = vec_push(data, 4);
    let _p2 = vec_push(data, 6);
    let _p3 = vec_push(data, 8);
    // sum = 20, mean = 5.0, scaled = 5000
    let result = running_avg_scaled(data, 4, 4);
    let ok = if vec_len(result) != 1 { 0 }
        else if vec_get(result, 0) != 5000 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_cumulative_avg() -> i64 = {
    // data = [10, 20, 30]
    // cum[0] = 10*1000/1 = 10000
    // cum[1] = 30*1000/2 = 15000
    // cum[2] = 60*1000/3 = 20000
    let data = vec_new();
    let _p0 = vec_push(data, 10);
    let _p1 = vec_push(data, 20);
    let _p2 = vec_push(data, 30);
    let result = cumulative_avg_scaled(data, 3);
    let ok = if vec_len(result) != 3 { 0 }
        else if vec_get(result, 0) != 10000 { 0 }
        else if vec_get(result, 1) != 15000 { 0 }
        else if vec_get(result, 2) != 20000 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_ewma() -> i64 = {
    // data = [10, 20, 30], alpha = 1/2 (alpha_num=1, alpha_den=2)
    // EWMA_0 = 10000
    // EWMA_1 = (1*20000 + 1*10000)/2 = 15000
    // EWMA_2 = (1*30000 + 1*15000)/2 = 22500
    let data = vec_new();
    let _p0 = vec_push(data, 10);
    let _p1 = vec_push(data, 20);
    let _p2 = vec_push(data, 30);
    let result = ewma_scaled(data, 3, 1, 2);
    let ok = if vec_len(result) != 3 { 0 }
        else if vec_get(result, 0) != 10000 { 0 }
        else if vec_get(result, 1) != 15000 { 0 }
        else if vec_get(result, 2) != 22500 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_running_sum() -> i64 = {
    // data = [1, 2, 3, 4, 5], window = 2
    // sums: [3, 5, 7, 9]
    let data = vec_new();
    let _p0 = vec_push(data, 1);
    let _p1 = vec_push(data, 2);
    let _p2 = vec_push(data, 3);
    let _p3 = vec_push(data, 4);
    let _p4 = vec_push(data, 5);
    let result = running_sum(data, 5, 2);
    let ok = if vec_len(result) != 4 { 0 }
        else if vec_get(result, 0) != 3 { 0 }
        else if vec_get(result, 1) != 5 { 0 }
        else if vec_get(result, 2) != 7 { 0 }
        else if vec_get(result, 3) != 9 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn test_running_avg_fractional() -> i64 = {
    // data = [1, 2, 4], window = 3
    // sum = 7, avg = 7/3 = 2.333..., scaled = 7*1000/3 = 2333
    let data = vec_new();
    let _p0 = vec_push(data, 1);
    let _p1 = vec_push(data, 2);
    let _p2 = vec_push(data, 4);
    let result = running_avg_scaled(data, 3, 3);
    let ok = if vec_len(result) != 1 { 0 }
        else if vec_get(result, 0) != 2333 { 0 }
        else { 1 };
    let _fr = vec_free(result);
    let _fd = vec_free(data);
    ok
};

fn main() -> i64 = {
    let t1 = report("running_avg_basic", test_running_avg_basic());
    let t2 = report("running_avg_window1", test_running_avg_window1());
    let t3 = report("running_avg_full_window", test_running_avg_full_window());
    let t4 = report("cumulative_avg", test_cumulative_avg());
    let t5 = report("ewma", test_ewma());
    let t6 = report("running_sum", test_running_sum());
    let t7 = report("running_avg_fractional", test_running_avg_fractional());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7;
    let total = 7;
    let _p1 = print_str("bmb-runningavg: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
