// bmb-kadane: Kadane's algorithm for maximum subarray problems
// - Maximum subarray sum (classic Kadane)
// - Maximum circular subarray sum
// - Maximum subarray with start/end indices

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// ============================================================
// Classic Kadane: Maximum Subarray Sum
// ============================================================

// Find the maximum sum of any contiguous subarray.
// Returns the maximum sum. Array must be non-empty.
fn max_subarray_sum(arr: i64, n: i64) -> i64
  pre n > 0
= {
    let mut best = vec_get(arr, 0);
    let mut current = vec_get(arr, 0);
    let mut i = 1;
    while i < n {
        let val = vec_get(arr, i);
        // current = max(val, current + val)
        let extended = current + val;
        if val > extended { current = val; 0 }
        else { current = extended; 0 };
        // best = max(best, current)
        if current > best { best = current; 0 } else { 0 };
        i = i + 1;
        0
    };
    best
};

// ============================================================
// Kadane with indices: returns sum, start, end packed into a vec
// ============================================================

// Returns a vec of [sum, start_index, end_index]
fn max_subarray_indices(arr: i64, n: i64) -> i64
  pre n > 0
= {
    let mut best = vec_get(arr, 0);
    let mut current = vec_get(arr, 0);
    let mut best_start = 0;
    let mut best_end = 0;
    let mut cur_start = 0;
    let mut i = 1;
    while i < n {
        let val = vec_get(arr, i);
        let extended = current + val;
        if val > extended {
            current = val;
            cur_start = i;
            0
        } else {
            current = extended;
            0
        };
        if current > best {
            best = current;
            best_start = cur_start;
            best_end = i;
            0
        } else { 0 };
        i = i + 1;
        0
    };
    let result = vec_new();
    let _p1 = vec_push(result, best);
    let _p2 = vec_push(result, best_start);
    let _p3 = vec_push(result, best_end);
    result
};

// ============================================================
// Minimum Subarray Sum (helper for circular variant)
// ============================================================

fn min_subarray_sum(arr: i64, n: i64) -> i64
  pre n > 0
= {
    let mut best = vec_get(arr, 0);
    let mut current = vec_get(arr, 0);
    let mut i = 1;
    while i < n {
        let val = vec_get(arr, i);
        let extended = current + val;
        if val < extended { current = val; 0 }
        else { current = extended; 0 };
        if current < best { best = current; 0 } else { 0 };
        i = i + 1;
        0
    };
    best
};

// ============================================================
// Maximum Circular Subarray Sum
// ============================================================

// The maximum subarray can either be:
// 1. A normal contiguous subarray (classic Kadane)
// 2. A wrap-around subarray = total_sum - min_subarray
// We take the maximum of both cases.
// Special case: if all elements are negative, use case 1 only.
fn max_circular_subarray(arr: i64, n: i64) -> i64
  pre n > 0
= {
    let max_normal = max_subarray_sum(arr, n);
    // Compute total sum
    let mut total = 0;
    let mut i = 0;
    while i < n {
        total = total + vec_get(arr, i);
        i = i + 1;
        0
    };
    let min_sub = min_subarray_sum(arr, n);
    // If all elements are negative, total == min_sub, wrap-around gives 0
    // which is wrong. Use normal Kadane in that case.
    if total == min_sub { max_normal }
    else {
        let wrap_around = total - min_sub;
        if wrap_around > max_normal { wrap_around } else { max_normal }
    }
};

// ============================================================
// Maximum Sum of Non-Overlapping Subarrays of Length K
// ============================================================

// Fixed-length sliding window maximum sum.
// Returns the maximum sum of any contiguous subarray of exactly length k.
fn max_subarray_k(arr: i64, n: i64, k: i64) -> i64
  pre n >= k and k > 0
= {
    // Compute sum of first window
    let mut window_sum = 0;
    let mut i = 0;
    while i < k {
        window_sum = window_sum + vec_get(arr, i);
        i = i + 1;
        0
    };
    let mut best = window_sum;
    // Slide window
    let mut j = k;
    while j < n {
        window_sum = window_sum + vec_get(arr, j) - vec_get(arr, j - k);
        if window_sum > best { best = window_sum; 0 } else { 0 };
        j = j + 1;
        0
    };
    best
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn make_vec(vals: i64, n: i64) -> i64 = {
    let v = vec_new();
    let mut i = 0;
    while i < n {
        let _p = vec_push(v, vec_get(vals, i));
        i = i + 1;
        0
    };
    v
};

fn test_kadane_basic() -> i64 = {
    // arr = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    // max subarray = [4, -1, 2, 1] = 6
    let arr = vec_new();
    let _p1 = vec_push(arr, 0 - 2);
    let _p2 = vec_push(arr, 1);
    let _p3 = vec_push(arr, 0 - 3);
    let _p4 = vec_push(arr, 4);
    let _p5 = vec_push(arr, 0 - 1);
    let _p6 = vec_push(arr, 2);
    let _p7 = vec_push(arr, 1);
    let _p8 = vec_push(arr, 0 - 5);
    let _p9 = vec_push(arr, 4);
    let result = max_subarray_sum(arr, 9);
    let _f = vec_free(arr);
    b2i(result == 6)
};

fn test_kadane_all_negative() -> i64 = {
    // arr = [-3, -5, -1, -8]
    // max subarray = [-1] = -1
    let arr = vec_new();
    let _p1 = vec_push(arr, 0 - 3);
    let _p2 = vec_push(arr, 0 - 5);
    let _p3 = vec_push(arr, 0 - 1);
    let _p4 = vec_push(arr, 0 - 8);
    let result = max_subarray_sum(arr, 4);
    let _f = vec_free(arr);
    b2i(result == (0 - 1))
};

fn test_kadane_single() -> i64 = {
    let arr = vec_new();
    let _p = vec_push(arr, 42);
    let result = max_subarray_sum(arr, 1);
    let _f = vec_free(arr);
    b2i(result == 42)
};

fn test_kadane_all_positive() -> i64 = {
    // arr = [1, 2, 3, 4, 5]
    // max subarray = entire array = 15
    let arr = vec_new();
    let _p1 = vec_push(arr, 1);
    let _p2 = vec_push(arr, 2);
    let _p3 = vec_push(arr, 3);
    let _p4 = vec_push(arr, 4);
    let _p5 = vec_push(arr, 5);
    let result = max_subarray_sum(arr, 5);
    let _f = vec_free(arr);
    b2i(result == 15)
};

fn test_kadane_indices() -> i64 = {
    // arr = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    // max subarray = [4, -1, 2, 1] at indices 3..6
    let arr = vec_new();
    let _p1 = vec_push(arr, 0 - 2);
    let _p2 = vec_push(arr, 1);
    let _p3 = vec_push(arr, 0 - 3);
    let _p4 = vec_push(arr, 4);
    let _p5 = vec_push(arr, 0 - 1);
    let _p6 = vec_push(arr, 2);
    let _p7 = vec_push(arr, 1);
    let _p8 = vec_push(arr, 0 - 5);
    let _p9 = vec_push(arr, 4);
    let res = max_subarray_indices(arr, 9);
    let sum_val = vec_get(res, 0);
    let start = vec_get(res, 1);
    let end = vec_get(res, 2);
    let _f1 = vec_free(arr);
    let _f2 = vec_free(res);
    if sum_val != 6 { 0 }
    else if start != 3 { 0 }
    else if end != 6 { 0 }
    else { 1 }
};

fn test_circular_basic() -> i64 = {
    // arr = [5, -3, 5]
    // Normal max = 5, wrap-around = 5 + 5 = 10 (skip the -3)
    let arr = vec_new();
    let _p1 = vec_push(arr, 5);
    let _p2 = vec_push(arr, 0 - 3);
    let _p3 = vec_push(arr, 5);
    let result = max_circular_subarray(arr, 3);
    let _f = vec_free(arr);
    b2i(result == 10)
};

fn test_circular_no_wrap() -> i64 = {
    // arr = [1, -2, 3, -2]
    // Normal max = 3, wrap = total(0) - min(-2) = 2
    // max(3, 2) = 3
    let arr = vec_new();
    let _p1 = vec_push(arr, 1);
    let _p2 = vec_push(arr, 0 - 2);
    let _p3 = vec_push(arr, 3);
    let _p4 = vec_push(arr, 0 - 2);
    let result = max_circular_subarray(arr, 4);
    let _f = vec_free(arr);
    b2i(result == 3)
};

fn test_circular_all_negative() -> i64 = {
    // arr = [-3, -2, -1]
    // All negative: wrap gives 0 (invalid), so answer = -1
    let arr = vec_new();
    let _p1 = vec_push(arr, 0 - 3);
    let _p2 = vec_push(arr, 0 - 2);
    let _p3 = vec_push(arr, 0 - 1);
    let result = max_circular_subarray(arr, 3);
    let _f = vec_free(arr);
    b2i(result == (0 - 1))
};

fn test_max_k() -> i64 = {
    // arr = [1, 4, 2, 10, 2, 3, 1, 0, 20]
    // k = 3: windows [1,4,2]=7, [4,2,10]=16, [2,10,2]=14, [10,2,3]=15,
    //        [2,3,1]=6, [3,1,0]=4, [1,0,20]=21
    // max = 21
    let arr = vec_new();
    let _p1 = vec_push(arr, 1);
    let _p2 = vec_push(arr, 4);
    let _p3 = vec_push(arr, 2);
    let _p4 = vec_push(arr, 10);
    let _p5 = vec_push(arr, 2);
    let _p6 = vec_push(arr, 3);
    let _p7 = vec_push(arr, 1);
    let _p8 = vec_push(arr, 0);
    let _p9 = vec_push(arr, 20);
    let result = max_subarray_k(arr, 9, 3);
    let _f = vec_free(arr);
    b2i(result == 21)
};

fn main() -> i64 = {
    let t1 = report("kadane_basic", test_kadane_basic());
    let t2 = report("kadane_all_negative", test_kadane_all_negative());
    let t3 = report("kadane_single", test_kadane_single());
    let t4 = report("kadane_all_positive", test_kadane_all_positive());
    let t5 = report("kadane_indices", test_kadane_indices());
    let t6 = report("circular_basic", test_circular_basic());
    let t7 = report("circular_no_wrap", test_circular_no_wrap());
    let t8 = report("circular_all_negative", test_circular_all_negative());
    let t9 = report("max_k", test_max_k());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9;
    let total = 9;
    let _p1 = print_str("bmb-kadane: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
