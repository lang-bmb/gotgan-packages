// bmb-range: Range utilities
// Provides construction, arithmetic, and containment queries over integer ranges.

// ============================================================
// Core API
// ============================================================

// range_new: create a vec of values [start, start+1, ..., end_val-1].
// Returns an empty vec when end_val <= start.
// Caller must free the returned vec.
fn range_new(start: i64, end_val: i64) -> i64
  post ret != 0
= {
    let out = vec_new();
    let mut i = start;
    while i < end_val {
        let _p = vec_push(out, i);
        i = i + 1;
        0
    };
    out
};

// range_inclusive: create a vec of values [start, start+1, ..., end_val].
// Returns an empty vec when end_val < start.
// Caller must free the returned vec.
fn range_inclusive(start: i64, end_val: i64) -> i64
  post ret != 0
= {
    let out = vec_new();
    let mut i = start;
    while i <= end_val {
        let _p = vec_push(out, i);
        i = i + 1;
        0
    };
    out
};

// range_sum: sum of integers in [start, end_val) using the Gauss formula.
// sum = count * (first + last) / 2  where count = end_val - start,
//   first = start, last = end_val - 1.
// Returns 0 when the range is empty.
fn range_sum(start: i64, end_val: i64) -> i64 = {
    let count = end_val - start;
    if count <= 0 { 0 }
    else {
        let first = start;
        let last = end_val - 1;
        count * (first + last) / 2
    }
};

// range_contains: true if start <= x < end_val.
fn range_contains(start: i64, end_val: i64, x: i64) -> bool
= x >= start and x < end_val;

// range_len: number of elements in [start, end_val).
fn range_len(start: i64, end_val: i64) -> i64
  post ret >= 0
= {
    let n = end_val - start;
    if n < 0 { 0 } else { n }
};

// range_step: create a vec of values [start, start+step, start+2*step, ...]
// while value < end_val.  step must be positive.
// Caller must free the returned vec.
fn range_step(start: i64, end_val: i64, step: i64) -> i64
  pre step > 0
  post ret != 0
= {
    let out = vec_new();
    let mut i = start;
    while i < end_val {
        let _p = vec_push(out, i);
        i = i + step;
        0
    };
    out
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_range_new() -> i64 = {
    let v = range_new(3, 7);
    // Expected: [3, 4, 5, 6]
    let ok = vec_len(v) == 4
             and vec_get(v, 0) == 3
             and vec_get(v, 1) == 4
             and vec_get(v, 2) == 5
             and vec_get(v, 3) == 6;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_range_new_empty() -> i64 = {
    let v = range_new(5, 5);
    let ok = vec_len(v) == 0;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_range_inclusive() -> i64 = {
    let v = range_inclusive(1, 4);
    // Expected: [1, 2, 3, 4]
    let ok = vec_len(v) == 4
             and vec_get(v, 0) == 1
             and vec_get(v, 3) == 4;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_range_inclusive_single() -> i64 = {
    let v = range_inclusive(7, 7);
    let ok = vec_len(v) == 1 and vec_get(v, 0) == 7;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_range_sum() -> i64 = {
    // sum [0,10) = 0+1+...+9 = 45
    let s1 = range_sum(0, 10);
    // sum [1,5) = 1+2+3+4 = 10
    let s2 = range_sum(1, 5);
    // empty range
    let s3 = range_sum(5, 3);
    if s1 == 45 and s2 == 10 and s3 == 0 { 1 } else { 0 }
};

fn test_range_contains() -> i64 = {
    let c1 = range_contains(0, 10, 5);
    let c2 = range_contains(0, 10, 10);
    let c3 = range_contains(0, 10, 0);
    let c4 = range_contains(3, 7, 2);
    if b2i(c1) == 1 and b2i(c2) == 0 and b2i(c3) == 1 and b2i(c4) == 0 { 1 } else { 0 }
};

fn test_range_len() -> i64 = {
    let l1 = range_len(2, 8);
    let l2 = range_len(5, 5);
    let l3 = range_len(9, 3);
    if l1 == 6 and l2 == 0 and l3 == 0 { 1 } else { 0 }
};

fn test_range_step() -> i64 = {
    let v = range_step(0, 10, 2);
    // Expected: [0, 2, 4, 6, 8]
    let ok = vec_len(v) == 5
             and vec_get(v, 0) == 0
             and vec_get(v, 1) == 2
             and vec_get(v, 4) == 8;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_range_step_large() -> i64 = {
    let v = range_step(1, 100, 10);
    // Expected: [1, 11, 21, 31, 41, 51, 61, 71, 81, 91]  => 10 elements
    let ok = vec_len(v) == 10
             and vec_get(v, 0) == 1
             and vec_get(v, 9) == 91;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("range_new", test_range_new());
    let t2 = report("range_new_empty", test_range_new_empty());
    let t3 = report("range_inclusive", test_range_inclusive());
    let t4 = report("range_inclusive_single", test_range_inclusive_single());
    let t5 = report("range_sum", test_range_sum());
    let t6 = report("range_contains", test_range_contains());
    let t7 = report("range_len", test_range_len());
    let t8 = report("range_step", test_range_step());
    let t9 = report("range_step_large", test_range_step_large());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9;
    let total = 9;
    let _p1 = print_str("bmb-range: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
