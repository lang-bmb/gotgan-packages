// bmb-bitcount: Bit counting utilities for BMB
// Provides popcount, leading zeros (clz), trailing zeros (ctz), and parity.
// All functions operate on i64 values treated as 64-bit unsigned quantities.

// ============================================================
// Helper
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// ============================================================
// Core Functions
// ============================================================

// Population count: number of set bits in n
// Uses Kernighan's bit-clearing trick: n & (n-1) clears the lowest set bit.
// Operates on the raw 64-bit pattern.
fn popcount(n: i64) -> i64
  post ret >= 0 and ret <= 64
= {
    let mut count = 0;
    let mut v = n;
    let mut i = 0;
    while i < 64 {
        count = count + (v band 1);
        v = v >> 1;
        i = i + 1;
        0
    };
    count
};

// Count trailing zeros: number of zero bits below the lowest set bit
// Returns 64 if n == 0.
fn ctz(n: i64) -> i64
  post ret >= 0 and ret <= 64
= if n == 0 { 64 } else {
    {
        let mut count = 0;
        let mut v = n;
        let mut done = false;
        while not done {
            if (v band 1) == 1 { done = true; 0 }
            else { v = v >> 1; count = count + 1; 0 }
        };
        count
    }
};

// Count leading zeros: number of zero bits above the highest set bit
// Scans from bit 63 downward. Returns 64 if n == 0.
fn clz(n: i64) -> i64
  post ret >= 0 and ret <= 64
= if n == 0 { 64 } else {
    {
        let mut count = 0;
        let mut i = 63;
        let mut done = false;
        while not done {
            if ((n >> i) band 1) == 1 { done = true; 0 }
            else if i == 0 { done = true; count = 64; 0 }
            else { count = count + 1; i = i - 1; 0 }
        };
        count
    }
};

// Parity: 1 if the number of set bits is odd, 0 if even
fn parity(n: i64) -> i64
  post ret == 0 or ret == 1
= {
    let pc = popcount(n);
    pc - (pc / 2) * 2
};

// Highest set bit position (0-indexed from LSB)
// Returns -1 if n == 0.
fn highest_bit_pos(n: i64) -> i64
  post ret >= 0 - 1 and ret < 64
= if n == 0 { 0 - 1 } else { 63 - clz(n) };

// Lowest set bit position (0-indexed from LSB)
// Returns -1 if n == 0.
fn lowest_bit_pos(n: i64) -> i64
  post ret >= 0 - 1 and ret < 64
= if n == 0 { 0 - 1 } else { ctz(n) };

// Bit width: minimum number of bits needed to represent n (for n > 0)
// Returns 0 for n == 0.
fn bit_width(n: i64) -> i64
  pre n >= 0
  post ret >= 0
= if n == 0 { 0 } else { highest_bit_pos(n) + 1 };

// popcount in a range of bits [lo, hi) (0-indexed from LSB)
// Counts set bits at positions lo, lo+1, ..., hi-1
fn popcount_range(n: i64, lo: i64, hi: i64) -> i64
  pre lo >= 0 and hi >= lo and hi <= 64
  post ret >= 0
= {
    let mut count = 0;
    let mut i = lo;
    while i < hi {
        count = count + ((n >> i) band 1);
        i = i + 1;
        0
    };
    count
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_popcount() -> i64 =
    if popcount(0) != 0 { 0 }
    else if popcount(1) != 1 { 0 }
    else if popcount(7) != 3 { 0 }
    else if popcount(255) != 8 { 0 }
    else if popcount(1023) != 10 { 0 }
    else { 1 };

fn test_ctz() -> i64 =
    if ctz(0) != 64 { 0 }
    else if ctz(1) != 0 { 0 }
    else if ctz(2) != 1 { 0 }
    else if ctz(8) != 3 { 0 }
    else if ctz(16) != 4 { 0 }
    else if ctz(12) != 2 { 0 }
    else { 1 };

fn test_clz() -> i64 =
    if clz(0) != 64 { 0 }
    else if clz(1) != 63 { 0 }
    else if clz(2) != 62 { 0 }
    else if clz(255) != 56 { 0 }
    else { 1 };

fn test_parity() -> i64 =
    if parity(0) != 0 { 0 }
    else if parity(1) != 1 { 0 }
    else if parity(3) != 0 { 0 }
    else if parity(7) != 1 { 0 }
    else if parity(15) != 0 { 0 }
    else if parity(255) != 0 { 0 }
    else { 1 };

fn test_highest_bit_pos() -> i64 =
    if highest_bit_pos(0) != 0 - 1 { 0 }
    else if highest_bit_pos(1) != 0 { 0 }
    else if highest_bit_pos(2) != 1 { 0 }
    else if highest_bit_pos(128) != 7 { 0 }
    else if highest_bit_pos(255) != 7 { 0 }
    else { 1 };

fn test_lowest_bit_pos() -> i64 =
    if lowest_bit_pos(0) != 0 - 1 { 0 }
    else if lowest_bit_pos(1) != 0 { 0 }
    else if lowest_bit_pos(4) != 2 { 0 }
    else if lowest_bit_pos(12) != 2 { 0 }
    else { 1 };

fn test_bit_width() -> i64 =
    if bit_width(0) != 0 { 0 }
    else if bit_width(1) != 1 { 0 }
    else if bit_width(2) != 2 { 0 }
    else if bit_width(7) != 3 { 0 }
    else if bit_width(8) != 4 { 0 }
    else if bit_width(255) != 8 { 0 }
    else { 1 };

fn test_popcount_range() -> i64 = {
    // 0xFF = 11111111 in bits 0..7
    let v = 255;
    if popcount_range(v, 0, 8) != 8 { 0 }
    else if popcount_range(v, 0, 4) != 4 { 0 }
    else if popcount_range(v, 4, 8) != 4 { 0 }
    else if popcount_range(v, 8, 16) != 0 { 0 }
    // 0b10101010 = 170
    else if popcount_range(170, 0, 8) != 4 { 0 }
    else if popcount_range(170, 0, 4) != 2 { 0 }
    else { 1 }
};

fn main() -> i64 = {
    let t1 = report("popcount", test_popcount());
    let t2 = report("ctz", test_ctz());
    let t3 = report("clz", test_clz());
    let t4 = report("parity", test_parity());
    let t5 = report("highest_bit_pos", test_highest_bit_pos());
    let t6 = report("lowest_bit_pos", test_lowest_bit_pos());
    let t7 = report("bit_width", test_bit_width());
    let t8 = report("popcount_range", test_popcount_range());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-bitcount: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
