// bmb-rational: Rational number arithmetic
// Represents p/q as a vec [p, q] in normalized form (q > 0, gcd(|p|,q) == 1).
// q is always kept positive; sign lives in p.

// Absolute value helper
@inline
fn rat_abs(x: i64) -> i64 = if x < 0 { 0 - x } else { x };

// GCD helper (Euclidean algorithm, inputs treated as non-negative)
fn gcd_helper(a: i64, b: i64) -> i64
  pre a >= 0 and b >= 0
  post ret >= 0
= if b == 0 { a } else { gcd_helper(b, a - (a / b) * b) };

// Normalize a rational: ensure q > 0 and gcd(|p|, q) == 1
// Returns a new vec.
fn rat_normalize(p: i64, q: i64) -> i64
  pre q != 0
= {
    // Make q positive; flip sign of p if needed
    let mut np = p;
    let mut nq = q;
    if nq < 0 {
        np = 0 - np;
        nq = 0 - nq;
        0
    } else { 0 };
    let g = gcd_helper(rat_abs(np), nq);
    let v = vec_new();
    let _p1 = vec_push(v, np / g);
    let _p2 = vec_push(v, nq / g);
    v
};

// Create a rational number p/q (normalized)
fn rat_new(p: i64, q: i64) -> i64
  pre q != 0
= rat_normalize(p, q);

// Numerator
fn rat_p(r: i64) -> i64
  pre r != 0
= vec_get(r, 0);

// Denominator
fn rat_q(r: i64) -> i64
  pre r != 0
= vec_get(r, 1);

// Add: p1/q1 + p2/q2 = (p1*q2 + p2*q1) / (q1*q2), then normalize
fn rat_add(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= {
    let p1 = vec_get(a, 0);
    let q1 = vec_get(a, 1);
    let p2 = vec_get(b, 0);
    let q2 = vec_get(b, 1);
    rat_normalize(p1 * q2 + p2 * q1, q1 * q2)
};

// Subtract: p1/q1 - p2/q2 = (p1*q2 - p2*q1) / (q1*q2), then normalize
fn rat_sub(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= {
    let p1 = vec_get(a, 0);
    let q1 = vec_get(a, 1);
    let p2 = vec_get(b, 0);
    let q2 = vec_get(b, 1);
    rat_normalize(p1 * q2 - p2 * q1, q1 * q2)
};

// Multiply: (p1*p2) / (q1*q2), then normalize
fn rat_mul(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= {
    let p1 = vec_get(a, 0);
    let q1 = vec_get(a, 1);
    let p2 = vec_get(b, 0);
    let q2 = vec_get(b, 1);
    rat_normalize(p1 * p2, q1 * q2)
};

// Divide: (p1/q1) / (p2/q2) = (p1*q2) / (q1*p2), then normalize
// pre: p2 != 0
fn rat_div(a: i64, b: i64) -> i64
  pre a != 0 and b != 0 and vec_get(b, 0) != 0
= {
    let p1 = vec_get(a, 0);
    let q1 = vec_get(a, 1);
    let p2 = vec_get(b, 0);
    let q2 = vec_get(b, 1);
    rat_normalize(p1 * q2, q1 * p2)
};

// Equality: p1/q1 == p2/q2 iff p1*q2 == p2*q1
fn rat_equal(a: i64, b: i64) -> bool
  pre a != 0 and b != 0
= vec_get(a, 0) * vec_get(b, 1) == vec_get(b, 0) * vec_get(a, 1);

// Compare: returns -1, 0, or 1
// p1/q1 vs p2/q2: compare p1*q2 with p2*q1 (q's are positive)
fn rat_cmp(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
  post ret >= -1 and ret <= 1
= {
    let lhs = vec_get(a, 0) * vec_get(b, 1);
    let rhs = vec_get(b, 0) * vec_get(a, 1);
    if lhs < rhs { -1 } else if lhs > rhs { 1 } else { 0 }
};

// Free a rational vec
fn rat_free(r: i64) -> i64
  pre r != 0
= { let _f = vec_free(r); 0 };

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

// rat_new normalizes: 2/4 -> 1/2
fn test_normalize() -> i64 = {
    let r = rat_new(2, 4);
    let ok = rat_p(r) == 1 and rat_q(r) == 2;
    let _f = rat_free(r);
    if ok { 1 } else { 0 }
};

// Negative denominator: 3/-6 -> -1/2
fn test_neg_denom() -> i64 = {
    let r = rat_new(3, 0 - 6);
    let ok = rat_p(r) == -1 and rat_q(r) == 2;
    let _f = rat_free(r);
    if ok { 1 } else { 0 }
};

// rat_add: 1/2 + 1/3 = 5/6
fn test_add() -> i64 = {
    let a = rat_new(1, 2);
    let b = rat_new(1, 3);
    let c = rat_add(a, b);
    let ok = rat_p(c) == 5 and rat_q(c) == 6;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if ok { 1 } else { 0 }
};

// rat_sub: 3/4 - 1/4 = 1/2
fn test_sub() -> i64 = {
    let a = rat_new(3, 4);
    let b = rat_new(1, 4);
    let c = rat_sub(a, b);
    let ok = rat_p(c) == 1 and rat_q(c) == 2;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if ok { 1 } else { 0 }
};

// rat_mul: 2/3 * 3/4 = 6/12 = 1/2
fn test_mul() -> i64 = {
    let a = rat_new(2, 3);
    let b = rat_new(3, 4);
    let c = rat_mul(a, b);
    let ok = rat_p(c) == 1 and rat_q(c) == 2;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if ok { 1 } else { 0 }
};

// rat_div: (1/2) / (1/4) = 2
fn test_div() -> i64 = {
    let a = rat_new(1, 2);
    let b = rat_new(1, 4);
    let c = rat_div(a, b);
    let ok = rat_p(c) == 2 and rat_q(c) == 1;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if ok { 1 } else { 0 }
};

// rat_equal: 2/4 == 1/2
fn test_equal() -> i64 = {
    let a = rat_new(2, 4);
    let b = rat_new(1, 2);
    let c = rat_new(1, 3);
    let eq_ok = b2i(rat_equal(a, b)) == 1;
    let neq_ok = b2i(rat_equal(a, c)) == 0;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if eq_ok and neq_ok { 1 } else { 0 }
};

// rat_cmp: 1/3 < 1/2 < 2/3
fn test_cmp() -> i64 = {
    let a = rat_new(1, 3);
    let b = rat_new(1, 2);
    let c = rat_new(2, 3);
    let cmp_ab = rat_cmp(a, b);   // -1
    let cmp_ba = rat_cmp(b, a);   // 1
    let cmp_bb = rat_cmp(b, b);   // 0
    let cmp_bc = rat_cmp(b, c);   // -1
    let ok = cmp_ab == -1 and cmp_ba == 1 and cmp_bb == 0 and cmp_bc == -1;
    let _f1 = rat_free(a);
    let _f2 = rat_free(b);
    let _f3 = rat_free(c);
    if ok { 1 } else { 0 }
};

// gcd_helper: known values
fn test_gcd_helper() -> i64 = {
    let g1 = gcd_helper(12, 8);
    let g2 = gcd_helper(17, 0);
    let g3 = gcd_helper(0, 5);
    if g1 == 4 and g2 == 17 and g3 == 5 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("normalize", test_normalize());
    let t2 = report("neg_denom", test_neg_denom());
    let t3 = report("add", test_add());
    let t4 = report("sub", test_sub());
    let t5 = report("mul", test_mul());
    let t6 = report("div", test_div());
    let t7 = report("equal", test_equal());
    let t8 = report("cmp", test_cmp());
    let t9 = report("gcd_helper", test_gcd_helper());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9;
    let total = 9;
    let _p1 = print_str("bmb-rational: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
