// bmb-string: String Utilities Package
// Extracted from bootstrap/utils.bmb for reuse across projects
//
// Provides:
// - Character classification (is_digit, is_alpha, is_whitespace)
// - Character/integer conversion (int_to_string, digit_to_int)
// - String parsing (parse_int, skip_ws)
// - String searching (find_char, starts_with)

// ============================================================================
// Character Classification
// ============================================================================

/// Check if character is whitespace (space=32, tab=9, newline=10, CR=13)
fn is_whitespace(c: i64) -> bool = c == 32 or c == 9 or c == 10 or c == 13;

/// Check if character is a digit (0-9, ASCII 48-57)
fn is_digit(c: i64) -> bool = c >= 48 and c <= 57;

/// Check if character is a letter (a-z, A-Z)
fn is_alpha(c: i64) -> bool = (c >= 65 and c <= 90) or (c >= 97 and c <= 122);

/// Check if character is alphanumeric
fn is_alnum(c: i64) -> bool = is_alpha(c) or is_digit(c);

/// Check if character is alphanumeric or underscore
fn is_alnum_or_underscore(c: i64) -> bool = is_alnum(c) or c == 95;

/// Check if character can start an identifier (letter or _)
fn is_ident_start(c: i64) -> bool = is_alpha(c) or c == 95;

// ============================================================================
// Character Conversion
// ============================================================================

/// Convert digit character to integer (0-9)
fn digit_to_int(c: i64) -> i64 = c - 48;

/// Convert integer to character code (0-9 -> 48-57)
fn int_to_char(n: i64) -> i64 = n + 48;

/// Convert single digit (0-9) to string
fn digit_char(d: i64) -> String =
    if d == 0 { "0" }
    else if d == 1 { "1" }
    else if d == 2 { "2" }
    else if d == 3 { "3" }
    else if d == 4 { "4" }
    else if d == 5 { "5" }
    else if d == 6 { "6" }
    else if d == 7 { "7" }
    else if d == 8 { "8" }
    else { "9" };

/// Convert integer to string (handles negative numbers)
fn int_to_string(n: i64) -> String =
    if n < 0 { "-" + int_to_string(0 - n) }
    else if n < 10 { digit_char(n) }
    else { int_to_string(n / 10) + digit_char(n % 10) };

// ============================================================================
// String Parsing
// ============================================================================

/// Parse integer from string at position
fn parse_int(s: String, pos: i64) -> i64 = parse_int_acc(s, pos, 0);

fn parse_int_acc(s: String, pos: i64, acc: i64) -> i64 =
    if pos >= s.len() { acc }
    else if is_digit(s.byte_at(pos)) {
        parse_int_acc(s, pos + 1, acc * 10 + digit_to_int(s.byte_at(pos)))
    }
    else { acc };

/// Parse integer with possible negative sign
fn parse_int_signed(s: String, pos: i64) -> i64 =
    if pos >= s.len() { 0 }
    else if s.byte_at(pos) == 45 { 0 - parse_int(s, pos + 1) }
    else { parse_int(s, pos) };

/// Find where number ends
fn parse_int_end(s: String, pos: i64) -> i64 =
    if pos >= s.len() { pos }
    else if is_digit(s.byte_at(pos)) { parse_int_end(s, pos + 1) }
    else { pos };

// ============================================================================
// String Searching
// ============================================================================

/// Find character in string, returns position or len if not found
fn find_char(s: String, c: i64, pos: i64) -> i64 =
    if pos >= s.len() { pos }
    else if s.byte_at(pos) == c { pos }
    else { find_char(s, c, pos + 1) };

/// Skip whitespace, return new position
fn skip_ws(s: String, pos: i64) -> i64 =
    if pos >= s.len() { pos }
    else if is_whitespace(s.byte_at(pos)) { skip_ws(s, pos + 1) }
    else { pos };

/// Skip to end of line
fn skip_to_eol(s: String, pos: i64) -> i64 =
    if pos >= s.len() { pos }
    else if s.byte_at(pos) == 10 { pos }
    else { skip_to_eol(s, pos + 1) };

/// Find end of identifier
fn find_ident_end(s: String, pos: i64) -> i64 =
    if pos >= s.len() { pos }
    else if is_alnum_or_underscore(s.byte_at(pos)) { find_ident_end(s, pos + 1) }
    else { pos };

// ============================================================================
// String Matching
// ============================================================================

/// Check if string starts with prefix at position
fn starts_with(s: String, prefix: String, pos: i64) -> bool =
    starts_with_at(s, prefix, pos, 0);

fn starts_with_at(s: String, prefix: String, pos: i64, i: i64) -> bool =
    if i >= prefix.len() { true }
    else if pos + i >= s.len() { false }
    else if s.byte_at(pos + i) != prefix.byte_at(i) { false }
    else { starts_with_at(s, prefix, pos, i + 1) };

/// Find pattern in string
fn find_pattern(s: String, pat: String, pos: i64) -> i64 =
    if pos + pat.len() > s.len() { s.len() }
    else if starts_with(s, pat, pos) { pos }
    else { find_pattern(s, pat, pos + 1) };

// ============================================================================
// Tests
// ============================================================================

fn test_is_digit() -> i64 = {
    let t1 = if is_digit(48) { 1 } else { 0 };  // '0'
    let t2 = if is_digit(57) { 1 } else { 0 };  // '9'
    let t3 = if is_digit(65) { 0 } else { 1 };  // 'A' - not digit
    t1 + t2 + t3
};

fn test_int_to_string() -> i64 = {
    let t1 = if int_to_string(0) == "0" { 1 } else { 0 };
    let t2 = if int_to_string(42) == "42" { 1 } else { 0 };
    let t3 = if int_to_string(0 - 7) == "-7" { 1 } else { 0 };
    let t4 = if int_to_string(123) == "123" { 1 } else { 0 };
    t1 + t2 + t3 + t4
};

fn test_parse_int() -> i64 = {
    let t1 = if parse_int("42", 0) == 42 { 1 } else { 0 };
    let t2 = if parse_int("123abc", 0) == 123 { 1 } else { 0 };
    let t3 = if parse_int_signed("-7", 0) == 0 - 7 { 1 } else { 0 };
    t1 + t2 + t3
};

fn test_skip_ws() -> i64 = {
    let t1 = if skip_ws("  hello", 0) == 2 { 1 } else { 0 };
    let t2 = if skip_ws("hello", 0) == 0 { 1 } else { 0 };
    t1 + t2
};

fn test_starts_with() -> i64 = {
    let t1 = if starts_with("hello", "hel", 0) { 1 } else { 0 };
    let t2 = if starts_with("hello", "ell", 1) { 1 } else { 0 };
    let t3 = if starts_with("hello", "xyz", 0) { 0 } else { 1 };
    t1 + t2 + t3
};

fn main() -> i64 = {
    let t1 = test_is_digit();
    let t2 = test_int_to_string();
    let t3 = test_parse_int();
    let t4 = test_skip_ws();
    let t5 = test_starts_with();

    let total = t1 + t2 + t3 + t4 + t5;
    let expected = 3 + 4 + 3 + 2 + 3;

    if total == expected {
        let _p = println(999);
        0
    } else {
        let _p = println(total);
        1
    }
};
