// bmb-fs: File system path utilities for BMB
// Provides path manipulation and validation

// Path separator constants
fn path_sep_unix() -> i64 = 47;   // /
fn path_sep_win() -> i64 = 92;    // \
fn path_sep() -> i64 = 47;        // default to Unix style

// Extension separator
fn ext_sep() -> i64 = 46;  // .

// Check if path is absolute (Unix-style)
fn is_absolute(path: String) -> bool =
    path.len() > 0 and path.byte_at(0) == path_sep();

// Check if path is relative
fn is_relative(path: String) -> bool = not is_absolute(path);

// Find last separator position
fn find_last_sep(path: String) -> i64 = {
    let len = path.len();
    let mut pos = 0;
    let mut last = 0 - 1;
    while pos < len {
        let _r = if path.byte_at(pos) == path_sep() { last = pos; 0 } else { 0 };
        pos = pos + 1;
        0
    };
    last
};

// Get directory name (parent path)
fn dirname_end(path: String) -> i64 =
    let last = find_last_sep(path);
    if last < 0 { 0 } else if last == 0 { 1 } else { last };

// Get base name (file name with extension)
fn basename_start(path: String) -> i64 =
    let last = find_last_sep(path);
    if last < 0 { 0 } else { last + 1 };

// Find extension position (last dot after last separator)
fn find_ext(path: String) -> i64 = {
    let len = path.len();
    let mut pos = 0;
    let mut last_dot = 0 - 1;
    while pos < len {
        let c = path.byte_at(pos);
        let _r = if c == path_sep() {
            last_dot = 0 - 1; 0
        } else if c == ext_sep() {
            last_dot = pos; 0
        } else { 0 };
        pos = pos + 1;
        0
    };
    last_dot
};

// Get extension (including dot) start position, or path length if none
fn ext_start(path: String) -> i64 =
    let pos = find_ext(path);
    if pos < 0 { path.len() } else { pos };

// Check if path has extension
fn has_extension(path: String) -> bool = find_ext(path) >= 0;

// Get stem (file name without extension) positions
fn stem_start(path: String) -> i64 = basename_start(path);
fn stem_end(path: String) -> i64 = ext_start(path);

// Path component counting
fn count_components(path: String) -> i64
  post ret >= 0
= if path.len() == 0 { 0 }
  else {
      {
          let len = path.len();
          let mut pos = 0;
          let mut count = 0;
          let mut in_component = false;
          while pos < len {
              let c = path.byte_at(pos);
              let _r = if c == path_sep() {
                  let _r2 = if in_component { count = count + 1; 0 } else { 0 };
                  in_component = false;
                  0
              } else {
                  in_component = true; 0
              };
              pos = pos + 1;
              0
          };
          if in_component { count + 1 } else { count }
      }
  };

// Check for dangerous path components
fn has_parent_ref_at(path: String, pos: i64) -> bool =
    if pos + 1 >= path.len() { false } else { path.byte_at(pos) == 46 and path.byte_at(pos + 1) == 46 };

fn is_safe_path(path: String) -> bool = {
    let len = path.len();
    let mut pos = 0;
    let mut safe = true;
    let mut done = false;
    while not done {
        let _r = if pos >= len {
            { done = true; 0 }
        } else if has_parent_ref_at(path, pos) {
            { safe = false; done = true; 0 }
        } else {
            { pos = pos + 1; 0 }
        };
        0
    };
    safe
};

// Normalize path (conceptual - removes redundant separators)
fn count_consecutive_seps(path: String, start: i64) -> i64 = {
    let len = path.len();
    let mut pos = start;
    let mut count = 0;
    let mut done = false;
    while not done {
        let _r = if pos >= len {
            { done = true; 0 }
        } else if path.byte_at(pos) != path_sep() {
            { done = true; 0 }
        } else {
            { count = count + 1; pos = pos + 1; 0 }
        };
        0
    };
    count
};

fn needs_normalization(path: String) -> bool = {
    let len = path.len();
    let mut pos = 0;
    let mut needs = false;
    let mut done = false;
    while not done {
        let _r = if pos + 1 >= len {
            { done = true; 0 }
        } else {
            {
                let c1 = path.byte_at(pos);
                let c2 = path.byte_at(pos + 1);
                let _r2 = if c1 == path_sep() and c2 == path_sep() {
                    needs = true; done = true; 0
                } else {
                    pos = pos + 1; 0
                };
                0
            }
        };
        0
    };
    needs
};

// Path depth (number of directories from root)
fn path_depth(path: String) -> i64
  post ret >= 0
= let components = count_components(path);
  if is_absolute(path) { components - 1 } else { components };

// Check if path ends with separator
fn ends_with_sep(path: String) -> bool =
    path.len() > 0 and path.byte_at(path.len() - 1) == path_sep();

// Validate path characters (simplified - no null bytes)
fn is_valid_path_char(c: i64) -> bool = c != 0;

fn is_valid_path(path: String) -> bool = {
    let len = path.len();
    if len == 0 { false }
    else {
        {
            let mut pos = 0;
            let mut valid = true;
            let mut done = false;
            while not done {
                let _r = if pos >= len {
                    { done = true; 0 }
                } else if not is_valid_path_char(path.byte_at(pos)) {
                    { valid = false; done = true; 0 }
                } else {
                    { pos = pos + 1; 0 }
                };
                0
            };
            valid
        }
    }
};

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_absolute_relative() -> i64 =
    if b2i(is_absolute("/usr/bin")) == 1 and b2i(is_relative("src/main.rs")) == 1
       and b2i(is_absolute("foo")) == 0 and b2i(is_relative("/foo")) == 0 { 1 } else { 0 };

fn test_find_last_sep() -> i64 =
    if find_last_sep("/usr/bin/ls") == 8 and find_last_sep("file.txt") == 0 - 1
       and find_last_sep("/") == 0 { 1 } else { 0 };

fn test_dirname_basename() -> i64 =
    if dirname_end("/usr/bin/ls") == 8 and basename_start("/usr/bin/ls") == 9
       and dirname_end("file.txt") == 0 and basename_start("file.txt") == 0 { 1 } else { 0 };

fn test_extension() -> i64 =
    if b2i(has_extension("file.txt")) == 1 and b2i(has_extension("file")) == 0
       and find_ext("file.txt") == 4 and ext_start("noext") == 5 { 1 } else { 0 };

fn test_stem() -> i64 =
    if stem_start("/usr/file.txt") == 5 and stem_end("/usr/file.txt") == 9 { 1 } else { 0 };

fn test_count_components() -> i64 =
    if count_components("a/b/c") == 3 and count_components("/usr/bin") == 2
       and count_components("file") == 1 and count_components("") == 0 { 1 } else { 0 };

fn test_safe_path() -> i64 =
    if b2i(is_safe_path("/usr/bin")) == 1 and b2i(is_safe_path("../etc/passwd")) == 0
       and b2i(is_safe_path("foo/..")) == 0 { 1 } else { 0 };

fn test_path_depth() -> i64 =
    if path_depth("/usr/bin/ls") == 2 and path_depth("a/b/c") == 3 { 1 } else { 0 };

fn test_ends_with_sep() -> i64 =
    if b2i(ends_with_sep("/usr/")) == 1 and b2i(ends_with_sep("/usr")) == 0 { 1 } else { 0 };

fn test_valid_path() -> i64 =
    if b2i(is_valid_path("/usr/bin")) == 1 and b2i(is_valid_path("")) == 0 { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("absolute_relative", test_absolute_relative());
    let t2 = report("find_last_sep", test_find_last_sep());
    let t3 = report("dirname_basename", test_dirname_basename());
    let t4 = report("extension", test_extension());
    let t5 = report("stem", test_stem());
    let t6 = report("count_components", test_count_components());
    let t7 = report("safe_path", test_safe_path());
    let t8 = report("path_depth", test_path_depth());
    let t9 = report("ends_with_sep", test_ends_with_sep());
    let t10 = report("valid_path", test_valid_path());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10;
    let total = 10;
    let _p1 = print_str("bmb-fs: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
