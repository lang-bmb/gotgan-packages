// bmb-testing: Testing framework for BMB programs
// Provides assertion utilities and test runner support

// Test result codes
fn result_pass() -> i64 = 0;
fn result_fail() -> i64 = 1;
fn result_skip() -> i64 = 2;

// Assertion: check equality
fn assert_eq(actual: i64, expected: i64) -> bool =
    if actual == expected { true } else {
        let u0 = print_str("FAIL: expected ");
        let u1 = print(expected);
        let u2 = print_str(" but got ");
        let u3 = println(actual);
        false
    };

// Assertion: check not equal
fn assert_ne(actual: i64, unexpected: i64) -> bool =
    if actual != unexpected { true } else {
        let u0 = print_str("FAIL: expected different from ");
        let u1 = println(unexpected);
        false
    };

// Assertion: check true
fn assert_true(condition: bool) -> bool =
    if condition { true } else {
        let u0 = println_str("FAIL: expected true");
        false
    };

// Assertion: check false
fn assert_false(condition: bool) -> bool =
    if not condition { true } else {
        let u0 = println_str("FAIL: expected false");
        false
    };

// Assertion: check greater than
fn assert_gt(actual: i64, threshold: i64) -> bool =
    if actual > threshold { true } else {
        let u0 = print_str("FAIL: expected ");
        let u1 = print(actual);
        let u2 = print_str(" > ");
        let u3 = println(threshold);
        false
    };

// Assertion: check greater than or equal
fn assert_gte(actual: i64, threshold: i64) -> bool =
    if actual >= threshold { true } else {
        let u0 = print_str("FAIL: expected ");
        let u1 = print(actual);
        let u2 = print_str(" >= ");
        let u3 = println(threshold);
        false
    };

// Assertion: check less than
fn assert_lt(actual: i64, threshold: i64) -> bool =
    if actual < threshold { true } else {
        let u0 = print_str("FAIL: expected ");
        let u1 = print(actual);
        let u2 = print_str(" < ");
        let u3 = println(threshold);
        false
    };

// Assertion: check less than or equal
fn assert_lte(actual: i64, threshold: i64) -> bool =
    if actual <= threshold { true } else {
        let u0 = print_str("FAIL: expected ");
        let u1 = print(actual);
        let u2 = print_str(" <= ");
        let u3 = println(threshold);
        false
    };

// Assertion: check in range [min, max]
fn assert_in_range(actual: i64, min_val: i64, max_val: i64) -> bool
  pre min_val <= max_val
= if actual >= min_val and actual <= max_val { true } else {
      let u0 = print_str("FAIL: expected ");
      let u1 = print(actual);
      let u2 = print_str(" in range [");
      let u3 = print(min_val);
      let u4 = print_str(", ");
      let u5 = print(max_val);
      let u6 = println_str("]");
      false
  };

// Test summary tracking
fn count_passed(results: i64, total: i64) -> i64 = results;

fn report_summary(passed: i64, total: i64) -> i64 = {
    let u0 = println_str("");
    let u1 = println_str("--- Test Summary ---");
    let u2 = print_str("Passed: ");
    let u3 = print(passed);
    let u4 = print_str("/");
    let u5 = println(total);
    let u6 = if passed == total { println_str("All tests passed!") } else { println_str("Some tests failed.") };
    if passed == total { 0 } else { 1 }
};

// Simple test runner helper
fn run_test(name_code: i64, result: bool) -> i64 = {
    let status = if result { "PASS" } else { "FAIL" };
    let u0 = print_str("[");
    let u1 = print_str(status);
    let u2 = print_str("] Test ");
    let u3 = println(name_code);
    if result { 1 } else { 0 }};

// --- Tests ---

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_result_codes() -> i64 =
    if result_pass() == 0 and result_fail() == 1 and result_skip() == 2 { 1 } else { 0 };

fn test_assert_eq_pass() -> i64 =
    if b2i(assert_eq(42, 42)) == 1 and b2i(assert_eq(0, 0)) == 1
       and b2i(assert_eq(0 - 1, 0 - 1)) == 1 { 1 } else { 0 };

fn test_assert_eq_fail() -> i64 =
    if b2i(assert_eq(1, 2)) == 0 and b2i(assert_eq(0, 1)) == 0 { 1 } else { 0 };

fn test_assert_ne_pass() -> i64 =
    if b2i(assert_ne(1, 2)) == 1 and b2i(assert_ne(0, 1)) == 1 { 1 } else { 0 };

fn test_assert_ne_fail() -> i64 =
    if b2i(assert_ne(42, 42)) == 0 { 1 } else { 0 };

fn test_assert_true_pass() -> i64 =
    if b2i(assert_true(true)) == 1 and b2i(assert_true(1 == 1)) == 1 { 1 } else { 0 };

fn test_assert_true_fail() -> i64 =
    if b2i(assert_true(false)) == 0 { 1 } else { 0 };

fn test_assert_false_pass() -> i64 =
    if b2i(assert_false(false)) == 1 and b2i(assert_false(1 == 2)) == 1 { 1 } else { 0 };

fn test_assert_false_fail() -> i64 =
    if b2i(assert_false(true)) == 0 { 1 } else { 0 };

fn test_assert_gt() -> i64 =
    if b2i(assert_gt(10, 5)) == 1 and b2i(assert_gt(5, 5)) == 0
       and b2i(assert_gt(3, 5)) == 0 { 1 } else { 0 };

fn test_assert_gte() -> i64 =
    if b2i(assert_gte(10, 5)) == 1 and b2i(assert_gte(5, 5)) == 1
       and b2i(assert_gte(3, 5)) == 0 { 1 } else { 0 };

fn test_assert_lt() -> i64 =
    if b2i(assert_lt(3, 5)) == 1 and b2i(assert_lt(5, 5)) == 0
       and b2i(assert_lt(10, 5)) == 0 { 1 } else { 0 };

fn test_assert_lte() -> i64 =
    if b2i(assert_lte(3, 5)) == 1 and b2i(assert_lte(5, 5)) == 1
       and b2i(assert_lte(10, 5)) == 0 { 1 } else { 0 };

fn test_assert_in_range() -> i64 =
    if b2i(assert_in_range(5, 1, 10)) == 1 and b2i(assert_in_range(1, 1, 10)) == 1
       and b2i(assert_in_range(10, 1, 10)) == 1 and b2i(assert_in_range(0, 1, 10)) == 0
       and b2i(assert_in_range(11, 1, 10)) == 0 { 1 } else { 0 };

fn test_count_passed() -> i64 =
    if count_passed(5, 10) == 5 and count_passed(0, 0) == 0 { 1 } else { 0 };

fn test_run_test_pass() -> i64 =
    if run_test(1, true) == 1 { 1 } else { 0 };

fn test_run_test_fail() -> i64 =
    if run_test(2, false) == 0 { 1 } else { 0 };

fn test_report_summary_all_pass() -> i64 =
    if report_summary(5, 5) == 0 { 1 } else { 0 };

fn test_report_summary_some_fail() -> i64 =
    if report_summary(3, 5) == 1 { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("result_codes", test_result_codes());
    let t2 = report("assert_eq_pass", test_assert_eq_pass());
    let t3 = report("assert_eq_fail", test_assert_eq_fail());
    let t4 = report("assert_ne_pass", test_assert_ne_pass());
    let t5 = report("assert_ne_fail", test_assert_ne_fail());
    let t6 = report("assert_true_pass", test_assert_true_pass());
    let t7 = report("assert_true_fail", test_assert_true_fail());
    let t8 = report("assert_false_pass", test_assert_false_pass());
    let t9 = report("assert_false_fail", test_assert_false_fail());
    let t10 = report("assert_gt", test_assert_gt());
    let t11 = report("assert_gte", test_assert_gte());
    let t12 = report("assert_lt", test_assert_lt());
    let t13 = report("assert_lte", test_assert_lte());
    let t14 = report("assert_in_range", test_assert_in_range());
    let t15 = report("count_passed", test_count_passed());
    let t16 = report("run_test_pass", test_run_test_pass());
    let t17 = report("run_test_fail", test_run_test_fail());
    let t18 = report("report_summary_all_pass", test_report_summary_all_pass());
    let t19 = report("report_summary_some_fail", test_report_summary_some_fail());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12 + t13 + t14 + t15 + t16 + t17 + t18 + t19;
    let total = 19;
    let _p1 = print_str("bmb-testing: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
