// bmb-result: Generic Result type for error handling
// v0.2.0 - Now with generic Result<T, E> support (v0.60.261+)
//
// The Result type represents either success (Ok) with a value,
// or failure (Err) with an error.
//
// Usage:
//   let success = Result::Ok(42);
//   let failure = Result::Err(-1);
//
//   let result = match success {
//       Result::Ok(x) => x * 2,
//       Result::Err(e) => e
//   };

// Result<T, E> enum - represents success or failure
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

// ============================================
// Constructors
// ============================================

// Create Ok variant with a value
@inline
pub fn ok<T, E>(value: T) -> Result<T, E> = Result::Ok(value);

// Create Err variant with an error
@inline
pub fn err<T, E>(error: E) -> Result<T, E> = Result::Err(error);

// Specialized constructors for i64
@inline
pub fn ok_i64(value: i64) -> Result<i64, i64> = Result::Ok(value);

@inline
pub fn err_i64(error: i64) -> Result<i64, i64> = Result::Err(error);

// ============================================
// Predicates
// ============================================

// Check if Result is Ok
pub fn is_ok<T, E>(res: Result<T, E>) -> bool = match res {
    Result::Ok(_) => true,
    Result::Err(_) => false,
};

// Check if Result is Err
pub fn is_err<T, E>(res: Result<T, E>) -> bool = match res {
    Result::Ok(_) => false,
    Result::Err(_) => true,
};

// ============================================
// Extractors (i64 specialization for safety)
// ============================================

// Unwrap the value, returns 0 if Err (i64 version)
pub fn unwrap_i64(res: Result<i64, i64>) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(_) => 0,
};

// Unwrap the error, returns 0 if Ok (i64 version)
pub fn unwrap_err_i64(res: Result<i64, i64>) -> i64 = match res {
    Result::Ok(_) => 0,
    Result::Err(e) => e,
};

// Unwrap with a default value if Err (i64 version)
pub fn unwrap_or_i64(res: Result<i64, i64>, default: i64) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(_) => default,
};

// ============================================
// Transformers (i64 specialization - no closures)
// ============================================

// Double the Ok value
pub fn map_double(res: Result<i64, i64>) -> Result<i64, i64> = match res {
    Result::Ok(x) => Result::Ok(x * 2),
    Result::Err(e) => Result::Err(e),
};

// Increment the Ok value
pub fn map_inc(res: Result<i64, i64>) -> Result<i64, i64> = match res {
    Result::Ok(x) => Result::Ok(x + 1),
    Result::Err(e) => Result::Err(e),
};

// Double the Err value
pub fn map_err_double(res: Result<i64, i64>) -> Result<i64, i64> = match res {
    Result::Ok(x) => Result::Ok(x),
    Result::Err(e) => Result::Err(e * 2),
};

// ============================================
// Combinators (i64 specialization)
// ============================================

// Return first Ok, or second if first is Err
pub fn res_or(res: Result<i64, i64>, other: Result<i64, i64>) -> Result<i64, i64> = match res {
    Result::Ok(x) => Result::Ok(x),
    Result::Err(_) => other,
};

// AND: returns second if first is Ok, else first's Err
pub fn res_and(res: Result<i64, i64>, other: Result<i64, i64>) -> Result<i64, i64> = match res {
    Result::Ok(_) => other,
    Result::Err(e) => Result::Err(e),
};

// ============================================
// Comparison (i64 specialization)
// ============================================

// Check if two Results are equal
pub fn eq(a: Result<i64, i64>, b: Result<i64, i64>) -> bool = {
    let a_ok = is_ok(a);
    let b_ok = is_ok(b);
    if a_ok and b_ok {
        unwrap_i64(a) == unwrap_i64(b)
    } else if not a_ok and not b_ok {
        unwrap_err_i64(a) == unwrap_err_i64(b)
    } else {
        false
    }
};

// ============================================
// Conversion (i64 specialization)
// ============================================

// Convert Result to i64: returns value if Ok, error code if Err
pub fn to_i64(res: Result<i64, i64>) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(e) => e,
};

// ============================================
// Tests
// ============================================

fn test_constructors() -> i64 = {
    let o = ok_i64(42);
    let e = err_i64(-1);

    if not is_ok(o) { 1 }
    else if not is_err(e) { 2 }
    else if is_err(o) { 3 }
    else if is_ok(e) { 4 }
    else { 0 }
};

fn test_unwrap() -> i64 = {
    let o = ok_i64(42);
    let e = err_i64(-1);

    if unwrap_i64(o) != 42 { 1 }
    else if unwrap_err_i64(e) != -1 { 2 }
    else if unwrap_or_i64(o, 0) != 42 { 3 }
    else if unwrap_or_i64(e, 99) != 99 { 4 }
    else { 0 }
};

fn test_map() -> i64 = {
    let o = ok_i64(10);
    let e = err_i64(-5);
    let doubled_ok = map_double(o);
    let doubled_err = map_double(e);
    let inc = map_inc(o);
    let err_doubled = map_err_double(e);

    if unwrap_i64(doubled_ok) != 20 { 1 }
    else if not is_err(doubled_err) { 2 }
    else if unwrap_i64(inc) != 11 { 3 }
    else if unwrap_err_i64(err_doubled) != -10 { 4 }
    else { 0 }
};

fn test_combinators() -> i64 = {
    let o1 = ok_i64(1);
    let o2 = ok_i64(2);
    let e = err_i64(-1);

    // res_or
    if unwrap_i64(res_or(o1, o2)) != 1 { 1 }
    else if unwrap_i64(res_or(e, o2)) != 2 { 2 }
    // res_and
    else if unwrap_i64(res_and(o1, o2)) != 2 { 3 }
    else if is_ok(res_and(e, o2)) { 4 }
    else { 0 }
};

fn test_equality() -> i64 = {
    let o1 = ok_i64(42);
    let o2 = ok_i64(42);
    let o3 = ok_i64(99);
    let e1 = err_i64(-1);
    let e2 = err_i64(-1);
    let e3 = err_i64(-2);

    if not eq(o1, o2) { 1 }
    else if eq(o1, o3) { 2 }
    else if eq(o1, e1) { 3 }
    else if not eq(e1, e2) { 4 }
    else if eq(e1, e3) { 5 }
    else { 0 }
};

// Test generic Result with different types
fn test_generic() -> i64 = {
    let r1 = ok_i64(100);
    let r2 = err_i64(-50);

    if unwrap_i64(r1) != 100 { 1 }
    else if unwrap_err_i64(r2) != -50 { 2 }
    else { 0 }
};

fn main() -> i64 = {
    let r1 = test_constructors();
    if r1 != 0 { let _p = println(r1); r1 }
    else {
        let r2 = test_unwrap();
        if r2 != 0 { let _p = println(r2 + 10); r2 + 10 }
        else {
            let r3 = test_map();
            if r3 != 0 { let _p = println(r3 + 20); r3 + 20 }
            else {
                let r4 = test_combinators();
                if r4 != 0 { let _p = println(r4 + 30); r4 + 30 }
                else {
                    let r5 = test_equality();
                    if r5 != 0 { let _p = println(r5 + 40); r5 + 40 }
                    else {
                        let r6 = test_generic();
                        if r6 != 0 { let _p = println(r6 + 50); r6 + 50 }
                        else {
                            let _p = println(999);
                            999
                        }
                    }
                }
            }
        }
    }
};
