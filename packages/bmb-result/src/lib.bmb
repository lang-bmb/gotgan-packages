// bmb-result: Result type for error handling
// v0.1.0
//
// The Result type represents either success (Ok) with a value,
// or failure (Err) with an error code.
//
// Usage:
//   let success = Result::Ok(42);
//   let failure = Result::Err(-1);
//
//   let result = match success {
//       Result::Ok(x) => x * 2,
//       Result::Err(e) => e
//   };

// Result enum - represents success or failure
enum Result {
    Ok(i64),
    Err(i64)
}

// ============================================
// Constructors
// ============================================

// Create Ok variant with a value
@inline
pub fn ok(value: i64) -> Result = Result::Ok(value);

// Create Err variant with an error code
@inline
pub fn err(code: i64) -> Result = Result::Err(code);

// ============================================
// Predicates
// ============================================

// Check if Result is Ok
pub fn is_ok(res: Result) -> bool = match res {
    Result::Ok(_) => true,
    Result::Err(_) => false
};

// Check if Result is Err
pub fn is_err(res: Result) -> bool = match res {
    Result::Ok(_) => false,
    Result::Err(_) => true
};

// ============================================
// Extractors
// ============================================

// Unwrap the value, returns 0 if Err
pub fn unwrap(res: Result) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(_) => 0
};

// Unwrap the error, returns 0 if Ok
pub fn unwrap_err(res: Result) -> i64 = match res {
    Result::Ok(_) => 0,
    Result::Err(e) => e
};

// Unwrap with a default value if Err
pub fn unwrap_or(res: Result, default: i64) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(_) => default
};

// ============================================
// Transformers
// ============================================

// Double the Ok value
pub fn map_double(res: Result) -> Result = match res {
    Result::Ok(x) => Result::Ok(x * 2),
    Result::Err(e) => Result::Err(e)
};

// Increment the Ok value
pub fn map_inc(res: Result) -> Result = match res {
    Result::Ok(x) => Result::Ok(x + 1),
    Result::Err(e) => Result::Err(e)
};

// Double the Err value
pub fn map_err_double(res: Result) -> Result = match res {
    Result::Ok(x) => Result::Ok(x),
    Result::Err(e) => Result::Err(e * 2)
};

// ============================================
// Combinators
// ============================================

// Return first Ok, or second if first is Err
pub fn res_or(res: Result, other: Result) -> Result = match res {
    Result::Ok(x) => Result::Ok(x),
    Result::Err(_) => other
};

// AND: returns second if first is Ok, else first's Err
pub fn res_and(res: Result, other: Result) -> Result = match res {
    Result::Ok(_) => other,
    Result::Err(e) => Result::Err(e)
};

// ============================================
// Comparison
// ============================================

// Check if two Results are equal
pub fn eq(a: Result, b: Result) -> bool = {
    let a_ok = is_ok(a);
    let b_ok = is_ok(b);
    if a_ok and b_ok {
        unwrap(a) == unwrap(b)
    } else if not a_ok and not b_ok {
        unwrap_err(a) == unwrap_err(b)
    } else {
        false
    }
};

// ============================================
// Conversion
// ============================================

// Convert Result to i64: returns value if Ok, error code if Err
pub fn to_i64(res: Result) -> i64 = match res {
    Result::Ok(x) => x,
    Result::Err(e) => e
};

// ============================================
// Tests
// ============================================

fn test_constructors() -> i64 = {
    let o = ok(42);
    let e = err(-1);

    if not is_ok(o) { 1 }
    else if not is_err(e) { 2 }
    else if is_err(o) { 3 }
    else if is_ok(e) { 4 }
    else { 0 }
};

fn test_unwrap() -> i64 = {
    let o = ok(42);
    let e = err(-1);

    if unwrap(o) != 42 { 1 }
    else if unwrap_err(e) != -1 { 2 }
    else if unwrap_or(o, 0) != 42 { 3 }
    else if unwrap_or(e, 99) != 99 { 4 }
    else { 0 }
};

fn test_map() -> i64 = {
    let o = ok(10);
    let e = err(-5);
    let doubled_ok = map_double(o);
    let doubled_err = map_double(e);
    let inc = map_inc(o);
    let err_doubled = map_err_double(e);

    if unwrap(doubled_ok) != 20 { 1 }
    else if not is_err(doubled_err) { 2 }
    else if unwrap(inc) != 11 { 3 }
    else if unwrap_err(err_doubled) != -10 { 4 }
    else { 0 }
};

fn test_combinators() -> i64 = {
    let o1 = ok(1);
    let o2 = ok(2);
    let e = err(-1);

    // res_or
    if unwrap(res_or(o1, o2)) != 1 { 1 }
    else if unwrap(res_or(e, o2)) != 2 { 2 }
    // res_and
    else if unwrap(res_and(o1, o2)) != 2 { 3 }
    else if is_ok(res_and(e, o2)) { 4 }
    else { 0 }
};

fn test_equality() -> i64 = {
    let o1 = ok(42);
    let o2 = ok(42);
    let o3 = ok(99);
    let e1 = err(-1);
    let e2 = err(-1);
    let e3 = err(-2);

    if not eq(o1, o2) { 1 }
    else if eq(o1, o3) { 2 }
    else if eq(o1, e1) { 3 }
    else if not eq(e1, e2) { 4 }
    else if eq(e1, e3) { 5 }
    else { 0 }
};

fn main() -> i64 = {
    let r1 = test_constructors();
    if r1 != 0 { let _p = println(r1); r1 }
    else {
        let r2 = test_unwrap();
        if r2 != 0 { let _p = println(r2 + 10); r2 + 10 }
        else {
            let r3 = test_map();
            if r3 != 0 { let _p = println(r3 + 20); r3 + 20 }
            else {
                let r4 = test_combinators();
                if r4 != 0 { let _p = println(r4 + 30); r4 + 30 }
                else {
                    let r5 = test_equality();
                    if r5 != 0 { let _p = println(r5 + 40); r5 + 40 }
                    else {
                        let _p = println(999);
                        999
                    }
                }
            }
        }
    }
};
