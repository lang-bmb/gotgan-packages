// bmb-euler: Euler's totient function and number theory utilities for BMB
// Euler's totient, GCD/LCM extensions, modular multiplicative order

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Greatest Common Divisor (Euclidean algorithm)
fn gcd(a: i64, b: i64) -> i64
  pre a >= 0 and b >= 0
  post ret >= 0
= if b == 0 { a } else { gcd(b, a % b) };

// Least Common Multiple
fn lcm(a: i64, b: i64) -> i64
  pre a > 0 and b > 0
  post ret >= a and ret >= b
= (a / gcd(a, b)) * b;

// Extended GCD: computes gcd and Bezout coefficient x where a*x + b*y = gcd(a,b)
// Returns the x coefficient
fn ext_gcd_x(a: i64, b: i64) -> i64 = {
    let mut old_r = a;
    let mut r = b;
    let mut old_s = 1;
    let mut s = 0;
    while r > 0 {
        let q = old_r / r;
        let temp_r = r;
        r = old_r - q * r;
        old_r = temp_r;
        let temp_s = s;
        s = old_s - q * s;
        old_s = temp_s;
        0
    };
    old_s
};

// Extended GCD: returns the y coefficient where a*x + b*y = gcd(a,b)
fn ext_gcd_y(a: i64, b: i64) -> i64 = {
    let mut old_r = a;
    let mut r = b;
    let mut old_t = 0;
    let mut t = 1;
    while r > 0 {
        let q = old_r / r;
        let temp_r = r;
        r = old_r - q * r;
        old_r = temp_r;
        let temp_t = t;
        t = old_t - q * t;
        old_t = temp_t;
        0
    };
    old_t
};

// Euler's totient function: counts integers 1..n coprime with n
fn euler_totient(n: i64) -> i64
  pre n >= 1
  post ret >= 1
= {
    let mut result = n;
    let mut num = n;
    let mut p = 2;
    let mut done = false;
    while not done {
        let _r = if p * p > num {
            { done = true; 0 }
        } else if num % p == 0 {
            {
                // Remove all factors of p
                while num % p == 0 {
                    num = num / p;
                    0
                };
                // result = result * (p - 1) / p
                result = result / p * (p - 1);
                p = p + 1;
                0
            }
        } else {
            { p = p + 1; 0 }
        };
        0
    };
    // If num > 1, then it's a remaining prime factor
    let _last = if num > 1 {
        { result = result / num * (num - 1); 0 }
    } else { 0 };
    result
};

// Modular exponentiation: (base^exp) mod m
fn powmod(base: i64, exp: i64, m: i64) -> i64
  pre m > 0 and exp >= 0
= {
    let mut result = 1;
    let mut b = ((base % m) + m) % m;
    let mut e = exp;
    while e > 0 {
        let _r = if e % 2 == 1 {
            { result = (result * b) % m; 0 }
        } else { 0 };
        e = e / 2;
        b = (b * b) % m;
        0
    };
    result
};

// Modular multiplicative order: smallest k > 0 such that a^k == 1 (mod m)
// Pre: gcd(a, m) = 1
// Returns -1 if no order exists (should not happen when gcd(a,m)=1)
fn mult_order(a: i64, m: i64) -> i64
  pre m > 1
= {
    let g = gcd(((a % m) + m) % m, m);
    if g == 1 {
        {
            let mut k = 1;
            let mut power = ((a % m) + m) % m;
            let mut done = false;
            while not done {
                let _r = if power == 1 {
                    { done = true; 0 }
                } else if k > m {
                    // Safety: order divides totient(m) <= m, so this shouldn't happen
                    { done = true; k = 0 - 1; 0 }
                } else {
                    { power = (power * (((a % m) + m) % m)) % m; k = k + 1; 0 }
                };
                0
            };
            k
        }
    } else {
        0 - 1
    }
};

// GCD of multiple values (using a vec)
// Computes gcd of all elements in vec v of length len
fn gcd_of_vec(v: i64, len: i64) -> i64
  pre len >= 1
= {
    let mut result = vec_get(v, 0);
    let _adj = if result < 0 { { result = 0 - result; 0 } } else { 0 };
    let mut i = 1;
    while i < len {
        let val = vec_get(v, i);
        let abs_val = if val < 0 { 0 - val } else { val };
        result = gcd(result, abs_val);
        i = i + 1;
        0
    };
    result
};

// LCM of multiple values
fn lcm_of_vec(v: i64, len: i64) -> i64
  pre len >= 1
= {
    let mut result = vec_get(v, 0);
    let _adj = if result < 0 { { result = 0 - result; 0 } } else { 0 };
    let mut i = 1;
    while i < len {
        let val = vec_get(v, i);
        let abs_val = if val < 0 { 0 - val } else { val };
        result = lcm(result, abs_val);
        i = i + 1;
        0
    };
    result
};

// Coprimality check
fn is_coprime(a: i64, b: i64) -> bool
  pre a >= 0 and b >= 0
= gcd(a, b) == 1;

// Count coprimes of n in range [1, n]
// This is just euler_totient(n) but verifiable via brute force
fn count_coprimes(n: i64) -> i64
  pre n >= 1
= {
    let mut count = 0;
    let mut i = 1;
    while i <= n {
        let _r = if gcd(i, n) == 1 {
            { count = count + 1; 0 }
        } else { 0 };
        i = i + 1;
        0
    };
    count
};

// ============================================================
// Tests
// ============================================================

fn test_gcd() -> i64 = {
    let ok = gcd(12, 8) == 4 and gcd(17, 13) == 1
        and gcd(100, 0) == 100 and gcd(0, 7) == 7
        and gcd(54, 24) == 6;
    b2i(ok)
};

fn test_lcm() -> i64 = {
    let ok = lcm(4, 6) == 12 and lcm(7, 3) == 21
        and lcm(5, 5) == 5 and lcm(12, 18) == 36;
    b2i(ok)
};

fn test_ext_gcd() -> i64 = {
    // 12*x + 8*y = 4
    let x = ext_gcd_x(12, 8);
    let y = ext_gcd_y(12, 8);
    let check1 = 12 * x + 8 * y;
    // 35*x + 15*y = 5
    let x2 = ext_gcd_x(35, 15);
    let y2 = ext_gcd_y(35, 15);
    let check2 = 35 * x2 + 15 * y2;
    if check1 == 4 and check2 == 5 { 1 } else { 0 }
};

fn test_totient_primes() -> i64 = {
    // For prime p: totient(p) = p - 1
    let ok = euler_totient(2) == 1 and euler_totient(3) == 2
        and euler_totient(5) == 4 and euler_totient(7) == 6
        and euler_totient(13) == 12;
    b2i(ok)
};

fn test_totient_composite() -> i64 = {
    // totient(1) = 1
    // totient(6) = 2 (coprime: 1, 5)
    // totient(10) = 4 (coprime: 1, 3, 7, 9)
    // totient(12) = 4 (coprime: 1, 5, 7, 11)
    let ok = euler_totient(1) == 1 and euler_totient(6) == 2
        and euler_totient(10) == 4 and euler_totient(12) == 4;
    b2i(ok)
};

fn test_totient_power_of_2() -> i64 = {
    // totient(2^k) = 2^(k-1)
    let ok = euler_totient(4) == 2 and euler_totient(8) == 4
        and euler_totient(16) == 8 and euler_totient(32) == 16;
    b2i(ok)
};

fn test_totient_vs_brute() -> i64 = {
    // Verify totient matches brute-force count for several values
    let mut ok = true;
    let mut n = 1;
    while n <= 30 {
        let _r = if euler_totient(n) == count_coprimes(n) { 0 } else {
            { ok = false; 0 }
        };
        n = n + 1;
        0
    };
    b2i(ok)
};

fn test_mult_order() -> i64 = {
    // ord_7(2): 2^1=2, 2^2=4, 2^3=1 mod 7 => order = 3
    let o1 = mult_order(2, 7);
    // ord_7(3): 3^1=3, 3^2=2, 3^3=6, 3^4=4, 3^5=5, 3^6=1 => order = 6
    let o2 = mult_order(3, 7);
    // ord_10(3): 3^1=3, 3^2=9, 3^3=7, 3^4=1 => order = 4
    let o3 = mult_order(3, 10);
    if o1 == 3 and o2 == 6 and o3 == 4 { 1 } else { 0 }
};

fn test_gcd_of_vec() -> i64 = {
    let v = vec_new();
    let _p1 = vec_push(v, 12);
    let _p2 = vec_push(v, 18);
    let _p3 = vec_push(v, 24);
    let g = gcd_of_vec(v, 3);
    let _f = vec_free(v);
    if g == 6 { 1 } else { 0 }
};

fn test_lcm_of_vec() -> i64 = {
    let v = vec_new();
    let _p1 = vec_push(v, 4);
    let _p2 = vec_push(v, 6);
    let _p3 = vec_push(v, 10);
    let l = lcm_of_vec(v, 3);
    let _f = vec_free(v);
    // lcm(4,6) = 12, lcm(12,10) = 60
    if l == 60 { 1 } else { 0 }
};

fn test_is_coprime() -> i64 = {
    let r1 = b2i(is_coprime(3, 7));   // yes
    let r2 = b2i(is_coprime(6, 9));   // no, gcd=3
    let r3 = b2i(is_coprime(1, 100)); // yes
    if r1 == 1 and r2 == 0 and r3 == 1 { 1 } else { 0 }
};

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("gcd", test_gcd());
    let t2 = report("lcm", test_lcm());
    let t3 = report("ext_gcd", test_ext_gcd());
    let t4 = report("totient_primes", test_totient_primes());
    let t5 = report("totient_composite", test_totient_composite());
    let t6 = report("totient_power_of_2", test_totient_power_of_2());
    let t7 = report("totient_vs_brute", test_totient_vs_brute());
    let t8 = report("mult_order", test_mult_order());
    let t9 = report("gcd_of_vec", test_gcd_of_vec());
    let t10 = report("lcm_of_vec", test_lcm_of_vec());
    let t11 = report("is_coprime", test_is_coprime());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11;
    let total = 11;
    let _p1 = print_str("bmb-euler: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
