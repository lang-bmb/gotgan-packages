// bmb-cache: LFU (Least Frequently Used) cache
// v0.1.0
//
// Fixed-capacity cache that evicts the least frequently used entry on overflow.
// Implemented with two open-addressing hash tables:
//   1. key → (value, frequency)
//   2. key → frequency (separate freq map for easy eviction)
//
// Memory layout (one contiguous allocation):
//   Header (24 bytes): [cap, size, min_freq]
//   KV table: cap*2 buckets × 24 bytes each: [key, val, freq]
//     (bucket key == 0 && freq == 0 means empty; key == TOMBSTONE means deleted)
//
// Sentinel values:
//   CACHE_NOT_FOUND = i64::MIN  (returned when key absent)
//   CACHE_TOMBSTONE = i64::MIN + 1  (deleted slot marker)

// ============================================================================
// Sentinel constants
// ============================================================================

fn CACHE_NOT_FOUND() -> i64 = 0 - 9223372036854775807 - 1;
fn CACHE_TOMBSTONE() -> i64 = 0 - 9223372036854775806;
fn CACHE_EMPTY_KEY() -> i64 = 0 - 9223372036854775805;

// ============================================================================
// Header layout helpers
// ============================================================================

fn cache_cap(c: i64) -> i64 = load_i64(c);
fn cache_set_cap(c: i64, v: i64) -> i64 = store_i64(c, v);
fn cache_sz(c: i64) -> i64 = load_i64(c + 8);
fn cache_set_sz(c: i64, v: i64) -> i64 = store_i64(c + 8, v);
fn cache_min_freq(c: i64) -> i64 = load_i64(c + 16);
fn cache_set_min_freq(c: i64, v: i64) -> i64 = store_i64(c + 16, v);

// ============================================================================
// KV table layout (starts at offset 24, bucket = 24 bytes each)
// Bucket: [key(8), val(8), freq(8)]
// ============================================================================

fn BUCKET_SIZE() -> i64 = 24;

fn kv_base(c: i64) -> i64 = c + 24;
fn kv_htcap(c: i64) -> i64 = cache_cap(c) * 2;

fn kv_bucket(c: i64, slot: i64) -> i64 =
    kv_base(c) + slot * BUCKET_SIZE();

fn kv_get_key(c: i64, slot: i64) -> i64 = load_i64(kv_bucket(c, slot));
fn kv_get_val(c: i64, slot: i64) -> i64 = load_i64(kv_bucket(c, slot) + 8);
fn kv_get_freq(c: i64, slot: i64) -> i64 = load_i64(kv_bucket(c, slot) + 16);

fn kv_set_key(c: i64, slot: i64, v: i64) -> i64 = store_i64(kv_bucket(c, slot), v);
fn kv_set_val(c: i64, slot: i64, v: i64) -> i64 = store_i64(kv_bucket(c, slot) + 8, v);
fn kv_set_freq(c: i64, slot: i64, v: i64) -> i64 = store_i64(kv_bucket(c, slot) + 16, v);

// ============================================================================
// Hash helpers
// ============================================================================

fn cache_hash(key: i64, htcap: i64) -> i64 = {
    let h = key * 6364136223846793005;
    let h2 = h bxor (h >> 32);
    let pos = h2 band 9223372036854775807;
    pos - (pos / htcap) * htcap
};

// Find slot for key (returns slot with matching key, or first empty/tombstone for insertion)
fn kv_find_slot(c: i64, key: i64) -> i64 = {
    let htcap = kv_htcap(c);
    let mut slot = cache_hash(key, htcap);
    let mut first_tomb = 0 - 1;
    let mut found = 0 - 1;
    let mut i = 0;
    while i < htcap {
        let k = kv_get_key(c, slot);
        let f = kv_get_freq(c, slot);
        let _r = if k == key and f != 0 {
            found = slot;
            i = htcap; 0
        } else if k == CACHE_TOMBSTONE() {
            let _rt = if first_tomb == 0 - 1 { first_tomb = slot; 0 } else { 0 };
            slot = if slot + 1 >= htcap { 0 } else { slot + 1 };
            i = i + 1; 0
        } else if f == 0 and k != key {
            // Empty slot
            let _re = if first_tomb == 0 - 1 { first_tomb = slot; 0 } else { 0 };
            i = htcap; 0
        } else {
            slot = if slot + 1 >= htcap { 0 } else { slot + 1 };
            i = i + 1; 0
        };
        0
    };
    if found != 0 - 1 { found } else { first_tomb }
};

// Lookup only: returns slot index if found (freq != 0), else -1
fn kv_lookup(c: i64, key: i64) -> i64 = {
    let htcap = kv_htcap(c);
    let mut slot = cache_hash(key, htcap);
    let mut found = 0 - 1;
    let mut i = 0;
    while i < htcap {
        let k = kv_get_key(c, slot);
        let f = kv_get_freq(c, slot);
        let _r = if k == key and f != 0 {
            found = slot; i = htcap; 0
        } else if f == 0 and k != CACHE_TOMBSTONE() {
            i = htcap; 0
        } else {
            slot = if slot + 1 >= htcap { 0 } else { slot + 1 };
            i = i + 1; 0
        };
        0
    };
    found
};

// ============================================================================
// Eviction: remove entry with minimum frequency (linear scan)
// ============================================================================

fn cache_evict_lfu(c: i64) -> i64 = {
    let htcap = kv_htcap(c);
    let min_f = cache_min_freq(c);
    let mut evicted = 0;
    let mut i = 0;
    while i < htcap {
        let f = kv_get_freq(c, i);
        let _r = if f == min_f and evicted == 0 {
            // Mark as tombstone
            let _sk = kv_set_key(c, i, CACHE_TOMBSTONE());
            let _sv = kv_set_val(c, i, 0);
            let _sf = kv_set_freq(c, i, 0);
            let _ss = cache_set_sz(c, cache_sz(c) - 1);
            evicted = 1; 0
        } else { 0 };
        i = i + 1;
        0
    };
    // Recompute min_freq after eviction
    let mut new_min = 9223372036854775807;
    let mut j = 0;
    while j < htcap {
        let f = kv_get_freq(c, j);
        let _r = if f != 0 and f < new_min { new_min = f; 0 } else { 0 };
        j = j + 1;
        0
    };
    let _sm = if new_min == 9223372036854775807 {
        cache_set_min_freq(c, 1)
    } else {
        cache_set_min_freq(c, new_min)
    };
    0
};

// ============================================================================
// Public API
// ============================================================================

fn cache_new(capacity: i64) -> i64
  pre capacity > 0
  post ret != 0
= {
    let htcap = capacity * 2;
    let total = 24 + htcap * BUCKET_SIZE();
    let c = malloc(total);
    // Zero entire allocation
    let mut i = 0;
    while i < total {
        let _s = store_i64(c + i, 0);
        i = i + 8;
        0
    };
    let _sc = cache_set_cap(c, capacity);
    let _sm = cache_set_min_freq(c, 1);
    c
};

fn cache_get(c: i64, key: i64) -> i64
  pre c != 0
= {
    let slot = kv_lookup(c, key);
    if slot == 0 - 1 { CACHE_NOT_FOUND() }
    else {
        let v = kv_get_val(c, slot);
        let f = kv_get_freq(c, slot);
        let new_f = f + 1;
        let _sf = kv_set_freq(c, slot, new_f);
        // Update min_freq: if we incremented the min_freq entry, min_freq may need to go up
        // Only bump if this was the sole entry at min_freq
        let cur_min = cache_min_freq(c);
        let _rm = if f == cur_min {
            // Check if any other entry still has cur_min freq
            let htcap = kv_htcap(c);
            let mut still_min = 0;
            let mut j = 0;
            while j < htcap {
                let ff = kv_get_freq(c, j);
                let _rj = if ff == cur_min { still_min = 1; j = htcap; 0 } else { 0 };
                j = j + 1;
                0
            };
            if still_min == 0 { cache_set_min_freq(c, cur_min + 1) } else { 0 }
        } else { 0 };
        v
    }
};

fn cache_put(c: i64, key: i64, val: i64) -> i64
  pre c != 0
= {
    let slot = kv_lookup(c, key);
    if slot != 0 - 1 {
        // Key exists: update value, increment frequency
        let _sv = kv_set_val(c, slot, val);
        let f = kv_get_freq(c, slot);
        let new_f = f + 1;
        let _sf = kv_set_freq(c, slot, new_f);
        // Update min_freq
        let cur_min = cache_min_freq(c);
        let _rm = if f == cur_min {
            let htcap = kv_htcap(c);
            let mut still_min = 0;
            let mut j = 0;
            while j < htcap {
                let ff = kv_get_freq(c, j);
                let _rj = if ff == cur_min { still_min = 1; j = htcap; 0 } else { 0 };
                j = j + 1;
                0
            };
            if still_min == 0 { cache_set_min_freq(c, cur_min + 1) } else { 0 }
        } else { 0 };
        0
    } else {
        // New key: evict if at capacity
        let cap = cache_cap(c);
        let sz = cache_sz(c);
        let _ev = if sz >= cap { cache_evict_lfu(c) } else { 0 };
        let ins_slot = kv_find_slot(c, key);
        let _sk = kv_set_key(c, ins_slot, key);
        let _sv = kv_set_val(c, ins_slot, val);
        let _sf = kv_set_freq(c, ins_slot, 1);
        let _ss = cache_set_sz(c, cache_sz(c) + 1);
        // New entry always has freq 1; min_freq = 1
        let _sm = cache_set_min_freq(c, 1);
        0
    }
};

fn cache_size(c: i64) -> i64
  pre c != 0
  post ret >= 0
= cache_sz(c);

fn cache_free(c: i64) -> i64
  pre c != 0
= { let _f = free(c); 0 };

// ============================================================================
// Tests
// ============================================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_basic_put_get() -> i64 = {
    let c = cache_new(4);
    let _p1 = cache_put(c, 1, 100);
    let _p2 = cache_put(c, 2, 200);
    let _p3 = cache_put(c, 3, 300);
    let v1 = cache_get(c, 1);
    let v2 = cache_get(c, 2);
    let v3 = cache_get(c, 3);
    let sz = cache_size(c);
    let _f = cache_free(c);
    if v1 == 100 and v2 == 200 and v3 == 300 and sz == 3 { 1 } else { 0 }
};

fn test_not_found() -> i64 = {
    let c = cache_new(4);
    let _p = cache_put(c, 10, 99);
    let v = cache_get(c, 99);
    let _f = cache_free(c);
    if v == CACHE_NOT_FOUND() { 1 } else { 0 }
};

fn test_update_existing() -> i64 = {
    let c = cache_new(4);
    let _p1 = cache_put(c, 5, 50);
    let _p2 = cache_put(c, 5, 555);
    let v = cache_get(c, 5);
    let sz = cache_size(c);
    let _f = cache_free(c);
    if v == 555 and sz == 1 { 1 } else { 0 }
};

fn test_lfu_eviction() -> i64 = {
    // cap=2: put 1 and 2. Access 1 twice (freq=2), 2 stays freq=1.
    // Now put 3 -> evicts 2 (LFU with freq=1).
    let c = cache_new(2);
    let _p1 = cache_put(c, 1, 10);
    let _p2 = cache_put(c, 2, 20);
    let _g1 = cache_get(c, 1);
    let _g2 = cache_get(c, 1);
    // freq(1)=3, freq(2)=1
    let _p3 = cache_put(c, 3, 30);  // evicts key=2
    let v1 = cache_get(c, 1);
    let v2 = cache_get(c, 2);
    let v3 = cache_get(c, 3);
    let sz = cache_size(c);
    let _f = cache_free(c);
    if v1 == 10 and v2 == CACHE_NOT_FOUND() and v3 == 30 and sz == 2 { 1 } else { 0 }
};

fn test_lfu_keeps_frequent() -> i64 = {
    // cap=3: insert A,B,C. Access A 5x, B 3x, C 1x.
    // Insert D -> evicts C (min freq=1).
    let c = cache_new(3);
    let _pa = cache_put(c, 10, 1000);
    let _pb = cache_put(c, 20, 2000);
    let _pc = cache_put(c, 30, 3000);
    let mut i = 0;
    while i < 5 { let _g = cache_get(c, 10); i = i + 1; 0 };
    let mut j = 0;
    while j < 3 { let _g = cache_get(c, 20); j = j + 1; 0 };
    let _pd = cache_put(c, 40, 4000);  // evicts key=30
    let va = cache_get(c, 10);
    let vb = cache_get(c, 20);
    let vc = cache_get(c, 30);
    let vd = cache_get(c, 40);
    let _f = cache_free(c);
    if va == 1000 and vb == 2000 and vc == CACHE_NOT_FOUND() and vd == 4000 { 1 } else { 0 }
};

fn test_size_tracking() -> i64 = {
    let c = cache_new(3);
    let s0 = cache_size(c);
    let _p1 = cache_put(c, 1, 1);
    let s1 = cache_size(c);
    let _p2 = cache_put(c, 2, 2);
    let s2 = cache_size(c);
    let _p3 = cache_put(c, 3, 3);
    let s3 = cache_size(c);
    let _p4 = cache_put(c, 4, 4);  // eviction, still cap=3
    let s4 = cache_size(c);
    let _f = cache_free(c);
    if s0 == 0 and s1 == 1 and s2 == 2 and s3 == 3 and s4 == 3 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("basic_put_get", test_basic_put_get());
    let t2 = report("not_found", test_not_found());
    let t3 = report("update_existing", test_update_existing());
    let t4 = report("lfu_eviction", test_lfu_eviction());
    let t5 = report("lfu_keeps_frequent", test_lfu_keeps_frequent());
    let t6 = report("size_tracking", test_size_tracking());
    let passed = t1 + t2 + t3 + t4 + t5 + t6;
    let total = 6;
    let _p1 = print_str("bmb-cache: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
