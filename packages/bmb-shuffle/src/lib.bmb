// bmb-shuffle: Array shuffling and permutation utilities
// v0.1.0
//
// Implements Fisher-Yates shuffle and random sampling using a
// linear congruential generator (LCG) for reproducible pseudo-randomness.
//
// LCG parameters (Knuth MMIX):
//   a = 6364136223846793005
//   c = 1442695040888963407
//   m = 2^64 (implicit via i64 overflow)
//
// Functions:
//   shuffle_seed(s)              -> initial LCG state (i64)
//   shuffle_next(state)          -> next LCG state (i64)
//   shuffle_array(v, len, seed)  -> shuffle v[0..len-1] in-place
//   shuffle_sample(v,len,k,seed) -> new vec with k random elements
//   is_sorted(v, len)            -> bool

// ============================================================
// LCG core
// ============================================================

// LCG multiplier (Knuth MMIX)
fn LCG_A() -> i64 = 6364136223846793005;

// LCG increment
fn LCG_C() -> i64 = 1442695040888963407;

// Initialize seed: ensure non-zero and well-mixed.
fn shuffle_seed(s: i64) -> i64 =
    if s == 0 { LCG_A() }
    else {
        let mixed = s * LCG_A() + LCG_C();
        if mixed == 0 { LCG_A() } else { mixed }
    };

// Advance LCG state by one step.
fn shuffle_next(state: i64) -> i64 = state * LCG_A() + LCG_C();

// ============================================================
// Range helpers
// ============================================================

// Extract a non-negative value in [0, bound) from LCG state.
// bound must be > 0.
fn lcg_range(state: i64, bound: i64) -> i64
  pre bound > 0
  post ret >= 0 and ret < bound
= {
    // Make positive by masking sign bit, then mod
    let pos = (state >> 1) band 4611686018427387903;
    let r = pos - (pos / bound) * bound;
    r
};

// ============================================================
// In-place swap of two vec elements
// ============================================================

// Swap vec[i] and vec[j] in-place.
fn vec_swap_elems(v: i64, i: i64, j: i64) -> i64
  pre v != 0
= {
    let tmp = vec_get(v, i);
    vec_set(v, i, vec_get(v, j));
    vec_set(v, j, tmp);
    0
};

// ============================================================
// Fisher-Yates in-place shuffle
// ============================================================

// Shuffle v[0..len-1] in-place using Fisher-Yates with LCG seeded by seed.
fn shuffle_array(v: i64, len: i64, seed: i64) -> i64
  pre v != 0 and len >= 0
= {
    if len <= 1 {
        0
    } else {
        let mut state = shuffle_seed(seed);
        let mut i = len - 1;
        while i > 0 {
            state = shuffle_next(state);
            let j = lcg_range(state, i + 1);
            let _sw = vec_swap_elems(v, i, j);
            i = i - 1;
            0
        };
        0
    }
};

// ============================================================
// Random k-element sample (returns new vec)
// ============================================================

// Return a new vec containing k elements selected uniformly at random
// from v[0..len-1] without replacement (partial Fisher-Yates).
// If k >= len, all len elements are returned in shuffled order.
// Caller must free the returned vec.
fn shuffle_sample(v: i64, len: i64, k: i64, seed: i64) -> i64
  pre v != 0 and len >= 0 and k >= 0
= {
    // Build a temporary copy of v[0..len-1]
    let tmp = vec_new();
    let mut ci = 0;
    while ci < len {
        vec_push(tmp, vec_get(v, ci));
        ci = ci + 1;
        0
    };

    let take = if k < len { k } else { len };
    let result = vec_new();
    let mut state = shuffle_seed(seed);
    let mut i = 0;
    while i < take {
        // Pick a random index in [i, len-1]
        let remaining = len - i;
        state = shuffle_next(state);
        let j = i + lcg_range(state, remaining);
        // Swap tmp[i] and tmp[j]
        let _sw = vec_swap_elems(tmp, i, j);
        // Take tmp[i]
        vec_push(result, vec_get(tmp, i));
        i = i + 1;
        0
    };

    let _f = vec_free(tmp);
    result
};

// ============================================================
// Sorted check
// ============================================================

// Return true if v[0..len-1] is sorted in non-decreasing order.
fn is_sorted(v: i64, len: i64) -> bool
  pre v != 0 and len >= 0
= {
    if len <= 1 {
        true
    } else {
        let mut ok = true;
        let mut i = 1;
        while i < len {
            if vec_get(v, i - 1) > vec_get(v, i) {
                ok = false;
                0
            } else { 0 };
            i = i + 1;
            0
        };
        ok
    }
};

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_seed_nonzero() -> i64 = {
    let s = shuffle_seed(0);
    if s != 0 { 1 } else { 0 }
};

fn test_seed_deterministic() -> i64 = {
    let s1 = shuffle_seed(42);
    let s2 = shuffle_seed(42);
    if s1 == s2 { 1 } else { 0 }
};

fn test_next_advances() -> i64 = {
    let s0 = shuffle_seed(1);
    let s1 = shuffle_next(s0);
    let s2 = shuffle_next(s1);
    if s0 != s1 and s1 != s2 { 1 } else { 0 }
};

fn test_lcg_range_bounds() -> i64 = {
    let s = shuffle_seed(999);
    let s1 = shuffle_next(s);
    let s2 = shuffle_next(s1);
    let s3 = shuffle_next(s2);
    let r1 = lcg_range(s1, 10);
    let r2 = lcg_range(s2, 5);
    let r3 = lcg_range(s3, 1);
    if r1 >= 0 and r1 < 10 and r2 >= 0 and r2 < 5 and r3 == 0 { 1 } else { 0 }
};

fn test_swap_elems() -> i64 = {
    let v = vec_new();
    vec_push(v, 10);
    vec_push(v, 20);
    let _sw = vec_swap_elems(v, 0, 1);
    let ok = vec_get(v, 0) == 20 and vec_get(v, 1) == 10;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_shuffle_empty() -> i64 = {
    let v = vec_new();
    let _s = shuffle_array(v, 0, 42);
    let ok = vec_len(v) == 0;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_shuffle_single() -> i64 = {
    let v = vec_new();
    vec_push(v, 77);
    let _s = shuffle_array(v, 1, 42);
    let ok = vec_len(v) == 1 and vec_get(v, 0) == 77;
    let _f = vec_free(v);
    if ok { 1 } else { 0 }
};

fn test_shuffle_preserves_elements() -> i64 = {
    // Shuffle [0,1,2,3,4] and verify sum is still 0+1+2+3+4 = 10
    let v = vec_new();
    vec_push(v, 0);
    vec_push(v, 1);
    vec_push(v, 2);
    vec_push(v, 3);
    vec_push(v, 4);
    let _s = shuffle_array(v, 5, 12345);
    let sum = vec_get(v, 0) + vec_get(v, 1) + vec_get(v, 2) + vec_get(v, 3) + vec_get(v, 4);
    let _f = vec_free(v);
    if sum == 10 { 1 } else { 0 }
};

fn test_shuffle_changes_order() -> i64 = {
    // Shuffle [1..10] and verify all 10 elements present by checking sum = 55
    let v = vec_new();
    let mut i = 1;
    while i <= 10 {
        vec_push(v, i);
        i = i + 1;
        0
    };
    let _s = shuffle_array(v, 10, 777);
    let mut sum = 0;
    let mut j = 0;
    while j < 10 {
        sum = sum + vec_get(v, j);
        j = j + 1;
        0
    };
    let _f = vec_free(v);
    if sum == 55 { 1 } else { 0 }
};

fn test_shuffle_deterministic() -> i64 = {
    // Same seed on same data gives same result
    let v1 = vec_new();
    let v2 = vec_new();
    let mut i = 0;
    while i < 5 {
        vec_push(v1, i);
        vec_push(v2, i);
        i = i + 1;
        0
    };
    let _s1 = shuffle_array(v1, 5, 42);
    let _s2 = shuffle_array(v2, 5, 42);
    let ok = vec_get(v1, 0) == vec_get(v2, 0)
         and vec_get(v1, 1) == vec_get(v2, 1)
         and vec_get(v1, 2) == vec_get(v2, 2)
         and vec_get(v1, 3) == vec_get(v2, 3)
         and vec_get(v1, 4) == vec_get(v2, 4);
    let _f1 = vec_free(v1);
    let _f2 = vec_free(v2);
    if ok { 1 } else { 0 }
};

fn test_sample_count() -> i64 = {
    let v = vec_new();
    let mut i = 0;
    while i < 10 {
        vec_push(v, i);
        i = i + 1;
        0
    };
    let s = shuffle_sample(v, 10, 3, 99);
    let ok = vec_len(s) == 3;
    let _f1 = vec_free(v);
    let _f2 = vec_free(s);
    if ok { 1 } else { 0 }
};

fn test_sample_all() -> i64 = {
    // k >= len returns len elements
    let v = vec_new();
    let mut i = 0;
    while i < 5 {
        vec_push(v, i * 10);
        i = i + 1;
        0
    };
    let s = shuffle_sample(v, 5, 100, 7);
    let sum = vec_get(s, 0) + vec_get(s, 1) + vec_get(s, 2) + vec_get(s, 3) + vec_get(s, 4);
    let ok = vec_len(s) == 5 and sum == 100;
    let _f1 = vec_free(v);
    let _f2 = vec_free(s);
    if ok { 1 } else { 0 }
};

fn test_sample_zero() -> i64 = {
    let v = vec_new();
    vec_push(v, 1);
    vec_push(v, 2);
    let s = shuffle_sample(v, 2, 0, 1);
    let ok = vec_len(s) == 0;
    let _f1 = vec_free(v);
    let _f2 = vec_free(s);
    if ok { 1 } else { 0 }
};

fn test_is_sorted_empty() -> i64 = {
    let v = vec_new();
    let ok = b2i(is_sorted(v, 0));
    let _f = vec_free(v);
    ok
};

fn test_is_sorted_true() -> i64 = {
    let v = vec_new();
    vec_push(v, 1);
    vec_push(v, 3);
    vec_push(v, 5);
    vec_push(v, 7);
    let ok = b2i(is_sorted(v, 4));
    let _f = vec_free(v);
    ok
};

fn test_is_sorted_false() -> i64 = {
    let v = vec_new();
    vec_push(v, 1);
    vec_push(v, 5);
    vec_push(v, 3);
    let ok = b2i(not is_sorted(v, 3));
    let _f = vec_free(v);
    ok
};

fn test_is_sorted_equal() -> i64 = {
    let v = vec_new();
    vec_push(v, 4);
    vec_push(v, 4);
    vec_push(v, 4);
    let ok = b2i(is_sorted(v, 3));
    let _f = vec_free(v);
    ok
};

fn main() -> i64 = {
    let t1  = report("seed_nonzero",          test_seed_nonzero());
    let t2  = report("seed_deterministic",     test_seed_deterministic());
    let t3  = report("next_advances",          test_next_advances());
    let t4  = report("lcg_range_bounds",       test_lcg_range_bounds());
    let t5  = report("swap_elems",             test_swap_elems());
    let t6  = report("shuffle_empty",          test_shuffle_empty());
    let t7  = report("shuffle_single",         test_shuffle_single());
    let t8  = report("shuffle_preserves",      test_shuffle_preserves_elements());
    let t9  = report("shuffle_changes",        test_shuffle_changes_order());
    let t10 = report("shuffle_deterministic",  test_shuffle_deterministic());
    let t11 = report("sample_count",           test_sample_count());
    let t12 = report("sample_all",             test_sample_all());
    let t13 = report("sample_zero",            test_sample_zero());
    let t14 = report("is_sorted_empty",        test_is_sorted_empty());
    let t15 = report("is_sorted_true",         test_is_sorted_true());
    let t16 = report("is_sorted_false",        test_is_sorted_false());
    let t17 = report("is_sorted_equal",        test_is_sorted_equal());

    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10
               + t11 + t12 + t13 + t14 + t15 + t16 + t17;
    let total = 17;

    let _p1 = print_str("bmb-shuffle: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");

    if passed == total { 0 } else { 1 }
};
