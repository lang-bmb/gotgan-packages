// bmb-permutation: Permutation and combination utilities
// Provides factorial, nPr, nCr, and next permutation on vectors

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Factorial: n!
fn factorial(n: i64) -> i64
  pre n >= 0
  post ret >= 1
= {
    let mut acc = 1;
    let mut i = 2;
    while i <= n {
        acc = acc * i;
        i = i + 1;
        0
    };
    acc
};

// Permutation: nPr = n! / (n-r)!
fn npr(n: i64, r: i64) -> i64
  pre n >= 0 and r >= 0 and r <= n
  post ret >= 1
= {
    let mut acc = 1;
    let mut i = 0;
    while i < r {
        acc = acc * (n - i);
        i = i + 1;
        0
    };
    acc
};

// Combination: nCr = n! / (r! * (n-r)!)
// Uses multiplicative formula to avoid overflow
fn ncr(n: i64, r: i64) -> i64
  pre n >= 0 and r >= 0 and r <= n
  post ret >= 1
= {
    let k = if r > n - r { n - r } else { r };
    let mut acc = 1;
    let mut i = 0;
    while i < k {
        acc = acc * (n - i);
        acc = acc / (i + 1);
        i = i + 1;
        0
    };
    acc
};

// Swap two elements in a vec
fn perm_swap(v: i64, i: i64, j: i64) -> i64 = {
    let a = vec_get(v, i);
    let b = vec_get(v, j);
    let _s1 = vec_set(v, i, b);
    let _s2 = vec_set(v, j, a);
    0
};

// Reverse a portion of a vec from index lo to hi (inclusive)
fn perm_reverse(v: i64, lo: i64, hi: i64) -> i64 = {
    let mut left = lo;
    let mut right = hi;
    while left < right {
        let _sw = perm_swap(v, left, right);
        left = left + 1;
        right = right - 1;
        0
    };
    0
};

// Next lexicographic permutation (in-place)
// Returns 1 if next permutation exists, 0 if already the last permutation
fn next_permutation(v: i64) -> i64
  pre v != 0
= {
    let len = vec_len(v);
    if len <= 1 { 0 }
    else {
        // Step 1: Find largest i such that v[i] < v[i+1]
        let mut i = len - 2;
        let mut found_i = false;
        let mut done1 = false;
        while not done1 {
            if vec_get(v, i) < vec_get(v, i + 1) {
                found_i = true;
                done1 = true;
                0
            } else if i == 0 {
                done1 = true;
                0
            } else {
                i = i - 1;
                0
            }
        };
        if not found_i {
            // Already last permutation, reverse to first
            let _rv = perm_reverse(v, 0, len - 1);
            0
        } else {
            // Step 2: Find largest j such that v[i] < v[j]
            let mut j = len - 1;
            while vec_get(v, j) <= vec_get(v, i) {
                j = j - 1;
                0
            };
            // Step 3: Swap v[i] and v[j]
            let _sw = perm_swap(v, i, j);
            // Step 4: Reverse from i+1 to end
            let _rv = perm_reverse(v, i + 1, len - 1);
            1
        }
    }
};

// Check if vec is sorted in ascending order
fn is_sorted(v: i64) -> bool
  pre v != 0
= {
    let len = vec_len(v);
    let mut i = 0;
    let mut sorted = true;
    while i < len - 1 {
        if vec_get(v, i) > vec_get(v, i + 1) {
            sorted = false;
            0
        } else { 0 };
        i = i + 1;
        0
    };
    sorted
};

// Count total permutations of n elements = n!
fn count_permutations(n: i64) -> i64
  pre n >= 0
= factorial(n);

// Derangement count: D(n) = (n-1) * (D(n-1) + D(n-2))
// Number of permutations with no fixed points
fn derangements(n: i64) -> i64
  pre n >= 0
= {
    if n == 0 { 1 }
    else if n == 1 { 0 }
    else {
        let mut prev2 = 1;
        let mut prev1 = 0;
        let mut i = 2;
        let mut current = 0;
        while i <= n {
            current = (i - 1) * (prev1 + prev2);
            prev2 = prev1;
            prev1 = current;
            i = i + 1;
            0
        };
        current
    }
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_factorial() -> i64 =
    if factorial(0) != 1 { 0 }
    else if factorial(1) != 1 { 0 }
    else if factorial(5) != 120 { 0 }
    else if factorial(10) != 3628800 { 0 }
    else { 1 };

fn test_npr() -> i64 =
    if npr(5, 2) != 20 { 0 }
    else if npr(5, 5) != 120 { 0 }
    else if npr(10, 3) != 720 { 0 }
    else if npr(5, 0) != 1 { 0 }
    else { 1 };

fn test_ncr() -> i64 =
    if ncr(5, 2) != 10 { 0 }
    else if ncr(10, 3) != 120 { 0 }
    else if ncr(5, 0) != 1 { 0 }
    else if ncr(5, 5) != 1 { 0 }
    else if ncr(20, 10) != 184756 { 0 }
    else { 1 };

fn test_next_permutation() -> i64 = {
    // Start with [1, 2, 3]
    let v = vec_new();
    let _p1 = vec_push(v, 1);
    let _p2 = vec_push(v, 2);
    let _p3 = vec_push(v, 3);
    // next_permutation -> [1, 3, 2]
    let r1 = next_permutation(v);
    if r1 != 1 { let _f = vec_free(v); 0 }
    else if vec_get(v, 0) != 1 { let _f = vec_free(v); 0 }
    else if vec_get(v, 1) != 3 { let _f = vec_free(v); 0 }
    else if vec_get(v, 2) != 2 { let _f = vec_free(v); 0 }
    else {
        // next_permutation -> [2, 1, 3]
        let r2 = next_permutation(v);
        if r2 != 1 { let _f = vec_free(v); 0 }
        else if vec_get(v, 0) != 2 { let _f = vec_free(v); 0 }
        else if vec_get(v, 1) != 1 { let _f = vec_free(v); 0 }
        else if vec_get(v, 2) != 3 { let _f = vec_free(v); 0 }
        else { let _f = vec_free(v); 1 }
    }
};

fn test_next_perm_last() -> i64 = {
    // Start with [3, 2, 1] (last permutation)
    let v = vec_new();
    let _p1 = vec_push(v, 3);
    let _p2 = vec_push(v, 2);
    let _p3 = vec_push(v, 1);
    let r = next_permutation(v);
    // Returns 0 and wraps to [1, 2, 3]
    if r != 0 { let _f = vec_free(v); 0 }
    else if vec_get(v, 0) != 1 { let _f = vec_free(v); 0 }
    else if vec_get(v, 1) != 2 { let _f = vec_free(v); 0 }
    else if vec_get(v, 2) != 3 { let _f = vec_free(v); 0 }
    else { let _f = vec_free(v); 1 }
};

fn test_is_sorted() -> i64 = {
    let v1 = vec_new();
    let _p1 = vec_push(v1, 1);
    let _p2 = vec_push(v1, 2);
    let _p3 = vec_push(v1, 3);
    let r1 = b2i(is_sorted(v1));
    let _f1 = vec_free(v1);
    let v2 = vec_new();
    let _p4 = vec_push(v2, 3);
    let _p5 = vec_push(v2, 1);
    let _p6 = vec_push(v2, 2);
    let r2 = b2i(is_sorted(v2));
    let _f2 = vec_free(v2);
    if r1 != 1 { 0 }
    else if r2 != 0 { 0 }
    else { 1 }
};

fn test_derangements() -> i64 =
    if derangements(0) != 1 { 0 }
    else if derangements(1) != 0 { 0 }
    else if derangements(2) != 1 { 0 }
    else if derangements(3) != 2 { 0 }
    else if derangements(4) != 9 { 0 }
    else if derangements(5) != 44 { 0 }
    else { 1 };

fn test_perm_count_all() -> i64 = {
    // Generate all 6 permutations of [1,2,3] by calling next_permutation
    let v = vec_new();
    let _p1 = vec_push(v, 1);
    let _p2 = vec_push(v, 2);
    let _p3 = vec_push(v, 3);
    let mut count = 1;
    let mut done = false;
    while not done {
        let r = next_permutation(v);
        if r == 0 { done = true; 0 }
        else { count = count + 1; 0 }
    };
    let _f = vec_free(v);
    if count == 6 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("factorial", test_factorial());
    let t2 = report("npr", test_npr());
    let t3 = report("ncr", test_ncr());
    let t4 = report("next_permutation", test_next_permutation());
    let t5 = report("next_perm_last", test_next_perm_last());
    let t6 = report("is_sorted", test_is_sorted());
    let t7 = report("derangements", test_derangements());
    let t8 = report("perm_count_all", test_perm_count_all());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-permutation: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
