// bmb-histogram: Histogram / frequency distribution
//
// Memory layout (one contiguous malloc):
//   [min_val, max_val, num_bins, total_count, bin_0, bin_1, ..., bin_{n-1}]
//   Each field is one i64 (8 bytes).
//   Header = 4 words (32 bytes).  Bin array starts at offset 32.
//
// Values are mapped to bins using:
//   bin = (value - min_val) * num_bins / (max_val - min_val + 1)
// Values outside [min_val, max_val] are silently ignored.

// ============================================================
// Internal layout helpers
// ============================================================

fn hist_hdr_min(h: i64) -> i64 = load_i64(h);
fn hist_hdr_max(h: i64) -> i64 = load_i64(h + 8);
fn hist_hdr_bins(h: i64) -> i64 = load_i64(h + 16);
fn hist_hdr_total(h: i64) -> i64 = load_i64(h + 24);

fn hist_set_total(h: i64, v: i64) -> i64 = store_i64(h + 24, v);

fn hist_bin_addr(h: i64, bin_idx: i64) -> i64 = h + 32 + bin_idx * 8;

fn hist_bin_val(h: i64, bin_idx: i64) -> i64 = load_i64(hist_bin_addr(h, bin_idx));

fn hist_bin_set(h: i64, bin_idx: i64, v: i64) -> i64 = store_i64(hist_bin_addr(h, bin_idx), v);

// ============================================================
// Public API
// ============================================================

// hist_new: allocate a histogram covering [min_val, max_val] with num_bins bins.
// All bin counts are initialised to 0.
// pre: num_bins >= 1, max_val >= min_val
fn hist_new(min_val: i64, max_val: i64, num_bins: i64) -> i64
  pre num_bins >= 1 and max_val >= min_val
  post ret != 0
= {
    let bytes = 32 + num_bins * 8;
    let h = malloc(bytes);
    // Zero the entire allocation
    let mut i = 0;
    while i < bytes {
        let _s = store_i64(h + i, 0);
        i = i + 8;
        0
    };
    let _s1 = store_i64(h, min_val);
    let _s2 = store_i64(h + 8, max_val);
    let _s3 = store_i64(h + 16, num_bins);
    h
};

// hist_add: record one occurrence of value.
// Values outside [min_val, max_val] are ignored.
fn hist_add(h: i64, value: i64) -> i64
  pre h != 0
= {
    let mn = hist_hdr_min(h);
    let mx = hist_hdr_max(h);
    let nb = hist_hdr_bins(h);
    if value < mn or value > mx { 0 }
    else {
        // Map value to bin index
        let range = mx - mn + 1;
        let bin = (value - mn) * nb / range;
        // Clamp to [0, nb-1] for safety
        let safe_bin = if bin >= nb { nb - 1 } else { bin };
        let old = hist_bin_val(h, safe_bin);
        let _sb = hist_bin_set(h, safe_bin, old + 1);
        let _st = hist_set_total(h, hist_hdr_total(h) + 1);
        0
    }
};

// hist_get_bin: count in bin bin_idx (0-based).
// Returns 0 if out of range.
fn hist_get_bin(h: i64, bin_idx: i64) -> i64
  pre h != 0
= {
    let nb = hist_hdr_bins(h);
    if bin_idx < 0 or bin_idx >= nb { 0 }
    else { hist_bin_val(h, bin_idx) }
};

// hist_total: total number of values added.
fn hist_total(h: i64) -> i64
  pre h != 0
  post ret >= 0
= hist_hdr_total(h);

// hist_max_bin: index of the bin with the highest count.
// In case of ties, returns the smallest index.
// Returns 0 when num_bins == 0 (should not happen per precondition).
fn hist_max_bin(h: i64) -> i64
  pre h != 0
  post ret >= 0
= {
    let nb = hist_hdr_bins(h);
    let mut best_idx = 0;
    let mut best_val = hist_bin_val(h, 0);
    let mut i = 1;
    while i < nb {
        let v = hist_bin_val(h, i);
        let _r = if v > best_val {
            best_val = v;
            best_idx = i;
            0
        } else { 0 };
        i = i + 1;
        0
    };
    best_idx
};

// hist_clear: reset all bin counts and total to 0.
fn hist_clear(h: i64) -> i64
  pre h != 0
= {
    let nb = hist_hdr_bins(h);
    let mut i = 0;
    while i < nb {
        let _s = hist_bin_set(h, i, 0);
        i = i + 1;
        0
    };
    hist_set_total(h, 0)
};

// hist_free: release histogram memory.
fn hist_free(h: i64) -> i64
  pre h != 0
= { let _f = free(h); 0 };

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_basic() -> i64 = {
    // [0, 9], 10 bins  => each value maps to its own bin
    let h = hist_new(0, 9, 10);
    let _a1 = hist_add(h, 0);
    let _a2 = hist_add(h, 0);
    let _a3 = hist_add(h, 5);
    let _a4 = hist_add(h, 9);
    let ok = hist_get_bin(h, 0) == 2
             and hist_get_bin(h, 5) == 1
             and hist_get_bin(h, 9) == 1
             and hist_total(h) == 4;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_ignore_out_of_range() -> i64 = {
    let h = hist_new(0, 9, 10);
    let _a1 = hist_add(h, 10);
    let _a2 = hist_add(h, 0 - 1);
    let _a3 = hist_add(h, 100);
    let ok = hist_total(h) == 0;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_max_bin() -> i64 = {
    // 5 bins over [0, 9] (each bin spans 2 values)
    let h = hist_new(0, 9, 5);
    let _a1 = hist_add(h, 6);
    let _a2 = hist_add(h, 7);
    let _a3 = hist_add(h, 6);
    // values 6,7 -> bin index = (6-0)*5/10 = 3
    let mb = hist_max_bin(h);
    let ok = mb == 3;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_clear() -> i64 = {
    let h = hist_new(0, 9, 10);
    let _a1 = hist_add(h, 1);
    let _a2 = hist_add(h, 2);
    let _c = hist_clear(h);
    let ok = hist_total(h) == 0
             and hist_get_bin(h, 1) == 0
             and hist_get_bin(h, 2) == 0;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_single_bin() -> i64 = {
    let h = hist_new(5, 5, 1);
    let _a1 = hist_add(h, 5);
    let _a2 = hist_add(h, 5);
    let ok = hist_get_bin(h, 0) == 2
             and hist_total(h) == 2
             and hist_max_bin(h) == 0;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_uniform_distribution() -> i64 = {
    // 4 bins over [0, 7], add one value per pair
    let h = hist_new(0, 7, 4);
    let _a0 = hist_add(h, 0);
    let _a1 = hist_add(h, 2);
    let _a2 = hist_add(h, 4);
    let _a3 = hist_add(h, 6);
    let ok = hist_total(h) == 4
             and hist_get_bin(h, 0) == 1
             and hist_get_bin(h, 1) == 1
             and hist_get_bin(h, 2) == 1
             and hist_get_bin(h, 3) == 1;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn test_get_bin_out_of_range() -> i64 = {
    let h = hist_new(0, 9, 5);
    let ok = hist_get_bin(h, 0 - 1) == 0 and hist_get_bin(h, 100) == 0;
    let _f = hist_free(h);
    if ok { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("basic", test_basic());
    let t2 = report("ignore_out_of_range", test_ignore_out_of_range());
    let t3 = report("max_bin", test_max_bin());
    let t4 = report("clear", test_clear());
    let t5 = report("single_bin", test_single_bin());
    let t6 = report("uniform_distribution", test_uniform_distribution());
    let t7 = report("get_bin_out_of_range", test_get_bin_out_of_range());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7;
    let total = 7;
    let _p1 = print_str("bmb-histogram: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
