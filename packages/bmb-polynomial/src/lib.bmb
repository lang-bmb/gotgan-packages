// bmb-polynomial: Polynomial operations and evaluation
// Polynomials stored as vecs of i64 coefficients: [a0, a1, a2, ...] = a0 + a1*x + a2*x^2 + ...

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Create a new empty polynomial
fn poly_new() -> i64
  post ret != 0
= vec_new();

// Free polynomial memory
fn poly_free(p: i64) -> i64
  pre p != 0
= { let _f = vec_free(p); 0 };

// Get degree of polynomial (highest non-zero coefficient index)
fn poly_degree(p: i64) -> i64
  pre p != 0
= {
    let len = vec_len(p);
    if len == 0 { 0 }
    else {
        let mut deg = len - 1;
        let mut done = false;
        while not done {
            if deg == 0 { done = true; 0 }
            else if vec_get(p, deg) != 0 { done = true; 0 }
            else { deg = deg - 1; 0 }
        };
        deg
    }
};

// Use Horner's method to compute p(x)
// p(x) = a0 + a1*x + a2*x^2 + ... computed as (...((an*x + an-1)*x + an-2)*x + ... + a0)
fn poly_compute(p: i64, x: i64) -> i64
  pre p != 0
= {
    let len = vec_len(p);
    if len == 0 { 0 }
    else {
        let mut result = vec_get(p, len - 1);
        let mut i = len - 2;
        let mut done = false;
        if len == 1 { done = true; 0 } else { 0 };
        while not done {
            result = result * x + vec_get(p, i);
            if i == 0 { done = true; 0 }
            else { i = i - 1; 0 }
        };
        result
    }
};

// Add two polynomials: result = a + b (returns new vec)
fn poly_add(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
  post ret != 0
= {
    let la = vec_len(a);
    let lb = vec_len(b);
    let max_len = if la > lb { la } else { lb };
    let result = vec_new();
    let mut i = 0;
    while i < max_len {
        let ca = if i < la { vec_get(a, i) } else { 0 };
        let cb = if i < lb { vec_get(b, i) } else { 0 };
        let _p = vec_push(result, ca + cb);
        i = i + 1;
        0
    };
    result
};

// Subtract two polynomials: result = a - b (returns new vec)
fn poly_sub(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
  post ret != 0
= {
    let la = vec_len(a);
    let lb = vec_len(b);
    let max_len = if la > lb { la } else { lb };
    let result = vec_new();
    let mut i = 0;
    while i < max_len {
        let ca = if i < la { vec_get(a, i) } else { 0 };
        let cb = if i < lb { vec_get(b, i) } else { 0 };
        let _p = vec_push(result, ca - cb);
        i = i + 1;
        0
    };
    result
};

// Multiply two polynomials: result = a * b (returns new vec)
fn poly_mul(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
  post ret != 0
= {
    let la = vec_len(a);
    let lb = vec_len(b);
    if la == 0 { vec_new() }
    else if lb == 0 { vec_new() }
    else {
        let rlen = la + lb - 1;
        let result = vec_new();
        // Initialize result with zeros
        let mut k = 0;
        while k < rlen {
            let _p = vec_push(result, 0);
            k = k + 1;
            0
        };
        // Convolution
        let mut i = 0;
        while i < la {
            let mut j = 0;
            while j < lb {
                let idx = i + j;
                let cur = vec_get(result, idx);
                let _s = vec_set(result, idx, cur + vec_get(a, i) * vec_get(b, j));
                j = j + 1;
                0
            };
            i = i + 1;
            0
        };
        result
    }
};

// Scale polynomial by a constant: result = c * p (returns new vec)
fn poly_scale(p: i64, c: i64) -> i64
  pre p != 0
  post ret != 0
= {
    let len = vec_len(p);
    let result = vec_new();
    let mut i = 0;
    while i < len {
        let _pp = vec_push(result, vec_get(p, i) * c);
        i = i + 1;
        0
    };
    result
};

// Differentiate polynomial: p'(x) = a1 + 2*a2*x + 3*a3*x^2 + ...
fn poly_derivative(p: i64) -> i64
  pre p != 0
  post ret != 0
= {
    let len = vec_len(p);
    let result = vec_new();
    if len <= 1 {
        let _pp = vec_push(result, 0);
        result
    } else {
        let mut i = 1;
        while i < len {
            let _pp = vec_push(result, i * vec_get(p, i));
            i = i + 1;
            0
        };
        result
    }
};

// Check if two polynomials are equal
fn poly_eq(a: i64, b: i64) -> bool
  pre a != 0 and b != 0
= {
    let la = vec_len(a);
    let lb = vec_len(b);
    let max_len = if la > lb { la } else { lb };
    let mut eq = true;
    let mut i = 0;
    while i < max_len {
        let ca = if i < la { vec_get(a, i) } else { 0 };
        let cb = if i < lb { vec_get(b, i) } else { 0 };
        if ca != cb { eq = false; 0 } else { 0 };
        i = i + 1;
        0
    };
    eq
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_compute() -> i64 = {
    // p(x) = 1 + 2x + 3x^2
    let p = poly_new();
    let _a = vec_push(p, 1);
    let _b = vec_push(p, 2);
    let _c = vec_push(p, 3);
    // p(0) = 1, p(1) = 6, p(2) = 17, p(-1) = 2
    let r0 = poly_compute(p, 0);
    let r1 = poly_compute(p, 1);
    let r2 = poly_compute(p, 2);
    let rn = poly_compute(p, 0 - 1);
    let _f = poly_free(p);
    if r0 != 1 { 0 }
    else if r1 != 6 { 0 }
    else if r2 != 17 { 0 }
    else if rn != 2 { 0 }
    else { 1 }
};

fn test_degree() -> i64 = {
    // p(x) = 5 + 0x + 3x^2
    let p = poly_new();
    let _a = vec_push(p, 5);
    let _b = vec_push(p, 0);
    let _c = vec_push(p, 3);
    let d = poly_degree(p);
    let _f = poly_free(p);
    // q(x) = 7 (constant)
    let q = poly_new();
    let _d = vec_push(q, 7);
    let dq = poly_degree(q);
    let _fq = poly_free(q);
    if d != 2 { 0 }
    else if dq != 0 { 0 }
    else { 1 }
};

fn test_add() -> i64 = {
    // a = 1 + 2x, b = 3 + 4x + 5x^2
    let a = poly_new();
    let _a1 = vec_push(a, 1);
    let _a2 = vec_push(a, 2);
    let b = poly_new();
    let _b1 = vec_push(b, 3);
    let _b2 = vec_push(b, 4);
    let _b3 = vec_push(b, 5);
    let r = poly_add(a, b);
    // result = 4 + 6x + 5x^2
    let ok = if vec_get(r, 0) != 4 { 0 }
        else if vec_get(r, 1) != 6 { 0 }
        else if vec_get(r, 2) != 5 { 0 }
        else { 1 };
    let _fa = poly_free(a);
    let _fb = poly_free(b);
    let _fr = poly_free(r);
    ok
};

fn test_sub() -> i64 = {
    // a = 5 + 3x + 2x^2, b = 1 + 1x + 1x^2
    let a = poly_new();
    let _a1 = vec_push(a, 5);
    let _a2 = vec_push(a, 3);
    let _a3 = vec_push(a, 2);
    let b = poly_new();
    let _b1 = vec_push(b, 1);
    let _b2 = vec_push(b, 1);
    let _b3 = vec_push(b, 1);
    let r = poly_sub(a, b);
    // result = 4 + 2x + 1x^2
    let ok = if vec_get(r, 0) != 4 { 0 }
        else if vec_get(r, 1) != 2 { 0 }
        else if vec_get(r, 2) != 1 { 0 }
        else { 1 };
    let _fa = poly_free(a);
    let _fb = poly_free(b);
    let _fr = poly_free(r);
    ok
};

fn test_mul() -> i64 = {
    // a = 1 + 1x, b = 1 + 1x  => (1+x)^2 = 1 + 2x + x^2
    let a = poly_new();
    let _a1 = vec_push(a, 1);
    let _a2 = vec_push(a, 1);
    let b = poly_new();
    let _b1 = vec_push(b, 1);
    let _b2 = vec_push(b, 1);
    let r = poly_mul(a, b);
    let ok = if vec_len(r) != 3 { 0 }
        else if vec_get(r, 0) != 1 { 0 }
        else if vec_get(r, 1) != 2 { 0 }
        else if vec_get(r, 2) != 1 { 0 }
        else { 1 };
    let _fa = poly_free(a);
    let _fb = poly_free(b);
    let _fr = poly_free(r);
    ok
};

fn test_scale() -> i64 = {
    // p = 1 + 2x + 3x^2, scale by 3 => 3 + 6x + 9x^2
    let p = poly_new();
    let _a = vec_push(p, 1);
    let _b = vec_push(p, 2);
    let _c = vec_push(p, 3);
    let r = poly_scale(p, 3);
    let ok = if vec_get(r, 0) != 3 { 0 }
        else if vec_get(r, 1) != 6 { 0 }
        else if vec_get(r, 2) != 9 { 0 }
        else { 1 };
    let _fp = poly_free(p);
    let _fr = poly_free(r);
    ok
};

fn test_derivative() -> i64 = {
    // p = 3 + 2x + 5x^2 + x^3 => p' = 2 + 10x + 3x^2
    let p = poly_new();
    let _a = vec_push(p, 3);
    let _b = vec_push(p, 2);
    let _c = vec_push(p, 5);
    let _d = vec_push(p, 1);
    let dp = poly_derivative(p);
    let ok = if vec_get(dp, 0) != 2 { 0 }
        else if vec_get(dp, 1) != 10 { 0 }
        else if vec_get(dp, 2) != 3 { 0 }
        else { 1 };
    let _fp = poly_free(p);
    let _fd = poly_free(dp);
    ok
};

fn test_poly_eq() -> i64 = {
    let a = poly_new();
    let _a1 = vec_push(a, 1);
    let _a2 = vec_push(a, 2);
    let b = poly_new();
    let _b1 = vec_push(b, 1);
    let _b2 = vec_push(b, 2);
    let c = poly_new();
    let _c1 = vec_push(c, 1);
    let _c2 = vec_push(c, 3);
    let eq1 = b2i(poly_eq(a, b));
    let eq2 = b2i(poly_eq(a, c));
    let _fa = poly_free(a);
    let _fb = poly_free(b);
    let _fc = poly_free(c);
    if eq1 != 1 { 0 }
    else if eq2 != 0 { 0 }
    else { 1 }
};

fn main() -> i64 = {
    let t1 = report("compute", test_compute());
    let t2 = report("degree", test_degree());
    let t3 = report("add", test_add());
    let t4 = report("sub", test_sub());
    let t5 = report("mul", test_mul());
    let t6 = report("scale", test_scale());
    let t7 = report("derivative", test_derivative());
    let t8 = report("poly_eq", test_poly_eq());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-polynomial: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
