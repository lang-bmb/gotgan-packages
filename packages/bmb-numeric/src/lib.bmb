// bmb-numeric: Numeric algorithms for BMB
// v0.1.0
//
// Functions:
//   mod_pow        - Modular exponentiation: base^exp mod modulus
//   is_prime       - Primality test (trial division)
//   nth_prime      - n-th prime number (1-indexed)
//   euler_totient  - Euler's totient function phi(n)
//   extended_gcd   - Extended Euclidean algorithm; returns vec [gcd, x, y]

// ============================================================================
// mod_pow: modular exponentiation by squaring
// Returns base^exp mod modulus. Handles exp=0 correctly.
// ============================================================================

fn mod_pow(base: i64, exp: i64, modulus: i64) -> i64
  pre modulus > 0 and exp >= 0
  post ret >= 0
= {
    let mut result = 1;
    let mut b = base % modulus;
    let mut e = exp;
    while e > 0 {
        let _r = if e % 2 == 1 {
            { result = result * b % modulus; 0 }
        } else { 0 };
        e = e / 2;
        b = b * b % modulus;
        0
    };
    result
};

// ============================================================================
// is_prime: trial division primality test
// Returns true for primes, false otherwise.
// ============================================================================

fn is_prime(n: i64) -> bool
  pre n >= 0
= if n < 2 { false }
  else if n == 2 { true }
  else if n % 2 == 0 { false }
  else {
      {
          let mut d = 3;
          let mut prime = true;
          let mut done = false;
          while not done {
              let _r = if d * d > n {
                  { done = true; 0 }
              } else if n % d == 0 {
                  { prime = false; done = true; 0 }
              } else {
                  { d = d + 2; 0 }
              };
              0
          };
          prime
      }
  };

// ============================================================================
// nth_prime: returns the n-th prime number (1-indexed, so nth_prime(1) = 2)
// ============================================================================

fn nth_prime(n: i64) -> i64
  pre n >= 1
  post ret >= 2
= {
    let mut count = 0;
    let mut candidate = 1;
    let mut found = 0;
    let mut done = false;
    while not done {
        candidate = candidate + 1;
        let _c = if is_prime(candidate) {
            {
                count = count + 1;
                let _m = if count == n {
                    { found = candidate; done = true; 0 }
                } else { 0 };
                0
            }
        } else { 0 };
        0
    };
    found
};

// ============================================================================
// euler_totient: Euler's totient function phi(n)
// Returns the count of integers in [1,n] that are coprime to n.
// Uses the formula: phi(n) = n * product over prime p|n of (1 - 1/p)
// Implemented via integer arithmetic: for each prime p dividing n,
// result = result / p * (p - 1)
// ============================================================================

fn euler_totient(n: i64) -> i64
  pre n >= 1
  post ret >= 1
= {
    let mut result = n;
    let mut p = 2;
    let mut m = n;
    while p * p <= m {
        let _c = if m % p == 0 {
            {
                // remove all factors of p from m
                while m % p == 0 {
                    m = m / p;
                    0
                };
                // apply (1 - 1/p) = multiply by (p-1) then divide by p
                result = result / p * (p - 1);
                0
            }
        } else { 0 };
        p = p + 1;
        0
    };
    // if m > 1, m is a remaining prime factor
    let _r = if m > 1 {
        { result = result / m * (m - 1); 0 }
    } else { 0 };
    result
};

// ============================================================================
// extended_gcd: Extended Euclidean algorithm
// Returns a vec of 3 elements: [gcd, x, y] such that a*x + b*y = gcd(a,b)
// The caller is responsible for freeing the returned vec.
// ============================================================================

fn extended_gcd(a: i64, b: i64) -> i64
  pre a >= 0 and b >= 0
= {
    // Iterative extended GCD
    let mut old_r = a;
    let mut r = b;
    let mut old_s = 1;
    let mut s = 0;
    let mut old_t = 0;
    let mut t = 1;
    while r != 0 {
        let q = old_r / r;
        let tmp_r = r;
        r = old_r - q * r;
        old_r = tmp_r;
        let tmp_s = s;
        s = old_s - q * s;
        old_s = tmp_s;
        let tmp_t = t;
        t = old_t - q * t;
        old_t = tmp_t;
        0
    };
    // old_r = gcd, old_s = x, old_t = y
    let out = vec_new();
    let _p0 = vec_push(out, old_r);
    let _p1 = vec_push(out, old_s);
    let _p2 = vec_push(out, old_t);
    out
};

// ============================================================================
// Tests
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_mod_pow() -> i64 = {
    // 2^10 mod 1000 = 1024 mod 1000 = 24
    let r1 = mod_pow(2, 10, 1000);
    // 3^0 mod 7 = 1
    let r2 = mod_pow(3, 0, 7);
    // 2^31 mod 1000000007
    let r3 = mod_pow(2, 31, 1000000007);
    // Fermat's little theorem: a^(p-1) mod p = 1 for prime p
    // 5^6 mod 7 = 1
    let r4 = mod_pow(5, 6, 7);
    if r1 == 24 and r2 == 1 and r3 == 147483634 and r4 == 1 { 1 } else { 0 }
};

fn test_is_prime() -> i64 = {
    let p2  = b2i(is_prime(2));
    let p3  = b2i(is_prime(3));
    let p4  = b2i(is_prime(4));
    let p17 = b2i(is_prime(17));
    let p97 = b2i(is_prime(97));
    let p0  = b2i(is_prime(0));
    let p1  = b2i(is_prime(1));
    if p2 == 1 and p3 == 1 and p4 == 0 and p17 == 1
       and p97 == 1 and p0 == 0 and p1 == 0 { 1 } else { 0 }
};

fn test_nth_prime() -> i64 = {
    // 1st=2, 2nd=3, 3rd=5, 4th=7, 5th=11, 10th=29, 25th=97
    let r1 = nth_prime(1);
    let r2 = nth_prime(2);
    let r3 = nth_prime(3);
    let r4 = nth_prime(4);
    let r5 = nth_prime(5);
    let r10 = nth_prime(10);
    let r25 = nth_prime(25);
    if r1 == 2 and r2 == 3 and r3 == 5 and r4 == 7 and r5 == 11
       and r10 == 29 and r25 == 97 { 1 } else { 0 }
};

fn test_euler_totient() -> i64 = {
    // phi(1)=1, phi(2)=1, phi(6)=2, phi(9)=6, phi(12)=4, phi(prime p)=p-1
    let r1 = euler_totient(1);
    let r2 = euler_totient(2);
    let r6 = euler_totient(6);
    let r9 = euler_totient(9);
    let r12 = euler_totient(12);
    let r7 = euler_totient(7);  // phi(7)=6 (7 is prime)
    if r1 == 1 and r2 == 1 and r6 == 2 and r9 == 6 and r12 == 4 and r7 == 6 { 1 } else { 0 }
};

fn test_extended_gcd() -> i64 = {
    // gcd(35,15)=5, 35*1 + 15*(-2)=5
    let v1 = extended_gcd(35, 15);
    let g1 = vec_get(v1, 0);
    let x1 = vec_get(v1, 1);
    let y1 = vec_get(v1, 2);
    // verify: 35*x + 15*y = gcd
    let check1 = 35 * x1 + 15 * y1 == g1;
    let _f1 = vec_free(v1);
    // gcd(3,0)=3, x=1,y=0
    let v2 = extended_gcd(3, 0);
    let g2 = vec_get(v2, 0);
    let x2 = vec_get(v2, 1);
    let check2 = g2 == 3 and 3 * x2 + 0 == g2;
    let _f2 = vec_free(v2);
    // gcd(12,8)=4
    let v3 = extended_gcd(12, 8);
    let g3 = vec_get(v3, 0);
    let x3 = vec_get(v3, 1);
    let y3 = vec_get(v3, 2);
    let check3 = g3 == 4 and 12 * x3 + 8 * y3 == g3;
    let _f3 = vec_free(v3);
    if b2i(check1) == 1 and b2i(check2) == 1 and b2i(check3) == 1 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("mod_pow",        test_mod_pow());
    let t2 = report("is_prime",       test_is_prime());
    let t3 = report("nth_prime",      test_nth_prime());
    let t4 = report("euler_totient",  test_euler_totient());
    let t5 = report("extended_gcd",   test_extended_gcd());
    let passed = t1 + t2 + t3 + t4 + t5;
    let total = 5;
    let _p1 = print_str("bmb-numeric: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
