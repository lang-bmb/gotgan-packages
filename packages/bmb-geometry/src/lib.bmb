// bmb-geometry: 2D integer geometry utilities for BMB
// v0.1.0
//
// All coordinates and results are i64 integers.
//
// Functions:
//   point_dist_sq     - Squared Euclidean distance between two points
//   cross_product     - 2D cross product of vectors (x1,y1) and (x2,y2)
//   is_clockwise      - True if triangle (p1,p2,p3) is clockwise ordered
//   triangle_area_2x  - Twice the signed area of a triangle (integer exact)
//   point_in_triangle - True if point P is inside or on triangle
//   manhattan_dist    - Manhattan (L1) distance between two points

// ============================================================================
// Helper: absolute value
// ============================================================================

@inline
fn geo_abs(x: i64) -> i64 = if x < 0 { 0 - x } else { x };

// ============================================================================
// point_dist_sq: squared Euclidean distance
// Returns (x2-x1)^2 + (y2-y1)^2
// ============================================================================

fn point_dist_sq(x1: i64, y1: i64, x2: i64, y2: i64) -> i64
  post ret >= 0
= {
    let dx = x2 - x1;
    let dy = y2 - y1;
    dx * dx + dy * dy
};

// ============================================================================
// cross_product: 2D cross product of two vectors
// cross((x1,y1), (x2,y2)) = x1*y2 - y1*x2
// Positive: (x2,y2) is counterclockwise from (x1,y1)
// Negative: clockwise
// Zero: collinear
// ============================================================================

fn cross_product(x1: i64, y1: i64, x2: i64, y2: i64) -> i64
= x1 * y2 - y1 * x2;

// ============================================================================
// is_clockwise: test if triangle (p1->p2->p3) is clockwise
// Uses the sign of the cross product of edges p1->p2 and p1->p3.
// Returns true if the turn from p1->p2 to p2->p3 is clockwise (right turn).
// ============================================================================

fn is_clockwise(x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> bool
= cross_product(x2 - x1, y2 - y1, x3 - x1, y3 - y1) < 0;

// ============================================================================
// triangle_area_2x: twice the signed area of triangle (p1, p2, p3)
// = (x2-x1)*(y3-y1) - (x3-x1)*(y2-y1)
// Positive if counterclockwise, negative if clockwise.
// Use geo_abs(triangle_area_2x(...)) for the unsigned 2x area.
// ============================================================================

fn triangle_area_2x(x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> i64
= cross_product(x2 - x1, y2 - y1, x3 - x1, y3 - y1);

// ============================================================================
// point_in_triangle: test if point (px,py) is inside triangle (p1,p2,p3)
// Uses the sign-of-cross-product method.
// Works for both clockwise and counterclockwise triangles.
// Returns true if the point is on the boundary or strictly inside.
// ============================================================================

fn sign_of(x: i64) -> i64 = if x > 0 { 1 } else if x < 0 { -1 } else { 0 };

fn point_in_triangle(px: i64, py: i64,
                     x1: i64, y1: i64,
                     x2: i64, y2: i64,
                     x3: i64, y3: i64) -> bool
= {
    let d1 = cross_product(x2 - x1, y2 - y1, px - x1, py - y1);
    let d2 = cross_product(x3 - x2, y3 - y2, px - x2, py - y2);
    let d3 = cross_product(x1 - x3, y1 - y3, px - x3, py - y3);
    let has_neg = (d1 < 0) or (d2 < 0) or (d3 < 0);
    let has_pos = (d1 > 0) or (d2 > 0) or (d3 > 0);
    not (has_neg and has_pos)
};

// ============================================================================
// manhattan_dist: |x2-x1| + |y2-y1|
// ============================================================================

fn manhattan_dist(x1: i64, y1: i64, x2: i64, y2: i64) -> i64
  post ret >= 0
= geo_abs(x2 - x1) + geo_abs(y2 - y1);

// ============================================================================
// Tests
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_point_dist_sq() -> i64 = {
    // (0,0) to (3,4) -> 25
    let r1 = point_dist_sq(0, 0, 3, 4);
    // same point -> 0
    let r2 = point_dist_sq(5, 5, 5, 5);
    // (1,1) to (4,5) -> 9+16=25
    let r3 = point_dist_sq(1, 1, 4, 5);
    if r1 == 25 and r2 == 0 and r3 == 25 { 1 } else { 0 }
};

fn test_cross_product() -> i64 = {
    // (1,0) x (0,1) = 1 (CCW)
    let r1 = cross_product(1, 0, 0, 1);
    // (0,1) x (1,0) = -1 (CW)
    let r2 = cross_product(0, 1, 1, 0);
    // (1,0) x (2,0) = 0 (collinear)
    let r3 = cross_product(1, 0, 2, 0);
    if r1 == 1 and r2 == 0 - 1 and r3 == 0 { 1 } else { 0 }
};

fn test_is_clockwise() -> i64 = {
    // CW triangle: (0,0),(1,0),(0,1) is CCW -> is_clockwise = false
    let ccw = b2i(is_clockwise(0, 0, 1, 0, 0, 1));
    // (0,0),(0,1),(1,0) is CW -> is_clockwise = true
    let cw = b2i(is_clockwise(0, 0, 0, 1, 1, 0));
    if ccw == 0 and cw == 1 { 1 } else { 0 }
};

fn test_triangle_area_2x() -> i64 = {
    // (0,0),(4,0),(0,3) -> area = 12/2 = 6, 2x = 12
    let r1 = geo_abs(triangle_area_2x(0, 0, 4, 0, 0, 3));
    // (0,0),(1,0),(0,1) -> 2x area = 1
    let r2 = geo_abs(triangle_area_2x(0, 0, 1, 0, 0, 1));
    if r1 == 12 and r2 == 1 { 1 } else { 0 }
};

fn test_point_in_triangle() -> i64 = {
    // Triangle (0,0),(4,0),(0,4)
    // Center (1,1) should be inside
    let inside = b2i(point_in_triangle(1, 1, 0, 0, 4, 0, 0, 4));
    // (3,3) should be outside (past hypotenuse)
    let outside = b2i(point_in_triangle(3, 3, 0, 0, 4, 0, 0, 4));
    // Vertex (0,0) is on the boundary -> inside
    let vertex = b2i(point_in_triangle(0, 0, 0, 0, 4, 0, 0, 4));
    if inside == 1 and outside == 0 and vertex == 1 { 1 } else { 0 }
};

fn test_manhattan_dist() -> i64 = {
    // (0,0) to (3,4) -> 7
    let r1 = manhattan_dist(0, 0, 3, 4);
    // same point -> 0
    let r2 = manhattan_dist(2, 2, 2, 2);
    // negative coords: (-1,-1) to (1,1) -> 4
    let r3 = manhattan_dist(0 - 1, 0 - 1, 1, 1);
    if r1 == 7 and r2 == 0 and r3 == 4 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("point_dist_sq",    test_point_dist_sq());
    let t2 = report("cross_product",    test_cross_product());
    let t3 = report("is_clockwise",     test_is_clockwise());
    let t4 = report("triangle_area_2x", test_triangle_area_2x());
    let t5 = report("point_in_triangle", test_point_in_triangle());
    let t6 = report("manhattan_dist",   test_manhattan_dist());
    let passed = t1 + t2 + t3 + t4 + t5 + t6;
    let total = 6;
    let _p1 = print_str("bmb-geometry: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
