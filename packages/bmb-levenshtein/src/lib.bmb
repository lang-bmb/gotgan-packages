// bmb-levenshtein: Levenshtein edit distance between two strings
// Uses dynamic programming with a flat vec as a 2D matrix.
// Operations: insert, delete, substitute (each cost 1).

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Return the minimum of two i64 values
fn min2(a: i64, b: i64) -> i64 = if a <= b { a } else { b };

// Return the minimum of three i64 values
fn min3(a: i64, b: i64, c: i64) -> i64 = min2(min2(a, b), c);

// Compute Levenshtein edit distance between two strings.
// Uses O(m*n) DP approach with flat vec indexing.
fn levenshtein(s: String, t: String) -> i64
  post ret >= 0
= {
    let m = s.len();
    let n = t.len();
    if m == 0 { n }
    else if n == 0 { m }
    else {
        // Allocate flat (m+1)*(n+1) matrix
        let cols = n + 1;
        let rows = m + 1;
        let dp = vec_new();
        // Fill with zeros
        let total = rows * cols;
        let mut k = 0;
        while k < total {
            let _p = vec_push(dp, 0);
            k = k + 1;
            0
        };
        // Initialize first row: dp[0][j] = j
        let mut j = 0;
        while j <= n {
            let _s = vec_set(dp, j, j);
            j = j + 1;
            0
        };
        // Initialize first column: dp[i][0] = i
        let mut i = 0;
        while i <= m {
            let _s = vec_set(dp, i * cols, i);
            i = i + 1;
            0
        };
        // Fill DP table
        i = 1;
        while i <= m {
            j = 1;
            while j <= n {
                let cost = if s.byte_at(i - 1) == t.byte_at(j - 1) { 0 } else { 1 };
                let del = vec_get(dp, (i - 1) * cols + j) + 1;
                let ins = vec_get(dp, i * cols + (j - 1)) + 1;
                let sub = vec_get(dp, (i - 1) * cols + (j - 1)) + cost;
                let _s = vec_set(dp, i * cols + j, min3(del, ins, sub));
                j = j + 1;
                0
            };
            i = i + 1;
            0
        };
        let result = vec_get(dp, m * cols + n);
        let _f = vec_free(dp);
        result
    }
};

// Compute Levenshtein distance between two vecs of i64 values.
// Useful when working with byte arrays instead of strings.
fn levenshtein_vec(a: i64, a_len: i64, b: i64, b_len: i64) -> i64
  pre a_len >= 0 and b_len >= 0
  post ret >= 0
= {
    if a_len == 0 { b_len }
    else if b_len == 0 { a_len }
    else {
        let cols = b_len + 1;
        let rows = a_len + 1;
        let dp = vec_new();
        let total = rows * cols;
        let mut k = 0;
        while k < total {
            let _p = vec_push(dp, 0);
            k = k + 1;
            0
        };
        let mut j = 0;
        while j <= b_len {
            let _s = vec_set(dp, j, j);
            j = j + 1;
            0
        };
        let mut i = 0;
        while i <= a_len {
            let _s = vec_set(dp, i * cols, i);
            i = i + 1;
            0
        };
        i = 1;
        while i <= a_len {
            j = 1;
            while j <= b_len {
                let cost = if vec_get(a, i - 1) == vec_get(b, j - 1) { 0 } else { 1 };
                let del = vec_get(dp, (i - 1) * cols + j) + 1;
                let ins = vec_get(dp, i * cols + (j - 1)) + 1;
                let sub = vec_get(dp, (i - 1) * cols + (j - 1)) + cost;
                let _s = vec_set(dp, i * cols + j, min3(del, ins, sub));
                j = j + 1;
                0
            };
            i = i + 1;
            0
        };
        let result = vec_get(dp, a_len * cols + b_len);
        let _f = vec_free(dp);
        result
    }
};

// Compute normalized similarity ratio (0-100, percentage).
// 100 means identical, 0 means completely different.
fn levenshtein_similarity(s: String, t: String) -> i64
  post ret >= 0 and ret <= 100
= {
    let m = s.len();
    let n = t.len();
    let max_len = if m >= n { m } else { n };
    if max_len == 0 { 100 }
    else {
        let dist = levenshtein(s, t);
        (max_len - dist) * 100 / max_len
    }
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_identical() -> i64 = {
    let d = levenshtein("hello", "hello");
    if d == 0 { 1 } else { 0 }
};

fn test_empty_strings() -> i64 = {
    let d1 = levenshtein("", "");
    let d2 = levenshtein("abc", "");
    let d3 = levenshtein("", "xyz");
    if d1 != 0 { 0 }
    else if d2 != 3 { 0 }
    else if d3 != 3 { 0 }
    else { 1 }
};

fn test_single_char() -> i64 = {
    let d1 = levenshtein("a", "b");    // 1 substitution
    let d2 = levenshtein("a", "");     // 1 deletion
    let d3 = levenshtein("", "a");     // 1 insertion
    if d1 != 1 { 0 }
    else if d2 != 1 { 0 }
    else if d3 != 1 { 0 }
    else { 1 }
};

fn test_known_distances() -> i64 = {
    // "kitten" -> "sitting" = 3 (substitute k->s, e->i, insert g)
    let d1 = levenshtein("kitten", "sitting");
    // "saturday" -> "sunday" = 3
    let d2 = levenshtein("saturday", "sunday");
    if d1 != 3 { 0 }
    else if d2 != 3 { 0 }
    else { 1 }
};

fn test_vec_distance() -> i64 = {
    // [1,2,3] vs [1,3,3] -> 1 substitution
    let a = vec_new();
    let _a0 = vec_push(a, 1);
    let _a1 = vec_push(a, 2);
    let _a2 = vec_push(a, 3);
    let b = vec_new();
    let _b0 = vec_push(b, 1);
    let _b1 = vec_push(b, 3);
    let _b2 = vec_push(b, 3);
    let d = levenshtein_vec(a, 3, b, 3);
    let _f1 = vec_free(a);
    let _f2 = vec_free(b);
    if d == 1 { 1 } else { 0 }
};

fn test_similarity() -> i64 = {
    let s1 = levenshtein_similarity("hello", "hello");
    let s2 = levenshtein_similarity("abc", "xyz");
    if s1 != 100 { 0 }
    else if s2 != 0 { 0 }
    else { 1 }
};

fn test_symmetric() -> i64 = {
    // Distance should be symmetric: d(a,b) == d(b,a)
    let d1 = levenshtein("abc", "def");
    let d2 = levenshtein("def", "abc");
    let d3 = levenshtein("cat", "cart");
    let d4 = levenshtein("cart", "cat");
    if d1 != d2 { 0 }
    else if d3 != d4 { 0 }
    else { 1 }
};

fn main() -> i64 = {
    let t1 = report("identical", test_identical());
    let t2 = report("empty_strings", test_empty_strings());
    let t3 = report("single_char", test_single_char());
    let t4 = report("known_distances", test_known_distances());
    let t5 = report("vec_distance", test_vec_distance());
    let t6 = report("similarity", test_similarity());
    let t7 = report("symmetric", test_symmetric());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7;
    let total = 7;
    let _p1 = print_str("bmb-levenshtein: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
