// bmb-config: Simple integer key-value configuration store.
// Backed by an open-addressing hash map (integer keys and values).
//
// Memory layout (hash map entry): [key: i64, value: i64, state: i64] = 24 bytes
//   state 0 = empty, 1 = occupied, 2 = tombstone
//
// Config header: [entries_ptr: i64, count: i64, capacity: i64] = 24 bytes

// Sentinel returned when key is absent
fn CONFIG_NOT_FOUND() -> i64 = 0 - 9223372036854775807 - 1;

// Entry layout helpers
fn cfg_entry_addr(entries: i64, idx: i64) -> i64 = entries + idx * 24;

fn cfg_hash(key: i64) -> i64 = {
    let h = key * 5871781006564002453;
    h bxor (h >> 32)
};

fn cfg_init_entries(entries: i64, capacity: i64) -> i64 = {
    let mut i: i64 = 0;
    while i < capacity {
        let _s = store_i64(cfg_entry_addr(entries, i) + 16, 0);
        i = i + 1;
        0
    };
    0
};

// Create a new config store
fn config_new() -> i64
  post ret != 0
= {
    let capacity = 64;
    let m = malloc(24);
    let entries = malloc(capacity * 24);
    let _init = cfg_init_entries(entries, capacity);
    let _s1 = store_i64(m, entries);
    let _s2 = store_i64(m + 8, 0);
    let _s3 = store_i64(m + 16, capacity);
    m
};

// Set a key-value pair (insert or update)
fn config_set(cfg: i64, key: i64, val: i64) -> i64
  pre cfg != 0
= {
    let h = cfg_hash(key);
    let cap = load_i64(cfg + 16);
    let mask = cap - 1;
    let entries = load_i64(cfg);
    let mut idx: i64 = h band mask;
    let mut i: i64 = 0;
    let mut done = false;
    while not done {
        let e = cfg_entry_addr(entries, idx);
        let state = load_i64(e + 16);
        let _r = if state == 0 or state == 2 {
            let _s1 = store_i64(e, key);
            let _s2 = store_i64(e + 8, val);
            let _s3 = store_i64(e + 16, 1);
            let _s4 = store_i64(cfg + 8, load_i64(cfg + 8) + 1);
            { done = true; 0 }
        } else if state == 1 and load_i64(e) == key {
            let _s1 = store_i64(e + 8, val);
            { done = true; 0 }
        } else {
            { idx = (idx + 1) band mask; i = i + 1; 0 }
        };
        0
    };
    0
};

// Get a value by key; returns CONFIG_NOT_FOUND() if absent
fn config_get(cfg: i64, key: i64) -> i64
  pre cfg != 0
= {
    let h = cfg_hash(key);
    let cap = load_i64(cfg + 16);
    let mask = cap - 1;
    let entries = load_i64(cfg);
    let mut idx: i64 = h band mask;
    let mut i: i64 = 0;
    let mut result = CONFIG_NOT_FOUND();
    let mut done = false;
    while not done {
        let e = cfg_entry_addr(entries, idx);
        let state = load_i64(e + 16);
        let _r = if state == 0 {
            { done = true; 0 }
        } else if state == 1 and load_i64(e) == key {
            { result = load_i64(e + 8); done = true; 0 }
        } else {
            { idx = (idx + 1) band mask; i = i + 1; 0 }
        };
        if i >= cap { done = true; 0 } else { 0 }
    };
    result
};

// Check if a key exists in the config
fn config_has(cfg: i64, key: i64) -> bool
  pre cfg != 0
= config_get(cfg, key) != CONFIG_NOT_FOUND();

// Number of entries currently stored
fn config_count(cfg: i64) -> i64
  pre cfg != 0
  post ret >= 0
= load_i64(cfg + 8);

// Free config memory
fn config_free(cfg: i64) -> i64
  pre cfg != 0
= {
    let entries = load_i64(cfg);
    let _fe = free(entries);
    let _fm = free(cfg);
    0
};

// Get a value, or return default_val if key is absent
fn config_get_or_default(cfg: i64, key: i64, default_val: i64) -> i64
  pre cfg != 0
= {
    let v = config_get(cfg, key);
    if v == CONFIG_NOT_FOUND() { default_val } else { v }
};

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_set_get() -> i64 = {
    let cfg = config_new();
    let _s1 = config_set(cfg, 1, 100);
    let _s2 = config_set(cfg, 2, 200);
    let _s3 = config_set(cfg, 3, 300);
    let v1 = config_get(cfg, 1);
    let v2 = config_get(cfg, 2);
    let v3 = config_get(cfg, 3);
    let _f = config_free(cfg);
    if v1 == 100 and v2 == 200 and v3 == 300 { 1 } else { 0 }
};

fn test_update() -> i64 = {
    let cfg = config_new();
    let _s1 = config_set(cfg, 42, 10);
    let _s2 = config_set(cfg, 42, 20);
    let v = config_get(cfg, 42);
    let cnt = config_count(cfg);
    let _f = config_free(cfg);
    if v == 20 and cnt == 1 { 1 } else { 0 }
};

fn test_has() -> i64 = {
    let cfg = config_new();
    let _s = config_set(cfg, 7, 99);
    let has7 = b2i(config_has(cfg, 7));
    let has8 = b2i(config_has(cfg, 8));
    let _f = config_free(cfg);
    if has7 == 1 and has8 == 0 { 1 } else { 0 }
};

fn test_count() -> i64 = {
    let cfg = config_new();
    let c0 = config_count(cfg);
    let _s1 = config_set(cfg, 1, 1);
    let c1 = config_count(cfg);
    let _s2 = config_set(cfg, 2, 2);
    let c2 = config_count(cfg);
    let _f = config_free(cfg);
    if c0 == 0 and c1 == 1 and c2 == 2 { 1 } else { 0 }
};

fn test_not_found() -> i64 = {
    let cfg = config_new();
    let v = config_get(cfg, 999);
    let _f = config_free(cfg);
    if v == CONFIG_NOT_FOUND() { 1 } else { 0 }
};

fn test_get_or_default() -> i64 = {
    let cfg = config_new();
    let _s = config_set(cfg, 5, 50);
    let v_found = config_get_or_default(cfg, 5, 0 - 1);
    let v_missing = config_get_or_default(cfg, 99, 42);
    let _f = config_free(cfg);
    if v_found == 50 and v_missing == 42 { 1 } else { 0 }
};

fn test_many_keys() -> i64 = {
    let cfg = config_new();
    let mut i: i64 = 0;
    while i < 20 {
        let _s = config_set(cfg, i, i * 5);
        i = i + 1;
        0
    };
    let cnt = config_count(cfg);
    let v0 = config_get(cfg, 0);
    let v10 = config_get(cfg, 10);
    let v19 = config_get(cfg, 19);
    let _f = config_free(cfg);
    if cnt == 20 and v0 == 0 and v10 == 50 and v19 == 95 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("set_get", test_set_get());
    let t2 = report("update", test_update());
    let t3 = report("has", test_has());
    let t4 = report("count", test_count());
    let t5 = report("not_found", test_not_found());
    let t6 = report("get_or_default", test_get_or_default());
    let t7 = report("many_keys", test_many_keys());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7;
    let total = 7;
    let _p1 = print_str("bmb-config: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
