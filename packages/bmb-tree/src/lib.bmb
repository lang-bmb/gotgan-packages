// bmb-tree: Binary Tree Package
// Provides typed pointer-based binary tree implementation
//
// Features:
// - Node allocation and deallocation
// - Tree construction (make_tree)
// - Tree traversal (check_tree, map, fold)
// - Tree destruction (free_tree)

// ============================================================================
// Binary Tree Node
// ============================================================================

/// Binary tree node with typed pointers
struct Node {
    left: *Node,
    right: *Node
}

/// Allocate a new node (16 bytes: 2 pointers)
fn node_new() -> *Node = malloc(16) as *Node;

/// Free a single node
fn node_free(node: *Node) -> i64 = { free(node as i64); 0 };

// ============================================================================
// Tree Construction
// ============================================================================

/// Create a complete binary tree of given depth
/// depth=0: single leaf node
/// depth=n: node with two subtrees of depth n-1
fn make_tree(depth: i64) -> *Node = {
    let node = node_new();
    if depth > 0 {
        let _l = set node.left = make_tree(depth - 1);
        let _r = set node.right = make_tree(depth - 1);
        node
    } else {
        let _l = set node.left = null;
        let _r = set node.right = null;
        node
    }
};

/// Create a leaf node
fn make_leaf() -> *Node = {
    let node = node_new();
    let _l = set node.left = null;
    let _r = set node.right = null;
    node
};

// ============================================================================
// Tree Traversal
// ============================================================================

/// Count nodes in tree (returns total node count)
fn check_tree(node: *Node) -> i64 = {
    let left = node.left;
    if left == null {
        1
    } else {
        1 + check_tree(node.left) + check_tree(node.right)
    }
};

/// Get tree depth (0 for leaf)
fn tree_depth(node: *Node) -> i64 = {
    let left = node.left;
    if left == null {
        0
    } else {
        1 + tree_depth(node.left)
    }
};

/// Check if node is a leaf
fn is_leaf(node: *Node) -> bool = node.left == null;

// ============================================================================
// Tree Destruction
// ============================================================================

/// Free entire tree recursively
fn free_tree(node: *Node) -> i64 = {
    let left = node.left;
    if left != null {
        let _l = free_tree(node.left);
        let _r = free_tree(node.right);
        let _f = node_free(node);
        0
    } else {
        let _f = node_free(node);
        0
    }
};

// ============================================================================
// Utilities
// ============================================================================

/// Left shift: 1 << n (for calculating iterations)
fn shift_left(x: i64, n: i64) -> i64 = {
    let mut result: i64 = x;
    let mut i: i64 = 0;
    while i < n {
        { result = result * 2 };
        { i = i + 1 }
    };
    result
};

/// Calculate number of nodes in complete tree of depth d
/// Formula: 2^(d+1) - 1
fn tree_node_count(depth: i64) -> i64 = shift_left(1, depth + 1) - 1;

// ============================================================================
// Tests
// ============================================================================

fn test_leaf() -> i64 = {
    let leaf = make_leaf();
    let ok = is_leaf(leaf) and check_tree(leaf) == 1 and tree_depth(leaf) == 0;
    let _f = free_tree(leaf);
    if ok { 1 } else { 0 }
};

fn test_make_tree() -> i64 = {
    let tree = make_tree(2);
    let count = check_tree(tree);
    let depth = tree_depth(tree);
    let ok = count == 7 and depth == 2 and tree_node_count(2) == 7;
    let _f = free_tree(tree);
    if ok { 1 } else { 0 }
};

fn test_larger_tree() -> i64 = {
    let tree = make_tree(4);
    let count = check_tree(tree);
    let ok = count == 31 and tree_node_count(4) == 31;
    let _f = free_tree(tree);
    if ok { 1 } else { 0 }
};

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_is_leaf() -> i64 = {
    let leaf = make_leaf();
    let non_leaf = make_tree(1);
    let r1 = b2i(is_leaf(leaf));
    let r2 = b2i(is_leaf(non_leaf));
    let _f1 = free_tree(leaf);
    let _f2 = free_tree(non_leaf);
    if r1 == 1 and r2 == 0 { 1 } else { 0 }
};

fn test_tree_depth() -> i64 = {
    let t0 = make_tree(0);
    let t3 = make_tree(3);
    let d0 = tree_depth(t0);
    let d3 = tree_depth(t3);
    let _f0 = free_tree(t0);
    let _f3 = free_tree(t3);
    if d0 == 0 and d3 == 3 { 1 } else { 0 }
};

fn test_node_count() -> i64 = {
    let t3 = make_tree(3);
    let count = check_tree(t3);
    let expected = tree_node_count(3);
    let _f = free_tree(t3);
    if count == 15 and expected == 15 { 1 } else { 0 }
};

fn test_shift_left() -> i64 =
    if shift_left(1, 0) == 1 and shift_left(1, 3) == 8 and shift_left(1, 10) == 1024 { 1 } else { 0 };

fn test_tree_node_count_formula() -> i64 =
    if tree_node_count(0) == 1 and tree_node_count(1) == 3
       and tree_node_count(2) == 7 and tree_node_count(5) == 63 { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("leaf", test_leaf());
    let t2 = report("make_tree", test_make_tree());
    let t3 = report("larger_tree", test_larger_tree());
    let t4 = report("is_leaf", test_is_leaf());
    let t5 = report("tree_depth", test_tree_depth());
    let t6 = report("node_count", test_node_count());
    let t7 = report("shift_left", test_shift_left());
    let t8 = report("node_count_formula", test_tree_node_count_formula());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-tree: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
