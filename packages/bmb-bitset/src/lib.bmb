// bmb-bitset: Bitset operations using i64 bitmasks
// Supports up to 64 bits per word

// Set bit at position
fn bit_set(value: i64, pos: i64) -> i64
  pre pos >= 0 and pos < 64
= value bor (1 << pos);

// Clear bit at position
fn bit_clear(value: i64, pos: i64) -> i64
  pre pos >= 0 and pos < 64
= value band ((1 << pos) bxor (0 - 1));

// Toggle bit at position
fn bit_toggle(value: i64, pos: i64) -> i64
  pre pos >= 0 and pos < 64
= value bxor (1 << pos);

// Test if bit is set
fn bit_test(value: i64, pos: i64) -> bool
  pre pos >= 0 and pos < 64
= ((value >> pos) band 1) == 1;

// Count set bits (popcount)
fn popcount(n: i64) -> i64
  post ret >= 0
= {
    let mut count = 0;
    let mut v = n;
    let mut i = 0;
    while i < 64 {
        count = count + (v band 1);
        v = v >> 1;
        i = i + 1;
        0
    };
    count
};

// Count trailing zeros
fn ctz(n: i64) -> i64
  post ret >= 0 and ret <= 64
= if n == 0 { 64 } else {
    {
        let mut count = 0;
        let mut v = n;
        let mut done = false;
        while not done {
            if (v band 1) == 1 { done = true; 0 }
            else { v = v >> 1; count = count + 1; 0 }
        };
        count
    }
};

// Count leading zeros (for positive values)
fn clz(n: i64) -> i64
  post ret >= 0 and ret <= 64
= if n == 0 { 64 } else {
    {
        let mut count = 0;
        let mut i = 63;
        let mut done = false;
        while not done {
            if ((n >> i) band 1) == 1 { done = true; 0 }
            else if i == 0 { done = true; count = 64; 0 }
            else { count = count + 1; i = i - 1; 0 }
        };
        count
    }
};

// Bitwise union (OR)
fn bitset_union(a: i64, b: i64) -> i64 = a bor b;

// Bitwise intersection (AND)
fn bitset_intersection(a: i64, b: i64) -> i64 = a band b;

// Bitwise difference (A & ~B)
fn bitset_difference(a: i64, b: i64) -> i64 = a band (b bxor (0 - 1));

// Bitwise symmetric difference (XOR)
fn bitset_symmetric_diff(a: i64, b: i64) -> i64 = a bxor b;

// Check if subset
fn bitset_is_subset(subset: i64, superset: i64) -> bool
= (subset band superset) == subset;

// Lowest set bit
fn lowest_set_bit(n: i64) -> i64 = n band (0 - n);

// Clear lowest set bit
fn clear_lowest_bit(n: i64) -> i64 = n band (n - 1);

// Check if power of two
fn is_power_of_two(n: i64) -> bool
  pre n > 0
= (n band (n - 1)) == 0;

// Next power of two
fn next_power_of_two(n: i64) -> i64
  pre n > 0
= {
    let mut p = 1;
    while p < n { p = p << 1; 0 };
    p
};

// Reverse bits of a byte (8-bit)
fn reverse_byte(b: i64) -> i64 = {
    let v = b band 255;
    let mut result = 0;
    let mut i = 0;
    while i < 8 {
        result = (result << 1) bor ((v >> i) band 1);
        i = i + 1;
        0
    };
    result
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_set_clear() -> i64 = {
    let v = bit_set(0, 3);
    if v != 8 { 0 }
    else if bit_clear(v, 3) != 0 { 0 }
    else if bit_toggle(v, 3) != 0 { 0 }
    else if bit_toggle(v, 2) != 12 { 0 }
    else { 1 }
};

fn test_bit_test() -> i64 = {
    let v = (1 << 0) bor ((1 << 5) bor (1 << 10));
    if b2i(bit_test(v, 0)) != 1 { 0 }
    else if b2i(bit_test(v, 5)) != 1 { 0 }
    else if b2i(bit_test(v, 10)) != 1 { 0 }
    else if b2i(bit_test(v, 1)) != 0 { 0 }
    else { 1 }
};

fn test_popcount() -> i64 =
    if popcount(0) != 0 { 0 }
    else if popcount(1) != 1 { 0 }
    else if popcount(7) != 3 { 0 }
    else if popcount(255) != 8 { 0 }
    else { 1 };

fn test_ctz_clz() -> i64 =
    if ctz(0) != 64 { 0 }
    else if ctz(1) != 0 { 0 }
    else if ctz(8) != 3 { 0 }
    else if clz(0) != 64 { 0 }
    else { 1 };

fn test_set_ops() -> i64 = {
    let a = (1 << 0) bor ((1 << 1) bor (1 << 2));
    let b = (1 << 1) bor ((1 << 2) bor (1 << 3));
    if bitset_union(a, b) != 15 { 0 }
    else if bitset_intersection(a, b) != 6 { 0 }
    else if bitset_difference(a, b) != 1 { 0 }
    else if bitset_symmetric_diff(a, b) != 9 { 0 }
    else if b2i(bitset_is_subset(6, a)) != 1 { 0 }
    else { 1 }
};

fn test_power_of_two() -> i64 =
    if b2i(is_power_of_two(1)) != 1 { 0 }
    else if b2i(is_power_of_two(4)) != 1 { 0 }
    else if b2i(is_power_of_two(6)) != 0 { 0 }
    else if next_power_of_two(5) != 8 { 0 }
    else if next_power_of_two(8) != 8 { 0 }
    else { 1 };

fn test_lowest_bit() -> i64 =
    if lowest_set_bit(12) != 4 { 0 }
    else if lowest_set_bit(8) != 8 { 0 }
    else if clear_lowest_bit(12) != 8 { 0 }
    else { 1 };

fn test_reverse_byte() -> i64 =
    if reverse_byte(1) != 128 { 0 }
    else if reverse_byte(128) != 1 { 0 }
    else if reverse_byte(0) != 0 { 0 }
    else if reverse_byte(255) != 255 { 0 }
    else { 1 };

fn main() -> i64 = {
    let t1 = report("set_clear", test_set_clear());
    let t2 = report("bit_test", test_bit_test());
    let t3 = report("popcount", test_popcount());
    let t4 = report("ctz_clz", test_ctz_clz());
    let t5 = report("set_ops", test_set_ops());
    let t6 = report("power_of_two", test_power_of_two());
    let t7 = report("lowest_bit", test_lowest_bit());
    let t8 = report("reverse_byte", test_reverse_byte());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-bitset: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
