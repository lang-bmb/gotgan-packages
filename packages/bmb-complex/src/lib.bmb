// bmb-complex: Complex number arithmetic
// Represents a+bi as a vec [re, im] where values are scaled by 1000.
// E.g., 1.5 + 2.0i is stored as [1500, 2000].
// Multiplication: (ac - bd) + (ad + bc)i, then divide by 1000 to keep scale.

// Create a complex number from scaled integer components
fn complex_new(re: i64, im: i64) -> i64 = {
    let v = vec_new();
    let _p1 = vec_push(v, re);
    let _p2 = vec_push(v, im);
    v
};

// Get real part
fn complex_re(a: i64) -> i64
  pre a != 0
= vec_get(a, 0);

// Get imaginary part
fn complex_im(a: i64) -> i64
  pre a != 0
= vec_get(a, 1);

// Add two complex numbers: (re_a + re_b) + (im_a + im_b)i
fn complex_add(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= complex_new(vec_get(a, 0) + vec_get(b, 0), vec_get(a, 1) + vec_get(b, 1));

// Subtract: (re_a - re_b) + (im_a - im_b)i
fn complex_sub(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= complex_new(vec_get(a, 0) - vec_get(b, 0), vec_get(a, 1) - vec_get(b, 1));

// Multiply: (ac - bd) + (ad + bc)i, divided by 1000 to maintain scale
// a = re_a + im_a*i, b = re_b + im_b*i
// real part: re_a*re_b - im_a*im_b  (both already *1000, so divide by 1000)
// imag part: re_a*im_b + im_a*re_b  (same scaling)
fn complex_mul(a: i64, b: i64) -> i64
  pre a != 0 and b != 0
= {
    let re_a = vec_get(a, 0);
    let im_a = vec_get(a, 1);
    let re_b = vec_get(b, 0);
    let im_b = vec_get(b, 1);
    let new_re = (re_a * re_b - im_a * im_b) / 1000;
    let new_im = (re_a * im_b + im_a * re_b) / 1000;
    complex_new(new_re, new_im)
};

// Magnitude squared: re^2 + im^2, divided by 1000 to keep scale
// (re * re + im * im) / 1000
fn complex_magnitude_sq(a: i64) -> i64
  pre a != 0
= {
    let re = vec_get(a, 0);
    let im = vec_get(a, 1);
    (re * re + im * im) / 1000
};

// Conjugate: re - im*i
fn complex_conjugate(a: i64) -> i64
  pre a != 0
= complex_new(vec_get(a, 0), 0 - vec_get(a, 1));

// Equality check
fn complex_equal(a: i64, b: i64) -> bool
  pre a != 0 and b != 0
= vec_get(a, 0) == vec_get(b, 0) and vec_get(a, 1) == vec_get(b, 1);

// Free a complex number vec
fn complex_free(a: i64) -> i64
  pre a != 0
= { let _f = vec_free(a); 0 };

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

// complex_new and accessors
fn test_new() -> i64 = {
    let c = complex_new(3000, 4000);
    let ok = complex_re(c) == 3000 and complex_im(c) == 4000;
    let _f = complex_free(c);
    if ok { 1 } else { 0 }
};

// complex_add: (1+2i) + (3+4i) = (4+6i)  [scaled: 1000+2000i + 3000+4000i]
fn test_add() -> i64 = {
    let a = complex_new(1000, 2000);
    let b = complex_new(3000, 4000);
    let c = complex_add(a, b);
    let ok = complex_re(c) == 4000 and complex_im(c) == 6000;
    let _f1 = complex_free(a);
    let _f2 = complex_free(b);
    let _f3 = complex_free(c);
    if ok { 1 } else { 0 }
};

// complex_sub: (5+7i) - (2+3i) = (3+4i)
fn test_sub() -> i64 = {
    let a = complex_new(5000, 7000);
    let b = complex_new(2000, 3000);
    let c = complex_sub(a, b);
    let ok = complex_re(c) == 3000 and complex_im(c) == 4000;
    let _f1 = complex_free(a);
    let _f2 = complex_free(b);
    let _f3 = complex_free(c);
    if ok { 1 } else { 0 }
};

// complex_mul: (1+2i) * (3+4i) = (3-8) + (4+6)i = -5 + 10i
// scaled: 1000+2000i * 3000+4000i
// new_re = (1000*3000 - 2000*4000)/1000 = (3000000 - 8000000)/1000 = -5000
// new_im = (1000*4000 + 2000*3000)/1000 = (4000000 + 6000000)/1000 = 10000
fn test_mul() -> i64 = {
    let a = complex_new(1000, 2000);
    let b = complex_new(3000, 4000);
    let c = complex_mul(a, b);
    let ok = complex_re(c) == 0 - 5000 and complex_im(c) == 10000;
    let _f1 = complex_free(a);
    let _f2 = complex_free(b);
    let _f3 = complex_free(c);
    if ok { 1 } else { 0 }
};

// complex_magnitude_sq: |3+4i|^2 = 9+16 = 25  [scaled: 3000+4000i -> (9000000+16000000)/1000 = 25000]
fn test_magnitude_sq() -> i64 = {
    let a = complex_new(3000, 4000);
    let msq = complex_magnitude_sq(a);
    let _f = complex_free(a);
    // 25 * 1000 = 25000
    if msq == 25000 { 1 } else { 0 }
};

// complex_conjugate: conj(3+4i) = 3-4i
fn test_conjugate() -> i64 = {
    let a = complex_new(3000, 4000);
    let c = complex_conjugate(a);
    let ok = complex_re(c) == 3000 and complex_im(c) == 0 - 4000;
    let _f1 = complex_free(a);
    let _f2 = complex_free(c);
    if ok { 1 } else { 0 }
};

// complex_equal: same components
fn test_equal() -> i64 = {
    let a = complex_new(1000, 2000);
    let b = complex_new(1000, 2000);
    let c = complex_new(1000, 3000);
    let eq_ok = b2i(complex_equal(a, b)) == 1;
    let neq_ok = b2i(complex_equal(a, c)) == 0;
    let _f1 = complex_free(a);
    let _f2 = complex_free(b);
    let _f3 = complex_free(c);
    if eq_ok and neq_ok { 1 } else { 0 }
};

// Multiply by zero: (0+0i) * anything = (0+0i)
fn test_mul_zero() -> i64 = {
    let a = complex_new(0, 0);
    let b = complex_new(5000, 7000);
    let c = complex_mul(a, b);
    let ok = complex_re(c) == 0 and complex_im(c) == 0;
    let _f1 = complex_free(a);
    let _f2 = complex_free(b);
    let _f3 = complex_free(c);
    if ok { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("new", test_new());
    let t2 = report("add", test_add());
    let t3 = report("sub", test_sub());
    let t4 = report("mul", test_mul());
    let t5 = report("magnitude_sq", test_magnitude_sq());
    let t6 = report("conjugate", test_conjugate());
    let t7 = report("equal", test_equal());
    let t8 = report("mul_zero", test_mul_zero());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-complex: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
