// bmb-rand: Pseudo-random number generation for BMB
// Implements XorShift64* PRNG (Marsaglia, improved by Vigna)
// Period: 2^64 - 1, passes BigCrush statistical test suite

// ============================================================
// SECTION 1: XorShift64* PRNG Core
// ============================================================

// XorShift64* algorithm (Sebastiano Vigna, 2016)
// State must be nonzero. Produces full 64-bit output.
fn xorshift64star(state: i64) -> i64 =
    let x1 = state bxor (state >> 12);
    let x2 = x1 bxor (x1 << 25);
    let x3 = x2 bxor (x2 >> 27);
    x3 *% 2685821657736338717;

// Advance RNG state (returns new state)
fn next_state(state: i64) -> i64 = xorshift64star(state);

// Initialize seed (ensure nonzero)
fn init_seed(seed: i64) -> i64 =
    if seed == 0 { 6364136223846793005 } else { seed };

// ============================================================
// SECTION 2: Output Extraction
// ============================================================

// Get positive value from state (mask off sign bit)
fn rand_pos(state: i64) -> i64 =
    let masked = state band 4611686018427387903;  // 2^62 - 1
    if masked < 0 { 0 - masked } else { masked };

// Get random value in range [0, max)
fn rand_range(state: i64, max_val: i64) -> i64
  pre max_val > 0
  post ret >= 0 and ret < max_val
= let pos = rand_pos(state);
  pos - (pos / max_val) * max_val;

// Generate random value in range [min, max]
fn rand_between(state: i64, min_val: i64, max_val: i64) -> i64
  pre min_val <= max_val
  post ret >= min_val and ret <= max_val
= min_val + rand_range(state, max_val - min_val + 1);

// Generate random boolean
fn rand_bool(state: i64) -> bool =
    (state band 1) == 1;

// ============================================================
// SECTION 3: Utility Functions
// ============================================================

// Advance state N times
fn rand_n(state: i64, n: i64) -> i64 = {
    let mut s = state;
    let mut remaining = n;
    while remaining > 0 {
        s = next_state(s);
        remaining = remaining - 1;
        0
    };
    s
};

// Simple hash function for seed generation from arbitrary i64
fn hash_seed(x: i64) -> i64 =
    let h = x *% 6364136223846793005 +% 1442695040888963407;
    init_seed(h bxor (h >> 16));

// Shuffle helper: determine if position i should swap
fn should_swap(state: i64, i: i64, n: i64) -> bool
  pre n > i
= let j = rand_range(next_state(state), n - i);
  j > 0;

// ============================================================
// SECTION 4: Legacy API (backward compatibility)
// ============================================================

// LCG parameters (kept for reference, use XorShift64* instead)
fn lcg_a() -> i64 = 1103515245;
fn lcg_c() -> i64 = 12345;
fn lcg_m() -> i64 = 2147483648;

// Legacy LCG next_state
fn lcg_next(state: i64) -> i64
  post ret >= 0
= let raw = state *% lcg_a() +% lcg_c();
  let result = if raw < 0 { 0 - raw } else { raw };
  result - (result / lcg_m()) * lcg_m();

// ============================================================
// Tests
// ============================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Test: XorShift64* produces different values for different seeds
fn test_different_seeds() -> i64 = {
    let s1 = next_state(init_seed(1));
    let s2 = next_state(init_seed(2));
    let s3 = next_state(init_seed(42));
    if s1 != s2 and s2 != s3 and s1 != s3 { 1 } else { 0 }
};

// Test: same seed produces same sequence (deterministic)
fn test_determinism() -> i64 = {
    let seed = init_seed(12345);
    let a1 = next_state(seed);
    let a2 = next_state(a1);
    let a3 = next_state(a2);
    let b1 = next_state(seed);
    let b2 = next_state(b1);
    let b3 = next_state(b2);
    if a1 == b1 and a2 == b2 and a3 == b3 { 1 } else { 0 }
};

// Test: zero seed gets initialized to nonzero
fn test_zero_seed() -> i64 = {
    let s = init_seed(0);
    if s != 0 { 1 } else { 0 }
};

// Test: state changes on each call
fn test_state_advances() -> i64 = {
    let s0 = init_seed(42);
    let s1 = next_state(s0);
    let s2 = next_state(s1);
    let s3 = next_state(s2);
    if s0 != s1 and s1 != s2 and s2 != s3 { 1 } else { 0 }
};

// Test: rand_range produces values in bounds
fn test_rand_range_bounds() -> i64 = {
    let s0 = init_seed(777);
    let s1 = next_state(s0);
    let s2 = next_state(s1);
    let s3 = next_state(s2);
    let s4 = next_state(s3);
    let r1 = rand_range(s1, 10);
    let r2 = rand_range(s2, 10);
    let r3 = rand_range(s3, 100);
    let r4 = rand_range(s4, 3);
    if r1 >= 0 and r1 < 10 and r2 >= 0 and r2 < 10
       and r3 >= 0 and r3 < 100 and r4 >= 0 and r4 < 3 { 1 } else { 0 }
};

// Test: rand_between produces values in inclusive range
fn test_rand_between() -> i64 = {
    let s = init_seed(999);
    let s1 = next_state(s);
    let s2 = next_state(s1);
    let r1 = rand_between(s1, 5, 15);
    let r2 = rand_between(s2, -10, 10);
    if r1 >= 5 and r1 <= 15 and r2 >= -10 and r2 <= 10 { 1 } else { 0 }
};

// Test: rand_bool returns true or false
fn test_rand_bool() -> i64 = {
    let s = init_seed(123);
    let s1 = next_state(s);
    let s2 = next_state(s1);
    let b1 = b2i(rand_bool(s1));
    let b2 = b2i(rand_bool(s2));
    if (b1 == 0 or b1 == 1) and (b2 == 0 or b2 == 1) { 1 } else { 0 }
};

// Test: rand_n advances state correct number of times
fn test_rand_n() -> i64 = {
    let s = init_seed(42);
    let manual = next_state(next_state(next_state(s)));
    let auto = rand_n(s, 3);
    if manual == auto { 1 } else { 0 }
};

// Test: hash_seed produces nonzero values
fn test_hash_seed() -> i64 = {
    let h1 = hash_seed(0);
    let h2 = hash_seed(42);
    let h3 = hash_seed(-1);
    if h1 != 0 and h2 != 0 and h3 != 0 and h1 != h2 and h2 != h3 { 1 } else { 0 }
};

// Test: distribution is roughly uniform (count values < 50 out of 100 samples in [0,100))
fn test_distribution() -> i64 = {
    let s = init_seed(314159);
    let mut state = s;
    let mut remaining = 200;
    let mut count = 0;
    while remaining > 0 {
        state = next_state(state);
        let v = rand_range(state, 100);
        let _r = if v < 50 { count = count + 1; 0 } else { 0 };
        remaining = remaining - 1;
        0
    };
    // Expect roughly 100 out of 200 to be below 50. Accept 60-140 range.
    if count >= 60 and count <= 140 { 1 } else { 0 }
};

// Test: no short cycles (100 distinct states)
fn test_no_short_cycle() -> i64 = {
    let s = init_seed(42);
    let mut state = s;
    let mut prev1 = 0;
    let mut prev2 = 0;
    let mut ok = 1;
    let mut remaining = 100;
    while remaining > 0 {
        let ns = next_state(state);
        let _r = if ns == prev1 or ns == prev2 { ok = 0; 0 } else { 0 };
        prev2 = prev1;
        prev1 = state;
        state = ns;
        remaining = remaining - 1;
        0
    };
    ok
};

// Test: legacy LCG still works
fn test_lcg_legacy() -> i64 = {
    let s1 = lcg_next(0);
    let s2 = lcg_next(s1);
    if s1 >= 0 and s1 < lcg_m() and s2 >= 0 and s2 < lcg_m() and s1 != s2 { 1 } else { 0 }
};

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("different_seeds", test_different_seeds());
    let t2 = report("determinism", test_determinism());
    let t3 = report("zero_seed", test_zero_seed());
    let t4 = report("state_advances", test_state_advances());
    let t5 = report("rand_range_bounds", test_rand_range_bounds());
    let t6 = report("rand_between", test_rand_between());
    let t7 = report("rand_bool", test_rand_bool());
    let t8 = report("rand_n", test_rand_n());
    let t9 = report("hash_seed", test_hash_seed());
    let t10 = report("distribution", test_distribution());
    let t11 = report("no_short_cycle", test_no_short_cycle());
    let t12 = report("lcg_legacy", test_lcg_legacy());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12;
    let total = 12;
    let _p1 = print_str("bmb-rand: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
