// bmb-interval: Interval operations for BMB
// v0.1.0
//
// An "interval vec" stores pairs of i64: [start0, end0, start1, end1, ...]
// Interval count = vec_len / 2.
//
// Functions:
// - interval_overlaps(s1, e1, s2, e2) -> bool
// - interval_contains(s1, e1, s2, e2) -> bool
// - interval_merge(s1, e1, s2, e2) -> i64   (vec or empty)
// - interval_intersect(s1, e1, s2, e2) -> i64 (vec or empty)
// - merge_intervals(intervals_vec) -> i64   (merged vec)
// - count_overlapping(intervals_vec, point) -> i64
// - total_coverage(intervals_vec) -> i64

// ============================================================================
// Primitive helpers
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// i64 min/max (avoid collision with reserved names)
@inline
fn iv_min(a: i64, b: i64) -> i64 = if a < b { a } else { b };

@inline
fn iv_max(a: i64, b: i64) -> i64 = if a > b { a } else { b };

// ============================================================================
// Single-interval predicates
// ============================================================================

// True when [s1,e1] and [s2,e2] share at least one point.
// Touching at endpoints (s1==e2 or s2==e1) counts as overlap.
fn interval_overlaps(s1: i64, e1: i64, s2: i64, e2: i64) -> bool
  pre s1 <= e1 and s2 <= e2
= s1 <= e2 and s2 <= e1;

// True when [s1,e1] fully contains [s2,e2] (s2 >= s1 and e2 <= e1).
fn interval_contains(s1: i64, e1: i64, s2: i64, e2: i64) -> bool
  pre s1 <= e1 and s2 <= e2
= s1 <= s2 and e2 <= e1;

// ============================================================================
// Single-interval set operations — return a vec
// ============================================================================

// Merge two intervals into a new vec [ms, me].
// Returns empty vec (len 0) if the intervals do not overlap.
fn interval_merge(s1: i64, e1: i64, s2: i64, e2: i64) -> i64
  pre s1 <= e1 and s2 <= e2
= {
    let v = vec_new();
    let _r = if interval_overlaps(s1, e1, s2, e2) {
        let ms = iv_min(s1, s2);
        let me = iv_max(e1, e2);
        let _p1 = vec_push(v, ms);
        let _p2 = vec_push(v, me);
        0
    } else { 0 };
    v
};

// Intersect two intervals into a new vec [is, ie].
// Returns empty vec (len 0) if the intervals do not overlap.
fn interval_intersect(s1: i64, e1: i64, s2: i64, e2: i64) -> i64
  pre s1 <= e1 and s2 <= e2
= {
    let v = vec_new();
    let _r = if interval_overlaps(s1, e1, s2, e2) {
        let is_ = iv_max(s1, s2);
        let ie  = iv_min(e1, e2);
        let _p1 = vec_push(v, is_);
        let _p2 = vec_push(v, ie);
        0
    } else { 0 };
    v
};

// ============================================================================
// Multi-interval operations
// ============================================================================

// Sort the interval vec in-place by start value using insertion sort.
// Each element is a (start, end) pair; we sort by start.
fn sort_intervals_by_start(iv: i64) -> i64 = {
    let n = vec_len(iv) / 2;
    let mut i = 1;
    while i < n {
        let ks = vec_get(iv, i * 2);
        let ke = vec_get(iv, i * 2 + 1);
        let mut j = i - 1;
        let mut done = false;
        while not done {
            let _r = if j < 0 {
                { done = true; 0 }
            } else if vec_get(iv, j * 2) > ks {
                {
                    let _s1 = vec_set(iv, j * 2 + 2, vec_get(iv, j * 2));
                    let _s2 = vec_set(iv, j * 2 + 3, vec_get(iv, j * 2 + 1));
                    j = j - 1;
                    0
                }
            } else {
                { done = true; 0 }
            };
            0
        };
        let _ws = vec_set(iv, j * 2 + 2, ks);
        let _we = vec_set(iv, j * 2 + 3, ke);
        i = i + 1;
        0
    };
    0
};

// Merge all overlapping intervals in an interval vec.
// Returns a new vec with merged, non-overlapping intervals sorted by start.
// Caller is responsible for freeing both the input and output vecs.
fn merge_intervals(iv: i64) -> i64
  pre iv != 0
= {
    let n = vec_len(iv) / 2;
    let result = vec_new();
    let _r = if n == 0 { 0 } else {
        // Sort a working copy by start value
        let work = vec_new();
        let mut ci = 0;
        while ci < vec_len(iv) {
            let _p = vec_push(work, vec_get(iv, ci));
            ci = ci + 1;
            0
        };
        let _sort = sort_intervals_by_start(work);

        // Sweep: maintain current merged interval
        let mut cur_s = vec_get(work, 0);
        let mut cur_e = vec_get(work, 1);
        let mut idx = 1;
        while idx < n {
            let ns = vec_get(work, idx * 2);
            let ne = vec_get(work, idx * 2 + 1);
            let _step = if ns <= cur_e {
                // Overlapping: extend current interval
                { cur_e = iv_max(cur_e, ne); 0 }
            } else {
                // Gap: flush current interval and start a new one
                {
                    let _p1 = vec_push(result, cur_s);
                    let _p2 = vec_push(result, cur_e);
                    cur_s = ns;
                    cur_e = ne;
                    0
                }
            };
            idx = idx + 1;
            0
        };
        // Flush final interval
        let _p1 = vec_push(result, cur_s);
        let _p2 = vec_push(result, cur_e);
        let _free = vec_free(work);
        0
    };
    result
};

// Count how many intervals in iv contain the given point (inclusive).
fn count_overlapping(iv: i64, point: i64) -> i64
  pre iv != 0
= {
    let n = vec_len(iv) / 2;
    let mut count = 0;
    let mut i = 0;
    while i < n {
        let s = vec_get(iv, i * 2);
        let e = vec_get(iv, i * 2 + 1);
        let _r = if s <= point and point <= e {
            { count = count + 1; 0 }
        } else { 0 };
        i = i + 1;
        0
    };
    count
};

// Total length covered by intervals after merging overlaps.
// Length of [s, e] is e - s.
fn total_coverage(iv: i64) -> i64
  pre iv != 0
= {
    let merged = merge_intervals(iv);
    let n = vec_len(merged) / 2;
    let mut total = 0;
    let mut i = 0;
    while i < n {
        let s = vec_get(merged, i * 2);
        let e = vec_get(merged, i * 2 + 1);
        total = total + (e - s);
        i = i + 1;
        0
    };
    let _free = vec_free(merged);
    total
};

// ============================================================================
// Test helpers
// ============================================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

// ============================================================================
// Tests
// ============================================================================

fn test_overlaps() -> i64 = {
    // [1,5] and [3,8] overlap
    let t1 = b2i(interval_overlaps(1, 5, 3, 8));
    // [1,5] and [6,10] do not overlap
    let t2 = b2i(not interval_overlaps(1, 5, 6, 10));
    // [1,5] and [5,10] touch at 5 — counts as overlap
    let t3 = b2i(interval_overlaps(1, 5, 5, 10));
    // [3,3] point interval overlaps [1,5]
    let t4 = b2i(interval_overlaps(3, 3, 1, 5));
    // [1,2] and [3,4] do not overlap
    let t5 = b2i(not interval_overlaps(1, 2, 3, 4));
    if t1 + t2 + t3 + t4 + t5 == 5 { 1 } else { 0 }
};

fn test_contains() -> i64 = {
    // [1,10] contains [3,7]
    let t1 = b2i(interval_contains(1, 10, 3, 7));
    // [1,10] contains itself
    let t2 = b2i(interval_contains(1, 10, 1, 10));
    // [3,7] does not contain [1,10]
    let t3 = b2i(not interval_contains(3, 7, 1, 10));
    // [1,5] does not contain [4,7]
    let t4 = b2i(not interval_contains(1, 5, 4, 7));
    // [5,5] contains [5,5]
    let t5 = b2i(interval_contains(5, 5, 5, 5));
    if t1 + t2 + t3 + t4 + t5 == 5 { 1 } else { 0 }
};

fn test_merge_single() -> i64 = {
    // Overlapping: [1,5] merge [3,8] -> [1,8]
    let v1 = interval_merge(1, 5, 3, 8);
    let ok1 = vec_len(v1) == 2 and vec_get(v1, 0) == 1 and vec_get(v1, 1) == 8;
    let _f1 = vec_free(v1);

    // Non-overlapping: [1,5] merge [7,10] -> empty
    let v2 = interval_merge(1, 5, 7, 10);
    let ok2 = vec_len(v2) == 0;
    let _f2 = vec_free(v2);

    // Touching: [1,5] merge [5,10] -> [1,10]
    let v3 = interval_merge(1, 5, 5, 10);
    let ok3 = vec_len(v3) == 2 and vec_get(v3, 0) == 1 and vec_get(v3, 1) == 10;
    let _f3 = vec_free(v3);

    if ok1 and ok2 and ok3 { 1 } else { 0 }
};

fn test_intersect_single() -> i64 = {
    // [1,5] intersect [3,8] -> [3,5]
    let v1 = interval_intersect(1, 5, 3, 8);
    let ok1 = vec_len(v1) == 2 and vec_get(v1, 0) == 3 and vec_get(v1, 1) == 5;
    let _f1 = vec_free(v1);

    // [1,5] intersect [7,10] -> empty
    let v2 = interval_intersect(1, 5, 7, 10);
    let ok2 = vec_len(v2) == 0;
    let _f2 = vec_free(v2);

    // [1,10] intersect [3,7] -> [3,7]
    let v3 = interval_intersect(1, 10, 3, 7);
    let ok3 = vec_len(v3) == 2 and vec_get(v3, 0) == 3 and vec_get(v3, 1) == 7;
    let _f3 = vec_free(v3);

    // Touching: [1,5] intersect [5,10] -> [5,5]
    let v4 = interval_intersect(1, 5, 5, 10);
    let ok4 = vec_len(v4) == 2 and vec_get(v4, 0) == 5 and vec_get(v4, 1) == 5;
    let _f4 = vec_free(v4);

    if ok1 and ok2 and ok3 and ok4 { 1 } else { 0 }
};

fn test_merge_intervals() -> i64 = {
    // Build interval vec: [1,3], [2,6], [8,10], [15,18]
    let iv = vec_new();
    let _p1 = vec_push(iv, 1);
    let _p2 = vec_push(iv, 3);
    let _p3 = vec_push(iv, 2);
    let _p4 = vec_push(iv, 6);
    let _p5 = vec_push(iv, 8);
    let _p6 = vec_push(iv, 10);
    let _p7 = vec_push(iv, 15);
    let _p8 = vec_push(iv, 18);

    // Expected merged: [1,6], [8,10], [15,18]
    let merged = merge_intervals(iv);
    let n = vec_len(merged) / 2;
    let ok = n == 3
             and vec_get(merged, 0) == 1  and vec_get(merged, 1) == 6
             and vec_get(merged, 2) == 8  and vec_get(merged, 3) == 10
             and vec_get(merged, 4) == 15 and vec_get(merged, 5) == 18;

    let _ff = vec_free(merged);
    let _fi = vec_free(iv);

    // Also test: single interval input
    let iv2 = vec_new();
    let _q1 = vec_push(iv2, 5);
    let _q2 = vec_push(iv2, 10);
    let m2 = merge_intervals(iv2);
    let ok2 = vec_len(m2) == 2 and vec_get(m2, 0) == 5 and vec_get(m2, 1) == 10;
    let _ff2 = vec_free(m2);
    let _fi2 = vec_free(iv2);

    if ok and ok2 { 1 } else { 0 }
};

fn test_merge_unsorted() -> i64 = {
    // Input not sorted: [8,10], [1,3], [2,6]
    let iv = vec_new();
    let _p1 = vec_push(iv, 8);
    let _p2 = vec_push(iv, 10);
    let _p3 = vec_push(iv, 1);
    let _p4 = vec_push(iv, 3);
    let _p5 = vec_push(iv, 2);
    let _p6 = vec_push(iv, 6);

    // Expected merged: [1,6], [8,10]
    let merged = merge_intervals(iv);
    let n = vec_len(merged) / 2;
    let ok = n == 2
             and vec_get(merged, 0) == 1 and vec_get(merged, 1) == 6
             and vec_get(merged, 2) == 8 and vec_get(merged, 3) == 10;

    let _ff = vec_free(merged);
    let _fi = vec_free(iv);
    if ok { 1 } else { 0 }
};

fn test_count_overlapping() -> i64 = {
    // Intervals: [1,4], [2,6], [8,10]
    let iv = vec_new();
    let _p1 = vec_push(iv, 1);
    let _p2 = vec_push(iv, 4);
    let _p3 = vec_push(iv, 2);
    let _p4 = vec_push(iv, 6);
    let _p5 = vec_push(iv, 8);
    let _p6 = vec_push(iv, 10);

    // Point 3 is in [1,4] and [2,6] -> 2
    let c1 = count_overlapping(iv, 3);
    // Point 5 is only in [2,6] -> 1
    let c2 = count_overlapping(iv, 5);
    // Point 9 is only in [8,10] -> 1
    let c3 = count_overlapping(iv, 9);
    // Point 0 is in none -> 0
    let c4 = count_overlapping(iv, 0);
    // Point 7 is in none -> 0
    let c5 = count_overlapping(iv, 7);
    // Point 1 is in [1,4] -> 1 (boundary inclusive)
    let c6 = count_overlapping(iv, 1);

    let _fi = vec_free(iv);

    let ok = c1 == 2 and c2 == 1 and c3 == 1 and c4 == 0 and c5 == 0 and c6 == 1;
    if ok { 1 } else { 0 }
};

fn test_total_coverage() -> i64 = {
    // Intervals: [1,4], [2,6], [8,10]
    // Merged: [1,6], [8,10]  coverage = 5 + 2 = 7
    let iv = vec_new();
    let _p1 = vec_push(iv, 1);
    let _p2 = vec_push(iv, 4);
    let _p3 = vec_push(iv, 2);
    let _p4 = vec_push(iv, 6);
    let _p5 = vec_push(iv, 8);
    let _p6 = vec_push(iv, 10);
    let cov = total_coverage(iv);
    let _fi = vec_free(iv);
    if cov != 7 { 0 }
    else {
        // No overlap: [0,3], [10,20] -> 3 + 10 = 13
        let iv3 = vec_new();
        let _r1 = vec_push(iv3, 0);
        let _r2 = vec_push(iv3, 3);
        let _r3 = vec_push(iv3, 10);
        let _r4 = vec_push(iv3, 20);
        let cov3 = total_coverage(iv3);
        let _fi3 = vec_free(iv3);
        if cov3 != 13 { 0 }
        else { 1 }
    }
};

// ============================================================================
// Main
// ============================================================================

fn main() -> i64 = {
    let t1 = report("overlaps",          test_overlaps());
    let t2 = report("contains",          test_contains());
    let t3 = report("merge_single",      test_merge_single());
    let t4 = report("intersect_single",  test_intersect_single());
    let t5 = report("merge_intervals",   test_merge_intervals());
    let t6 = report("merge_unsorted",    test_merge_unsorted());
    let t7 = report("count_overlapping", test_count_overlapping());
    let t8 = report("total_coverage",    test_total_coverage());

    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8;
    let total = 8;
    let _p1 = print_str("bmb-interval: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
