// bmb-rle: Run-length encoding/decoding for vec of i64 values
// Encodes consecutive equal values as (value, count) pairs stored in a flat vec.
// Encoded format: [val0, count0, val1, count1, ...]

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// Encode a vec of i64 values using run-length encoding.
// Input: data vec of length len.
// Returns: new vec with (value, count) pairs stored flat.
fn rle_encode(data: i64, len: i64) -> i64
  pre len >= 0
  post ret != 0
= {
    let result = vec_new();
    let mut idx = 0;
    while idx < len {
        let cur_val = vec_get(data, idx);
        let mut cnt = 1;
        let mut done = false;
        while not done {
            if idx + cnt >= len { done = true; 0 }
            else if vec_get(data, idx + cnt) != cur_val { done = true; 0 }
            else { cnt = cnt + 1; 0 }
        };
        let _pv = vec_push(result, cur_val);
        let _pc = vec_push(result, cnt);
        idx = idx + cnt;
        0
    };
    result
};

// Decode a run-length encoded vec back to original data.
// Input: encoded vec of length enc_len (must be even: value,count pairs).
// Returns: new vec with decoded values.
fn rle_decode(encoded: i64, enc_len: i64) -> i64
  pre enc_len >= 0
  post ret != 0
= {
    let out = vec_new();
    let mut i = 0;
    while i < enc_len {
        let val = vec_get(encoded, i);
        let count = vec_get(encoded, i + 1);
        let mut j = 0;
        while j < count {
            let _p = vec_push(out, val);
            j = j + 1;
            0
        };
        i = i + 2;
        0
    };
    out
};

// Get the number of runs in an encoded vec.
fn rle_run_count(encoded: i64, enc_len: i64) -> i64
  pre enc_len >= 0
  post ret >= 0
= enc_len / 2;

// Get the decoded length from an encoded vec (sum of all counts).
fn rle_decoded_len(encoded: i64, enc_len: i64) -> i64
  pre enc_len >= 0
  post ret >= 0
= {
    let mut total = 0;
    let mut i = 0;
    while i < enc_len {
        total = total + vec_get(encoded, i + 1);
        i = i + 2;
        0
    };
    total
};

// ============================================================
// Tests
// ============================================================

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn vecs_equal(a: i64, a_len: i64, b: i64, b_len: i64) -> i64 = {
    if a_len != b_len { 0 }
    else {
        let mut ok = 1;
        let mut i = 0;
        while i < a_len {
            if vec_get(a, i) != vec_get(b, i) { ok = 0; 0 } else { 0 };
            i = i + 1;
            0
        };
        ok
    }
};

fn test_basic_encode() -> i64 = {
    // [1,1,1,2,2,3] -> [1,3,2,2,3,1]
    let data = vec_new();
    let _p0 = vec_push(data, 1);
    let _p1 = vec_push(data, 1);
    let _p2 = vec_push(data, 1);
    let _p3 = vec_push(data, 2);
    let _p4 = vec_push(data, 2);
    let _p5 = vec_push(data, 3);
    let enc = rle_encode(data, 6);
    let enc_len = vec_len(enc);
    if enc_len != 6 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 0) != 1 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 1) != 3 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 2) != 2 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 3) != 2 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 4) != 3 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 5) != 1 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else { let _f1 = vec_free(data); let _f2 = vec_free(enc); 1 }
};

fn test_roundtrip() -> i64 = {
    let data = vec_new();
    let _p0 = vec_push(data, 5);
    let _p1 = vec_push(data, 5);
    let _p2 = vec_push(data, 3);
    let _p3 = vec_push(data, 3);
    let _p4 = vec_push(data, 3);
    let _p5 = vec_push(data, 7);
    let enc = rle_encode(data, 6);
    let enc_len = vec_len(enc);
    let dec = rle_decode(enc, enc_len);
    let dec_len = vec_len(dec);
    let ok = vecs_equal(data, 6, dec, dec_len);
    let _f1 = vec_free(data);
    let _f2 = vec_free(enc);
    let _f3 = vec_free(dec);
    ok
};

fn test_empty() -> i64 = {
    let data = vec_new();
    let enc = rle_encode(data, 0);
    let enc_len = vec_len(enc);
    let _f1 = vec_free(data);
    let _f2 = vec_free(enc);
    if enc_len == 0 { 1 } else { 0 }
};

fn test_single() -> i64 = {
    let data = vec_new();
    let _p = vec_push(data, 42);
    let enc = rle_encode(data, 1);
    let enc_len = vec_len(enc);
    if enc_len != 2 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 0) != 42 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 1) != 1 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else { let _f1 = vec_free(data); let _f2 = vec_free(enc); 1 }
};

fn test_all_same() -> i64 = {
    // [9,9,9,9] -> [9,4]
    let data = vec_new();
    let _p0 = vec_push(data, 9);
    let _p1 = vec_push(data, 9);
    let _p2 = vec_push(data, 9);
    let _p3 = vec_push(data, 9);
    let enc = rle_encode(data, 4);
    let enc_len = vec_len(enc);
    if enc_len != 2 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 0) != 9 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else if vec_get(enc, 1) != 4 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else { let _f1 = vec_free(data); let _f2 = vec_free(enc); 1 }
};

fn test_all_different() -> i64 = {
    // [1,2,3] -> [1,1, 2,1, 3,1]
    let data = vec_new();
    let _p0 = vec_push(data, 1);
    let _p1 = vec_push(data, 2);
    let _p2 = vec_push(data, 3);
    let enc = rle_encode(data, 3);
    let enc_len = vec_len(enc);
    if enc_len != 6 { let _f1 = vec_free(data); let _f2 = vec_free(enc); 0 }
    else {
        let runs = rle_run_count(enc, enc_len);
        let dec_len = rle_decoded_len(enc, enc_len);
        let _f1 = vec_free(data);
        let _f2 = vec_free(enc);
        if runs != 3 { 0 }
        else if dec_len != 3 { 0 }
        else { 1 }
    }
};

fn test_decode_only() -> i64 = {
    // Decode [10,3, 20,2] -> [10,10,10,20,20]
    let enc = vec_new();
    let _p0 = vec_push(enc, 10);
    let _p1 = vec_push(enc, 3);
    let _p2 = vec_push(enc, 20);
    let _p3 = vec_push(enc, 2);
    let dec = rle_decode(enc, 4);
    let dec_len = vec_len(dec);
    if dec_len != 5 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else if vec_get(dec, 0) != 10 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else if vec_get(dec, 1) != 10 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else if vec_get(dec, 2) != 10 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else if vec_get(dec, 3) != 20 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else if vec_get(dec, 4) != 20 { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 0 }
    else { let _f1 = vec_free(enc); let _f2 = vec_free(dec); 1 }
};

fn main() -> i64 = {
    let t1 = report("basic_encode", test_basic_encode());
    let t2 = report("roundtrip", test_roundtrip());
    let t3 = report("empty", test_empty());
    let t4 = report("single", test_single());
    let t5 = report("all_same", test_all_same());
    let t6 = report("all_different", test_all_different());
    let t7 = report("decode_only", test_decode_only());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7;
    let total = 7;
    let _p1 = print_str("bmb-rle: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
