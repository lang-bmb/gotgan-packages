// bmb-dp: Dynamic programming utilities for BMB
// v0.1.0
//
// Functions:
//   lcs_length         - Longest Common Subsequence length
//   edit_distance      - Levenshtein edit distance
//   max_subarray_sum   - Maximum subarray sum (Kadane's algorithm)
//   longest_increasing_subseq - Longest Increasing Subsequence length
//   coin_change        - Minimum coins to make amount (or -1 if impossible)

// ============================================================================
// Helper: min/max of two i64 values
// ============================================================================

@inline
fn dp_min(a: i64, b: i64) -> i64 = if a < b { a } else { b };

@inline
fn dp_max(a: i64, b: i64) -> i64 = if a > b { a } else { b };

// ============================================================================
// Longest Common Subsequence (LCS)
// Classic O(m*n) DP using a flat vec as the 2D table.
// Returns the length of the LCS of sequences a and b.
// ============================================================================

fn lcs_length(a_vec: i64, a_len: i64, b_vec: i64, b_len: i64) -> i64
  pre a_len >= 0 and b_len >= 0
  post ret >= 0
= {
    // Allocate (a_len+1) * (b_len+1) table filled with 0
    let rows = a_len + 1;
    let cols = b_len + 1;
    let dp = vec_new();
    let total = rows * cols;
    let mut fi = 0;
    while fi < total {
        let _p = vec_push(dp, 0);
        fi = fi + 1;
        0
    };

    let mut i = 1;
    while i <= a_len {
        let mut j = 1;
        while j <= b_len {
            let ai = vec_get(a_vec, i - 1);
            let bj = vec_get(b_vec, j - 1);
            let val = if ai == bj {
                vec_get(dp, (i - 1) * cols + (j - 1)) + 1
            } else {
                dp_max(vec_get(dp, (i - 1) * cols + j),
                       vec_get(dp, i * cols + (j - 1)))
            };
            let _s = vec_set(dp, i * cols + j, val);
            j = j + 1;
            0
        };
        i = i + 1;
        0
    };

    let result = vec_get(dp, a_len * cols + b_len);
    let _f = vec_free(dp);
    result
};

// ============================================================================
// Edit Distance (Levenshtein)
// O(m*n) DP. Returns minimum insertions + deletions + substitutions
// to transform sequence a into sequence b.
// ============================================================================

fn edit_distance(a_vec: i64, a_len: i64, b_vec: i64, b_len: i64) -> i64
  pre a_len >= 0 and b_len >= 0
  post ret >= 0
= {
    let rows = a_len + 1;
    let cols = b_len + 1;
    let dp = vec_new();
    let total = rows * cols;
    let mut fi = 0;
    while fi < total {
        let _p = vec_push(dp, 0);
        fi = fi + 1;
        0
    };

    // Base cases: transforming empty prefix to/from b or a
    let mut ii = 0;
    while ii <= a_len {
        let _s = vec_set(dp, ii * cols + 0, ii);
        ii = ii + 1;
        0
    };
    let mut jj = 0;
    while jj <= b_len {
        let _s = vec_set(dp, 0 * cols + jj, jj);
        jj = jj + 1;
        0
    };

    let mut i = 1;
    while i <= a_len {
        let mut j = 1;
        while j <= b_len {
            let ai = vec_get(a_vec, i - 1);
            let bj = vec_get(b_vec, j - 1);
            let val = if ai == bj {
                vec_get(dp, (i - 1) * cols + (j - 1))
            } else {
                1 + dp_min(vec_get(dp, (i - 1) * cols + (j - 1)),
                    dp_min(vec_get(dp, (i - 1) * cols + j),
                           vec_get(dp, i * cols + (j - 1))))
            };
            let _s = vec_set(dp, i * cols + j, val);
            j = j + 1;
            0
        };
        i = i + 1;
        0
    };

    let result = vec_get(dp, a_len * cols + b_len);
    let _f = vec_free(dp);
    result
};

// ============================================================================
// Maximum Subarray Sum (Kadane's Algorithm)
// O(n). Returns the maximum sum of any contiguous subarray.
// For an all-negative array, returns the largest (least negative) element.
// ============================================================================

fn max_subarray_sum(v: i64, len: i64) -> i64
  pre len > 0
= {
    let mut max_ending = vec_get(v, 0);
    let mut max_so_far = vec_get(v, 0);
    let mut i = 1;
    while i < len {
        let x = vec_get(v, i);
        max_ending = dp_max(x, max_ending + x);
        max_so_far = dp_max(max_so_far, max_ending);
        i = i + 1;
        0
    };
    max_so_far
};

// ============================================================================
// Longest Increasing Subsequence (LIS) — O(n^2) patience-DP
// Returns the length of the strictly increasing longest subsequence.
// ============================================================================

fn longest_increasing_subseq(v: i64, len: i64) -> i64
  pre len > 0
  post ret >= 1
= {
    // dp[i] = length of LIS ending at index i
    let dp = vec_new();
    let mut fi = 0;
    while fi < len {
        let _p = vec_push(dp, 1);
        fi = fi + 1;
        0
    };

    let mut i = 1;
    while i < len {
        let vi = vec_get(v, i);
        let mut j = 0;
        while j < i {
            let vj = vec_get(v, j);
            let _u = if vj < vi {
                let cand = vec_get(dp, j) + 1;
                let cur = vec_get(dp, i);
                let _s = if cand > cur { let _w = vec_set(dp, i, cand); 0 } else { 0 };
                0
            } else { 0 };
            j = j + 1;
            0
        };
        i = i + 1;
        0
    };

    let mut best = 1;
    let mut k = 0;
    while k < len {
        best = dp_max(best, vec_get(dp, k));
        k = k + 1;
        0
    };
    let _f = vec_free(dp);
    best
};

// ============================================================================
// Coin Change — minimum number of coins to make `amount`
// Returns minimum coins, or -1 if not possible.
// coins_vec: vec of coin denominations; n_coins: number of coin types.
// ============================================================================

fn coin_change(coins_vec: i64, n_coins: i64, amount: i64) -> i64
  pre n_coins > 0 and amount >= 0
= {
    // dp[0..amount] where dp[i] = min coins to make i, INF if impossible
    let inf = 1000000000;
    let dp = vec_new();
    // push amount+1 entries: dp[0]=0, rest=inf
    let _p0 = vec_push(dp, 0);
    let mut fi = 1;
    while fi <= amount {
        let _p = vec_push(dp, inf);
        fi = fi + 1;
        0
    };

    let mut i = 1;
    while i <= amount {
        let mut ci = 0;
        while ci < n_coins {
            let coin = vec_get(coins_vec, ci);
            let _u = if coin <= i {
                let prev = vec_get(dp, i - coin);
                let _c = if prev != inf {
                    let cand = prev + 1;
                    let cur = vec_get(dp, i);
                    let _s = if cand < cur { let _w = vec_set(dp, i, cand); 0 } else { 0 };
                    0
                } else { 0 };
                0
            } else { 0 };
            ci = ci + 1;
            0
        };
        i = i + 1;
        0
    };

    let ans = vec_get(dp, amount);
    let _f = vec_free(dp);
    if ans == inf { 0 - 1 } else { ans }
};

// ============================================================================
// Tests
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn test_lcs() -> i64 = {
    // "ABCBDAB" vs "BDCABA" -> LCS length = 4
    let a = vec_new();
    let _a0 = vec_push(a, 65); // A
    let _a1 = vec_push(a, 66); // B
    let _a2 = vec_push(a, 67); // C
    let _a3 = vec_push(a, 66); // B
    let _a4 = vec_push(a, 68); // D
    let _a5 = vec_push(a, 65); // A
    let _a6 = vec_push(a, 66); // B
    let b = vec_new();
    let _b0 = vec_push(b, 66); // B
    let _b1 = vec_push(b, 68); // D
    let _b2 = vec_push(b, 67); // C
    let _b3 = vec_push(b, 65); // A
    let _b4 = vec_push(b, 66); // B
    let _b5 = vec_push(b, 65); // A
    let r = lcs_length(a, 7, b, 6);
    let _fa = vec_free(a);
    let _fb = vec_free(b);
    if r == 4 { 1 } else { 0 }
};

fn test_edit_distance() -> i64 = {
    // "kitten" vs "sitting" -> 3
    let a = vec_new();
    let _a0 = vec_push(a, 107); // k
    let _a1 = vec_push(a, 105); // i
    let _a2 = vec_push(a, 116); // t
    let _a3 = vec_push(a, 116); // t
    let _a4 = vec_push(a, 101); // e
    let _a5 = vec_push(a, 110); // n
    let b = vec_new();
    let _b0 = vec_push(b, 115); // s
    let _b1 = vec_push(b, 105); // i
    let _b2 = vec_push(b, 116); // t
    let _b3 = vec_push(b, 116); // t
    let _b4 = vec_push(b, 105); // i
    let _b5 = vec_push(b, 110); // n
    let _b6 = vec_push(b, 103); // g
    let r = edit_distance(a, 6, b, 7);
    let _fa = vec_free(a);
    let _fb = vec_free(b);
    // Also test empty sequences
    let e = vec_new();
    let r2 = edit_distance(e, 0, e, 0);
    let _fe = vec_free(e);
    if r == 3 and r2 == 0 { 1 } else { 0 }
};

fn test_max_subarray() -> i64 = {
    // [-2, 1, -3, 4, -1, 2, 1, -5, 4] -> 6
    let v = vec_new();
    let _v0 = vec_push(v, 0 - 2);
    let _v1 = vec_push(v, 1);
    let _v2 = vec_push(v, 0 - 3);
    let _v3 = vec_push(v, 4);
    let _v4 = vec_push(v, 0 - 1);
    let _v5 = vec_push(v, 2);
    let _v6 = vec_push(v, 1);
    let _v7 = vec_push(v, 0 - 5);
    let _v8 = vec_push(v, 4);
    let r = max_subarray_sum(v, 9);
    let _fv = vec_free(v);
    // All-positive: [1,2,3] -> 6
    let v2 = vec_new();
    let _u0 = vec_push(v2, 1);
    let _u1 = vec_push(v2, 2);
    let _u2 = vec_push(v2, 3);
    let r2 = max_subarray_sum(v2, 3);
    let _fv2 = vec_free(v2);
    // All-negative: [-3,-1,-2] -> -1
    let v3 = vec_new();
    let _w0 = vec_push(v3, 0 - 3);
    let _w1 = vec_push(v3, 0 - 1);
    let _w2 = vec_push(v3, 0 - 2);
    let r3 = max_subarray_sum(v3, 3);
    let _fv3 = vec_free(v3);
    if r == 6 and r2 == 6 and r3 == 0 - 1 { 1 } else { 0 }
};

fn test_lis() -> i64 = {
    // [10, 9, 2, 5, 3, 7, 101, 18] -> 4
    let v = vec_new();
    let _v0 = vec_push(v, 10);
    let _v1 = vec_push(v, 9);
    let _v2 = vec_push(v, 2);
    let _v3 = vec_push(v, 5);
    let _v4 = vec_push(v, 3);
    let _v5 = vec_push(v, 7);
    let _v6 = vec_push(v, 101);
    let _v7 = vec_push(v, 18);
    let r = longest_increasing_subseq(v, 8);
    let _fv = vec_free(v);
    // Already sorted: [1,2,3,4,5] -> 5
    let v2 = vec_new();
    let _u0 = vec_push(v2, 1);
    let _u1 = vec_push(v2, 2);
    let _u2 = vec_push(v2, 3);
    let _u3 = vec_push(v2, 4);
    let _u4 = vec_push(v2, 5);
    let r2 = longest_increasing_subseq(v2, 5);
    let _fv2 = vec_free(v2);
    if r == 4 and r2 == 5 { 1 } else { 0 }
};

fn test_coin_change() -> i64 = {
    // coins=[1,5,11], amount=15 -> 3 (5+5+5)
    let c = vec_new();
    let _c0 = vec_push(c, 1);
    let _c1 = vec_push(c, 5);
    let _c2 = vec_push(c, 11);
    let r1 = coin_change(c, 3, 15);
    // amount=0 -> 0
    let r2 = coin_change(c, 3, 0);
    let _fc = vec_free(c);
    // coins=[2], amount=3 -> -1 (impossible)
    let c2 = vec_new();
    let _d0 = vec_push(c2, 2);
    let r3 = coin_change(c2, 1, 3);
    let _fc2 = vec_free(c2);
    if r1 == 3 and r2 == 0 and r3 == 0 - 1 { 1 } else { 0 }
};

fn main() -> i64 = {
    let t1 = report("lcs_length",              test_lcs());
    let t2 = report("edit_distance",           test_edit_distance());
    let t3 = report("max_subarray_sum",        test_max_subarray());
    let t4 = report("longest_increasing_subseq", test_lis());
    let t5 = report("coin_change",             test_coin_change());
    let passed = t1 + t2 + t3 + t4 + t5;
    let total = 5;
    let _p1 = print_str("bmb-dp: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
