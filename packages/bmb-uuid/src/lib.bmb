// bmb-uuid: UUID v4-like generation using a linear congruential generator
// v0.1.0
//
// Generates pseudo-random UUID-like identifiers using a simple LCG PRNG.
// Not cryptographically secure; intended for unique IDs in single-process use.
//
// LCG parameters (Knuth / MMIX):
//   state = state * A + C  (mod 2^64)
//   A = 6364136223846793005
//   C = 1442695040888963407
//
// Usage:
//   let _s = uuid_seed(42);
//   let high = uuid_next_rand();
//   let low  = uuid_next_rand();
//   let s    = uuid_format(high, low);  // e.g. "550e8400e29b41d4"

// ============================================================================
// Global LCG state — stored in a single malloc'd cell so it persists
// across calls. Initialised lazily to a default seed on first call.
// ============================================================================

// Allocate 8 bytes and store the seed.  Returns the cell pointer.
fn uuid_state_cell() -> i64 = {
    let cell = malloc(8);
    let _s = store_i64(cell, 6364136223846793005);
    cell
};

// LCG advance: next = state * A + C  (wraps naturally on i64 overflow)
fn lcg_next(state: i64) -> i64 =
    state *% 6364136223846793005 +% 1442695040888963407;

// ============================================================================
// Stateless API (pass seed / state explicitly)
// ============================================================================

// Seed the generator; returns the initial state.
fn uuid_make_state(seed: i64) -> i64 =
    if seed == 0 { 6364136223846793005 } else { seed };

// Advance state once and return the new state.
fn uuid_advance(state: i64) -> i64 = lcg_next(state);

// Extract a positive i64 from state (clears sign bit).
fn uuid_rand_val(state: i64) -> i64 =
    state band 9223372036854775807;

// ============================================================================
// Stateful API (thread-local-like: uses a single global cell)
// ============================================================================

// Initialise the global cell with seed s.  Returns 0.
fn uuid_seed(s: i64) -> i64 = {
    let cell = uuid_state_cell();
    let init = if s == 0 { 6364136223846793005 } else { s };
    let _st = store_i64(cell, init);
    let _fc = free(cell);
    0
};

// Advance the internal state and return a non-negative random i64.
// Note: because we can't share a true global cell without runtime support,
// we carry state functionally and expose uuid_next_from for clean testing.
fn uuid_next_from(state: i64) -> i64 =
    uuid_rand_val(lcg_next(state));

// Generate two successive random values from a seed, for high/low parts.
fn uuid_pair(seed: i64) -> i64 = {
    // Returns high in a 2-element vec; caller reads [0]=high, [1]=low
    let s1 = lcg_next(seed);
    let s2 = lcg_next(s1);
    let high = uuid_rand_val(s1);
    let low  = uuid_rand_val(s2);
    let v = vec_with_capacity(2);
    let _p1 = vec_push(v, high);
    let _p2 = vec_push(v, low);
    v
};

// ============================================================================
// Hex formatting
// ============================================================================

// Single hex digit character (0-15 -> '0'-'f').
fn hex_digit(n: i64) -> String
  pre n >= 0 and n <= 15
= if n == 0 { "0" } else if n == 1 { "1" } else if n == 2 { "2" }
  else if n == 3 { "3" } else if n == 4 { "4" } else if n == 5 { "5" }
  else if n == 6 { "6" } else if n == 7 { "7" } else if n == 8 { "8" }
  else if n == 9 { "9" } else if n == 10 { "a" } else if n == 11 { "b" }
  else if n == 12 { "c" } else if n == 13 { "d" } else if n == 14 { "e" }
  else { "f" };

// Format a non-negative i64 as a lowercase hex string (no leading zeros stripped).
// Produces exactly 16 hex characters by padding with leading zeros if needed.
fn uuid_hex16(n: i64) -> String = {
    // Build 16 nibbles from most-significant to least-significant.
    let mut result = "";
    let mut val = n;
    let mut i = 0;
    // We need 16 nibbles; shift out from high end
    // Use a temp vec to collect nibbles in order
    let nibbles = vec_with_capacity(16);
    while i < 16 {
        // Extract least-significant nibble, prepend
        let nibble = val band 15;
        let _p = vec_push(nibbles, nibble);
        val = val >> 4;
        i = i + 1;
        0
    };
    // nibbles[0] is LSN, nibbles[15] is MSN; print in reverse
    let mut j = 15;
    let mut done = false;
    while not done {
        result = result + hex_digit(vec_get(nibbles, j));
        let _r = if j == 0 { done = true; 0 } else { j = j - 1; 0 };
        0
    };
    let _fn = vec_free(nibbles);
    result
};

// Format two i64 values as a 32-character hex UUID-like string.
fn uuid_format(high: i64, low: i64) -> String =
    uuid_hex16(high) + uuid_hex16(low);

// ============================================================================
// Helpers
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// ============================================================================
// Tests
// ============================================================================

fn test_uuid_advance_changes_state() -> i64 = {
    let s0 = uuid_make_state(42);
    let s1 = uuid_advance(s0);
    let s2 = uuid_advance(s1);
    if s0 != s1 and s1 != s2 and s0 != s2 { 1 } else { 0 }
};

fn test_uuid_deterministic() -> i64 = {
    let s = uuid_make_state(12345);
    let a = uuid_next_from(s);
    let b = uuid_next_from(s);
    if a == b { 1 } else { 0 }
};

fn test_uuid_nonnegative() -> i64 = {
    let s = uuid_make_state(99);
    let v1 = uuid_next_from(s);
    let v2 = uuid_next_from(uuid_advance(s));
    let v3 = uuid_next_from(uuid_advance(uuid_advance(s)));
    if v1 >= 0 and v2 >= 0 and v3 >= 0 { 1 } else { 0 }
};

fn test_uuid_hex_digit() -> i64 = {
    let ok = hex_digit(0) == "0" and hex_digit(9) == "9" and
             hex_digit(10) == "a" and hex_digit(15) == "f";
    b2i(ok)
};

fn test_uuid_hex16_len() -> i64 = {
    let h = uuid_hex16(255);
    if h.len() == 16 { 1 } else { 0 }
};

fn test_uuid_hex16_zero() -> i64 = {
    let h = uuid_hex16(0);
    if h == "0000000000000000" { 1 } else { 0 }
};

fn test_uuid_format_len() -> i64 = {
    let s = uuid_format(12345678, 87654321);
    if s.len() == 32 { 1 } else { 0 }
};

fn test_uuid_pair_different() -> i64 = {
    let v = uuid_pair(42);
    let high = vec_get(v, 0);
    let low  = vec_get(v, 1);
    let _fv = vec_free(v);
    if high != low { 1 } else { 0 }
};

fn test_uuid_pair_nonneg() -> i64 = {
    let v = uuid_pair(7777);
    let high = vec_get(v, 0);
    let low  = vec_get(v, 1);
    let _fv = vec_free(v);
    if high >= 0 and low >= 0 { 1 } else { 0 }
};

fn test_uuid_zero_seed_replaced() -> i64 = {
    let s = uuid_make_state(0);
    if s != 0 { 1 } else { 0 }
};

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1  = report("advance_changes_state", test_uuid_advance_changes_state());
    let t2  = report("deterministic",         test_uuid_deterministic());
    let t3  = report("nonnegative",           test_uuid_nonnegative());
    let t4  = report("hex_digit",             test_uuid_hex_digit());
    let t5  = report("hex16_len",             test_uuid_hex16_len());
    let t6  = report("hex16_zero",            test_uuid_hex16_zero());
    let t7  = report("format_len",            test_uuid_format_len());
    let t8  = report("pair_different",        test_uuid_pair_different());
    let t9  = report("pair_nonneg",           test_uuid_pair_nonneg());
    let t10 = report("zero_seed_replaced",    test_uuid_zero_seed_replaced());

    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10;
    let total = 10;
    let _p1 = print_str("bmb-uuid: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
