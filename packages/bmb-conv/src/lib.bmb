// bmb-conv: Integer conversion utilities
// v0.1.0
//
// Functions for converting integers to hex, binary, and octal strings,
// and for parsing individual digit characters.
//
// All functions that take non-negative n use recursion to build
// the string from most-significant to least-significant digit.
//
// Usage:
//   let h = i64_to_hex(255);       // "ff"
//   let b = i64_to_bin(10);        // "1010"
//   let o = i64_to_oct(8);         // "10"
//   let d = hex_digit(12);         // "c"
//   let v = parse_digit(49);       // 1  (ASCII '1')

// ============================================================================
// Digit helpers
// ============================================================================

// Decimal digit to string ("0".."9").
fn dec_digit(d: i64) -> String
  pre d >= 0 and d <= 9
= if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
  else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
  else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
  else { "9" };

// Hex digit to lowercase string ("0".."9","a".."f").
fn hex_digit(n: i64) -> String
  pre n >= 0 and n <= 15
= if n < 10 { dec_digit(n) }
  else if n == 10 { "a" } else if n == 11 { "b" } else if n == 12 { "c" }
  else if n == 13 { "d" } else if n == 14 { "e" } else { "f" };

// Parse an ASCII character code to its numeric value.
// Accepts '0'-'9' (48-57), 'a'-'f' (97-102), 'A'-'F' (65-70).
// Returns -1 for unrecognised characters.
fn parse_digit(c: i64) -> i64
  post ret >= 0 - 1
= if c >= 48 and c <= 57 { c - 48 }
  else if c >= 97 and c <= 102 { c - 97 + 10 }
  else if c >= 65 and c <= 70  { c - 65 + 10 }
  else { 0 - 1 };

// ============================================================================
// Hexadecimal conversion
// ============================================================================

// Helper: recursively builds hex digits from MSN to LSN.
fn hex_pos(n: i64) -> String =
    if n <= 0 { "" }
    else { hex_pos(n / 16) + hex_digit(n band 15) };

// Convert a non-negative i64 to lowercase hex string.
fn i64_to_hex(n: i64) -> String
  pre n >= 0
  post ret.len() >= 1
= if n == 0 { "0" } else { hex_pos(n) };

// Convert to hex with "0x" prefix.
fn i64_to_hex_prefixed(n: i64) -> String
  pre n >= 0
= "0x" + i64_to_hex(n);

// ============================================================================
// Binary conversion
// ============================================================================

fn bin_pos(n: i64) -> String =
    if n <= 0 { "" }
    else { bin_pos(n / 2) + dec_digit(n band 1) };

// Convert a non-negative i64 to binary string.
fn i64_to_bin(n: i64) -> String
  pre n >= 0
  post ret.len() >= 1
= if n == 0 { "0" } else { bin_pos(n) };

// Convert to binary with "0b" prefix.
fn i64_to_bin_prefixed(n: i64) -> String
  pre n >= 0
= "0b" + i64_to_bin(n);

// ============================================================================
// Octal conversion
// ============================================================================

fn oct_pos(n: i64) -> String =
    if n <= 0 { "" }
    else { oct_pos(n / 8) + dec_digit(n band 7) };

// Convert a non-negative i64 to octal string.
fn i64_to_oct(n: i64) -> String
  pre n >= 0
  post ret.len() >= 1
= if n == 0 { "0" } else { oct_pos(n) };

// Convert to octal with "0o" prefix.
fn i64_to_oct_prefixed(n: i64) -> String
  pre n >= 0
= "0o" + i64_to_oct(n);

// ============================================================================
// Round-trip parsing helpers
// ============================================================================

// Parse a hexadecimal string (no prefix) back to i64.
// Returns -1 on invalid input.
fn parse_hex(s: String) -> i64 = {
    let len = s.len();
    let mut pos = 0;
    let mut acc = 0;
    let mut valid = true;
    let mut done = false;
    while not done {
        let _r = if pos >= len {
            done = true; 0
        } else {
            let c = s.byte_at(pos);
            let d = parse_digit(c);
            let _r2 = if d < 0 or d >= 16 {
                valid = false; done = true; 0
            } else {
                acc = acc * 16 + d; pos = pos + 1; 0
            };
            0
        };
        0
    };
    if valid { acc } else { 0 - 1 }
};

// Parse a binary string (no prefix) back to i64.
// Returns -1 on invalid input.
fn parse_bin(s: String) -> i64 = {
    let len = s.len();
    let mut pos = 0;
    let mut acc = 0;
    let mut valid = true;
    let mut done = false;
    while not done {
        let _r = if pos >= len {
            done = true; 0
        } else {
            let c = s.byte_at(pos);
            let _r2 = if c == 48 {
                acc = acc * 2; pos = pos + 1; 0
            } else if c == 49 {
                acc = acc * 2 + 1; pos = pos + 1; 0
            } else {
                valid = false; done = true; 0
            };
            0
        };
        0
    };
    if valid { acc } else { 0 - 1 }
};

// Parse an octal string (no prefix) back to i64.
// Returns -1 on invalid input.
fn parse_oct(s: String) -> i64 = {
    let len = s.len();
    let mut pos = 0;
    let mut acc = 0;
    let mut valid = true;
    let mut done = false;
    while not done {
        let _r = if pos >= len {
            done = true; 0
        } else {
            let c = s.byte_at(pos);
            let _r2 = if c >= 48 and c <= 55 {
                acc = acc * 8 + (c - 48); pos = pos + 1; 0
            } else {
                valid = false; done = true; 0
            };
            0
        };
        0
    };
    if valid { acc } else { 0 - 1 }
};

// ============================================================================
// Helpers
// ============================================================================

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

// ============================================================================
// Tests
// ============================================================================

fn test_hex_zero() -> i64 = b2i(i64_to_hex(0) == "0");
fn test_hex_255() -> i64 = b2i(i64_to_hex(255) == "ff");
fn test_hex_16()  -> i64 = b2i(i64_to_hex(16) == "10");
fn test_hex_256() -> i64 = b2i(i64_to_hex(256) == "100");

fn test_bin_zero() -> i64 = b2i(i64_to_bin(0) == "0");
fn test_bin_1()    -> i64 = b2i(i64_to_bin(1) == "1");
fn test_bin_10()   -> i64 = b2i(i64_to_bin(10) == "1010");
fn test_bin_255()  -> i64 = b2i(i64_to_bin(255) == "11111111");

fn test_oct_zero() -> i64 = b2i(i64_to_oct(0) == "0");
fn test_oct_8()    -> i64 = b2i(i64_to_oct(8) == "10");
fn test_oct_255()  -> i64 = b2i(i64_to_oct(255) == "377");
fn test_oct_512()  -> i64 = b2i(i64_to_oct(512) == "1000");

fn test_hex_digit_0()  -> i64 = b2i(hex_digit(0) == "0");
fn test_hex_digit_10() -> i64 = b2i(hex_digit(10) == "a");
fn test_hex_digit_15() -> i64 = b2i(hex_digit(15) == "f");

fn test_parse_digit_dec() -> i64 = if parse_digit(48) == 0 and parse_digit(57) == 9 { 1 } else { 0 };
fn test_parse_digit_hex() -> i64 = if parse_digit(97) == 10 and parse_digit(102) == 15 { 1 } else { 0 };
fn test_parse_digit_bad() -> i64 = if parse_digit(64) == 0 - 1 { 1 } else { 0 };

fn test_roundtrip_hex() -> i64 = {
    let ok = parse_hex(i64_to_hex(0)) == 0 and
             parse_hex(i64_to_hex(255)) == 255 and
             parse_hex(i64_to_hex(65535)) == 65535;
    b2i(ok)
};

fn test_roundtrip_bin() -> i64 = {
    let ok = parse_bin(i64_to_bin(0)) == 0 and
             parse_bin(i64_to_bin(10)) == 10 and
             parse_bin(i64_to_bin(255)) == 255;
    b2i(ok)
};

fn test_roundtrip_oct() -> i64 = {
    let ok = parse_oct(i64_to_oct(0)) == 0 and
             parse_oct(i64_to_oct(8)) == 8 and
             parse_oct(i64_to_oct(255)) == 255;
    b2i(ok)
};

fn test_prefixed_hex() -> i64 = b2i(i64_to_hex_prefixed(255) == "0xff");
fn test_prefixed_bin() -> i64 = b2i(i64_to_bin_prefixed(10) == "0b1010");
fn test_prefixed_oct() -> i64 = b2i(i64_to_oct_prefixed(8) == "0o10");

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1  = report("hex_zero",        test_hex_zero());
    let t2  = report("hex_255",         test_hex_255());
    let t3  = report("hex_16",          test_hex_16());
    let t4  = report("hex_256",         test_hex_256());
    let t5  = report("bin_zero",        test_bin_zero());
    let t6  = report("bin_1",           test_bin_1());
    let t7  = report("bin_10",          test_bin_10());
    let t8  = report("bin_255",         test_bin_255());
    let t9  = report("oct_zero",        test_oct_zero());
    let t10 = report("oct_8",           test_oct_8());
    let t11 = report("oct_255",         test_oct_255());
    let t12 = report("oct_512",         test_oct_512());
    let t13 = report("hex_digit_0",     test_hex_digit_0());
    let t14 = report("hex_digit_10",    test_hex_digit_10());
    let t15 = report("hex_digit_15",    test_hex_digit_15());
    let t16 = report("parse_digit_dec", test_parse_digit_dec());
    let t17 = report("parse_digit_hex", test_parse_digit_hex());
    let t18 = report("parse_digit_bad", test_parse_digit_bad());
    let t19 = report("roundtrip_hex",   test_roundtrip_hex());
    let t20 = report("roundtrip_bin",   test_roundtrip_bin());
    let t21 = report("roundtrip_oct",   test_roundtrip_oct());
    let t22 = report("prefixed_hex",    test_prefixed_hex());
    let t23 = report("prefixed_bin",    test_prefixed_bin());
    let t24 = report("prefixed_oct",    test_prefixed_oct());

    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10
               + t11 + t12 + t13 + t14 + t15 + t16 + t17 + t18 + t19 + t20
               + t21 + t22 + t23 + t24;
    let total = 24;
    let _p1 = print_str("bmb-conv: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
