// bmb-fmt: String formatting utilities for BMB
// Provides number formatting and text manipulation

// Digit to character (0-9)
fn digit_char(d: i64) -> i64
  pre d >= 0 and d <= 9
  post ret >= 48 and ret <= 57
= d + 48;

// Count digits in a number
fn count_digits(n: i64) -> i64
  pre n >= 0
  post ret >= 1
= {
    let mut val = n;
    let mut count = 0;
    let mut done = false;
    while not done {
        count = count + 1;
        let _r = if val < 10 {
            { done = true; 0 }
        } else {
            { val = val / 10; 0 }
        };
        0
    };
    count
};

// Get nth digit from right (0-indexed)
fn get_digit(n: i64, pos: i64) -> i64
  pre n >= 0 and pos >= 0
  post ret >= 0 and ret <= 9
= let shifted = n / pow_simple(10, pos);
  shifted - (shifted / 10) * 10;

// Simple power for formatting
fn pow_simple(base: i64, exp: i64) -> i64
  pre exp >= 0
= {
    let mut result = 1;
    let mut remaining = exp;
    while remaining > 0 {
        result = result * base;
        remaining = remaining - 1;
        0
    };
    result
};

// Format integer with padding
fn pad_left_count(n: i64, width: i64) -> i64 =
    let digits = count_digits(n);
    if width > digits { width - digits } else { 0 };

// Print padding spaces
fn print_spaces(count: i64) -> i64 = {
    let mut remaining = count;
    while remaining > 0 {
        let _u = print_str(" ");
        remaining = remaining - 1;
        0
    };
    0
};

// Format with minimum width (right-aligned)
fn print_padded(n: i64, width: i64) -> i64 = {
    let padding = pad_left_count(n, width);
    let u0 = print_spaces(padding);
    let u1 = print(n);
    0
};

// Format with leading zeros
fn print_zero_padded(n: i64, width: i64) -> i64 = {
    let digits = count_digits(n);
    let zeros_needed = if width > digits { width - digits } else { 0 };
    let mut remaining = zeros_needed;
    while remaining > 0 {
        let _u = print_str("0");
        remaining = remaining - 1;
        0
    };
    let _u = print(n);
    0
};

// Format as hexadecimal (simplified, 0-15 only)
fn hex_digit(d: i64) -> String
  pre d >= 0 and d <= 15
= if d < 10 { "0123456789".slice(d, d + 1) } else if d == 10 { "a" } else if d == 11 { "b" } else if d == 12 { "c" } else if d == 13 { "d" } else if d == 14 { "e" } else { "f" };

// Format as binary (limited precision)
fn print_binary_iter(n: i64, pos: i64) -> i64 =
    if pos < 0 { 0 } else {
        let bit = (n / pow_simple(2, pos)) - (n / pow_simple(2, pos + 1)) * 2;
        let u0 = print(bit);
        print_binary_iter(n, pos - 1)
    };

fn print_binary(n: i64, bits: i64) -> i64
  pre bits > 0 and bits <= 32
= print_binary_iter(n, bits - 1);

// Format thousands separator (conceptual)
fn format_with_separator(n: i64, group_size: i64) -> i64
  pre group_size > 0
= let digits = count_digits(n);
  let groups = (digits - 1) / group_size;
  digits + groups;  // returns formatted length

// Percentage formatting
fn format_percent(numerator: i64, denominator: i64) -> i64
  pre denominator > 0
= (numerator * 100) / denominator;

// Print percentage
fn print_percent(numerator: i64, denominator: i64) -> i64
  pre denominator > 0
= {
    let pct = format_percent(numerator, denominator);
    let u0 = print(pct);
    let u1 = print_str("%");
    pct
};

// --- Tests ---

fn test_digit_char() -> i64 =
    if digit_char(0) == 48 and digit_char(5) == 53 and digit_char(9) == 57 { 1 } else { 0 };

fn test_count_digits() -> i64 =
    if count_digits(0) == 1 and count_digits(9) == 1 and count_digits(10) == 2
       and count_digits(99) == 2 and count_digits(100) == 3
       and count_digits(12345) == 5 { 1 } else { 0 };

fn test_pow_simple() -> i64 =
    if pow_simple(10, 0) == 1 and pow_simple(10, 1) == 10 and pow_simple(10, 3) == 1000
       and pow_simple(2, 8) == 256 and pow_simple(3, 3) == 27 { 1 } else { 0 };

fn test_get_digit() -> i64 =
    if get_digit(12345, 0) == 5 and get_digit(12345, 1) == 4
       and get_digit(12345, 2) == 3 and get_digit(12345, 3) == 2
       and get_digit(12345, 4) == 1 { 1 } else { 0 };

fn test_pad_left_count() -> i64 =
    if pad_left_count(42, 5) == 3 and pad_left_count(42, 2) == 0
       and pad_left_count(42, 1) == 0 and pad_left_count(0, 3) == 2 { 1 } else { 0 };

fn test_hex_digit() -> i64 =
    if hex_digit(0) == "0" and hex_digit(9) == "9"
       and hex_digit(10) == "a" and hex_digit(15) == "f" { 1 } else { 0 };

fn test_format_with_separator() -> i64 =
    if format_with_separator(1, 3) == 1 and format_with_separator(1000, 3) == 5
       and format_with_separator(1000000, 3) == 9 { 1 } else { 0 };

fn test_format_percent() -> i64 =
    if format_percent(1, 2) == 50 and format_percent(3, 4) == 75
       and format_percent(1, 1) == 100 and format_percent(0, 10) == 0
       and format_percent(1, 3) == 33 { 1 } else { 0 };

fn test_print_percent() -> i64 =
    if print_percent(1, 2) == 50 and print_percent(3, 4) == 75 { 1 } else { 0 };

fn test_print_padded() -> i64 =
    if print_padded(42, 5) == 0 and print_padded(42, 1) == 0 { 1 } else { 0 };

fn test_print_zero_padded() -> i64 =
    if print_zero_padded(42, 5) == 0 and print_zero_padded(42, 1) == 0 { 1 } else { 0 };

fn test_print_binary() -> i64 =
    if print_binary(5, 4) == 0 and print_binary(255, 8) == 0 { 1 } else { 0 };

fn test_count_digits_large() -> i64 =
    if count_digits(999999999) == 9 and count_digits(1000000000) == 10 { 1 } else { 0 };

fn test_get_digit_zero() -> i64 =
    if get_digit(0, 0) == 0 and get_digit(100, 0) == 0
       and get_digit(100, 1) == 0 and get_digit(100, 2) == 1 { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("digit_char", test_digit_char());
    let t2 = report("count_digits", test_count_digits());
    let t3 = report("pow_simple", test_pow_simple());
    let t4 = report("get_digit", test_get_digit());
    let t5 = report("pad_left_count", test_pad_left_count());
    let t6 = report("hex_digit", test_hex_digit());
    let t7 = report("format_with_separator", test_format_with_separator());
    let t8 = report("format_percent", test_format_percent());
    let t9 = report("print_percent", test_print_percent());
    let t10 = report("print_padded", test_print_padded());
    let t11 = report("print_zero_padded", test_print_zero_padded());
    let t12 = report("print_binary", test_print_binary());
    let t13 = report("count_digits_large", test_count_digits_large());
    let t14 = report("get_digit_zero", test_get_digit_zero());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12 + t13 + t14;
    let total = 14;
    let _p1 = print_str("bmb-fmt: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
