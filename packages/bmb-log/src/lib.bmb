// bmb-log: Structured logging utilities for BMB
// Provides leveled logging with context

// Log levels as integers
fn level_trace() -> i64 = 0;
fn level_debug() -> i64 = 1;
fn level_info() -> i64 = 2;
fn level_warn() -> i64 = 3;
fn level_error() -> i64 = 4;
fn level_fatal() -> i64 = 5;

// Level name lookup
fn level_name(level: i64) -> String =
    if level == 0 { "TRACE" } else if level == 1 { "DEBUG" } else if level == 2 { "INFO" } else if level == 3 { "WARN" } else if level == 4 { "ERROR" } else if level == 5 { "FATAL" } else { "UNKNOWN" };

// Check if level should be logged
fn should_log(current_level: i64, min_level: i64) -> bool
  pre current_level >= 0 and min_level >= 0
= current_level >= min_level;

// Format timestamp (simplified as counter)
fn format_timestamp(counter: i64) -> i64 = counter;

// Core logging functions
fn log_at_level(level: i64, message: i64, min_level: i64) -> i64 =
    if should_log(level, min_level) {
        let u0 = print_str("[");
        let u1 = print_str(level_name(level));
        let u2 = print_str("] ");
        let u3 = println(message);
        1
    } else { 0 };

// Convenience logging functions (with default min_level = INFO)
fn trace(message: i64) -> i64 = log_at_level(level_trace(), message, level_info());
fn debug(message: i64) -> i64 = log_at_level(level_debug(), message, level_info());
fn info(message: i64) -> i64 = log_at_level(level_info(), message, level_info());
fn warn(message: i64) -> i64 = log_at_level(level_warn(), message, level_info());
fn error(message: i64) -> i64 = log_at_level(level_error(), message, level_info());
fn fatal(message: i64) -> i64 = log_at_level(level_fatal(), message, level_info());

// Verbose logging (min_level = DEBUG)
fn trace_v(message: i64) -> i64 = log_at_level(level_trace(), message, level_debug());
fn debug_v(message: i64) -> i64 = log_at_level(level_debug(), message, level_debug());

// Full verbose logging (min_level = TRACE)
fn trace_vv(message: i64) -> i64 = log_at_level(level_trace(), message, level_trace());

// Structured logging helpers
fn log_with_code(level: i64, code: i64, message: i64, min_level: i64) -> i64 =
    if should_log(level, min_level) {
        let u0 = print_str("[");
        let u1 = print_str(level_name(level));
        let u2 = print_str(":E");
        let u3 = print(code);
        let u4 = print_str("] ");
        let u5 = println(message);
        1
    } else { 0 };

// Assert with logging
fn assert_log(condition: bool, message: i64) -> bool =
    if condition { true } else {
        let u0 = error(message);
        false
    };

// Performance timing placeholder
fn log_timing(operation: i64, duration_ms: i64) -> i64 = {
    let u0 = print_str("[TIMING] ");
    let u1 = print(operation);
    let u2 = print_str(" took ");
    let u3 = print(duration_ms);
    let u4 = println_str("ms");
    duration_ms
};

// --- Tests ---

fn b2i(b: bool) -> i64 = if b { 1 } else { 0 };

fn test_level_constants() -> i64 =
    if level_trace() == 0 and level_debug() == 1 and level_info() == 2
       and level_warn() == 3 and level_error() == 4 and level_fatal() == 5 { 1 } else { 0 };

fn test_level_ordering() -> i64 =
    if level_trace() < level_debug() and level_debug() < level_info()
       and level_info() < level_warn() and level_warn() < level_error()
       and level_error() < level_fatal() { 1 } else { 0 };

fn test_level_name() -> i64 =
    if level_name(0) == "TRACE" and level_name(1) == "DEBUG" and level_name(2) == "INFO"
       and level_name(3) == "WARN" and level_name(4) == "ERROR" and level_name(5) == "FATAL"
       and level_name(99) == "UNKNOWN" { 1 } else { 0 };

fn test_should_log_true() -> i64 =
    if b2i(should_log(2, 2)) == 1 and b2i(should_log(3, 2)) == 1
       and b2i(should_log(5, 0)) == 1 { 1 } else { 0 };

fn test_should_log_false() -> i64 =
    if b2i(should_log(0, 1)) == 0 and b2i(should_log(1, 2)) == 0
       and b2i(should_log(0, 5)) == 0 { 1 } else { 0 };

fn test_format_timestamp() -> i64 =
    if format_timestamp(0) == 0 and format_timestamp(42) == 42
       and format_timestamp(1000) == 1000 { 1 } else { 0 };

fn test_log_at_level_filtered() -> i64 =
    if log_at_level(0, 42, 2) == 0 and log_at_level(1, 42, 2) == 0 { 1 } else { 0 };

fn test_log_at_level_logged() -> i64 =
    if log_at_level(2, 42, 2) == 1 and log_at_level(5, 42, 0) == 1 { 1 } else { 0 };

fn test_convenience_filtered() -> i64 =
    if trace(42) == 0 and debug(42) == 0 { 1 } else { 0 };

fn test_convenience_logged() -> i64 =
    if info(42) == 1 and warn(42) == 1 and error(42) == 1 and fatal(42) == 1 { 1 } else { 0 };

fn test_verbose_levels() -> i64 =
    if trace_v(42) == 0 and debug_v(42) == 1 and trace_vv(42) == 1 { 1 } else { 0 };

fn test_log_with_code_filtered() -> i64 =
    if log_with_code(0, 100, 42, 2) == 0 { 1 } else { 0 };

fn test_log_with_code_logged() -> i64 =
    if log_with_code(4, 100, 42, 2) == 1 { 1 } else { 0 };

fn test_assert_log_true() -> i64 =
    if b2i(assert_log(true, 42)) == 1 { 1 } else { 0 };

fn test_assert_log_false() -> i64 =
    if b2i(assert_log(false, 42)) == 0 { 1 } else { 0 };

fn test_log_timing() -> i64 =
    if log_timing(1, 500) == 500 { 1 } else { 0 };

fn report(name: String, result: i64) -> i64 = {
    if result == 0 {
        let _a = print_str("  FAIL: ");
        let _b = print_str(name);
        let _c = print_str("\n");
        0
    } else { result }
};

fn main() -> i64 = {
    let t1 = report("level_constants", test_level_constants());
    let t2 = report("level_ordering", test_level_ordering());
    let t3 = report("level_name", test_level_name());
    let t4 = report("should_log_true", test_should_log_true());
    let t5 = report("should_log_false", test_should_log_false());
    let t6 = report("format_timestamp", test_format_timestamp());
    let t7 = report("log_at_level_filtered", test_log_at_level_filtered());
    let t8 = report("log_at_level_logged", test_log_at_level_logged());
    let t9 = report("convenience_filtered", test_convenience_filtered());
    let t10 = report("convenience_logged", test_convenience_logged());
    let t11 = report("verbose_levels", test_verbose_levels());
    let t12 = report("log_with_code_filtered", test_log_with_code_filtered());
    let t13 = report("log_with_code_logged", test_log_with_code_logged());
    let t14 = report("assert_log_true", test_assert_log_true());
    let t15 = report("assert_log_false", test_assert_log_false());
    let t16 = report("log_timing", test_log_timing());
    let passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12 + t13 + t14 + t15 + t16;
    let total = 16;
    let _p1 = print_str("bmb-log: ");
    let _p2 = print(passed);
    let _p3 = print_str("/");
    let _p4 = print(total);
    let _p5 = print_str(" tests passed\n");
    if passed == total { 0 } else { 1 }
};
